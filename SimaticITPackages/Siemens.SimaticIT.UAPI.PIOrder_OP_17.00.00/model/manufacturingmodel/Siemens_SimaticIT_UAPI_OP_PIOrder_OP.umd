384","$type":"DslTerminalNode","Text":"Guid","FullInfo":"Guid","InfoMap":{"$id":"3385","FullIdObj":{"$id":"3386","$type":"IdentificableTypeSystem","Name":"Guid","FullInfo":"Guid","TypeResolved":""}},"FullIdObj":{"$ref":"3386"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":278,"CharPositionInLine":10,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Input declaration commands","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"3387","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"3388","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"3389","$type":"DslTerminalNode","Text":"CreateFullOrder","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel.Commands.CreateFullOrder","InfoMap":{"$id":"3390","FullIdObj":{"$id":"3391","$type":"IdentificableObject","Guid":"527a24b6-c28c-4605-97e4-d7900857f21e","Name":"CreateFullOrder","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel.Commands.CreateFullOrder","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"2469"}}},"FullIdObj":{"$ref":"3391"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"2466"},"Documentation":{"$id":"3392","$type":"DslTerminalNode","Text":"Creates an Order with all its associated Entities: User Fields, Operations, and Operation Requirements (Materials, Parameters and Equipment).\r\nYou can also specify the BoMNId and Revision of an existing Bill of Materials, OR a list of Materials (Material Items) to add Material Requirements to the Operations.\r\nThe BoM Items or the Material Items can be already associated with a Catalog Operation. \r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, linked to an Order Operation, they become the Material Requirements of the Order Operation.\r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, that is not linked to an Order Operation, they become the Material Requirements of a newly created Order Operation.\r\nIf the BoM Items or the Material Items are not associated with a Catalog Operation, they become the Material Requirements of the Default Catalog Operation.\r\n\r\nIf an Order, with the data specified as command parameter, already exists, the Order is first deleted, if not frozen, and then re-created. If the Order is frozen, error 11202 is returned, as returned by the call to the sub command DeleteOrder.\r\nAfter the Order creation, the command raises the FullOrderCreated event.\r\nThe command also checks if all provided dataSegregationTags exist, if not error 11308 is returned.","FullInfo":"Creates an Order with all its associated Entities: User Fields, Operations, and Operation Requirements (Materials, Parameters and Equipment).\r\nYou can also specify the BoMNId and Revision of an existing Bill of Materials, OR a list of Materials (Material Items) to add Material Requirements to the Operations.\r\nThe BoM Items or the Material Items can be already associated with a Catalog Operation. \r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, linked to an Order Operation, they become the Material Requirements of the Order Operation.\r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, that is not linked to an Order Operation, they become the Material Requirements of a newly created Order Operation.\r\nIf the BoM Items or the Material Items are not associated with a Catalog Operation, they become the Material Requirements of the Default Catalog Operation.\r\n\r\nIf an Order, with the data specified as command parameter, already exists, the Order is first deleted, if not frozen, and then re-created. If the Order is frozen, error 11202 is returned, as returned by the call to the sub command DeleteOrder.\r\nAfter the Order creation, the command raises the FullOrderCreated event.\r\nThe command also checks if all provided dataSegregationTags exist, if not error 11308 is returned.","InfoMap":{"$id":"3393","FullIdObj":{"$id":"3394","$type":"IdentificableText","Name":"Creates an Order with all its associated Entities: User Fields, Operations, and Operation Requirements (Materials, Parameters and Equipment).\r\nYou can also specify the BoMNId and Revision of an existing Bill of Materials, OR a list of Materials (Material Items) to add Material Requirements to the Operations.\r\nThe BoM Items or the Material Items can be already associated with a Catalog Operation. \r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, linked to an Order Operation, they become the Material Requirements of the Order Operation.\r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, that is not linked to an Order Operation, they become the Material Requirements of a newly created Order Operation.\r\nIf the BoM Items or the Material Items are not associated with a Catalog Operation, they become the Material Requirements of the Default Catalog Operation.\r\n\r\nIf an Order, with the data specified as command parameter, already exists, the Order is first deleted, if not frozen, and then re-created. If the Order is frozen, error 11202 is returned, as returned by the call to the sub command DeleteOrder.\r\nAfter the Order creation, the command raises the FullOrderCreated event.\r\nThe command also checks if all provided dataSegregationTags exist, if not error 11308 is returned.","FullInfo":"Creates an Order with all its associated Entities: User Fields, Operations, and Operation Requirements (Materials, Parameters and Equipment).\r\nYou can also specify the BoMNId and Revision of an existing Bill of Materials, OR a list of Materials (Material Items) to add Material Requirements to the Operations.\r\nThe BoM Items or the Material Items can be already associated with a Catalog Operation. \r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, linked to an Order Operation, they become the Material Requirements of the Order Operation.\r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, that is not linked to an Order Operation, they become the Material Requirements of a newly created Order Operation.\r\nIf the BoM Items or the Material Items are not associated with a Catalog Operation, they become the Material Requirements of the Default Catalog Operation.\r\n\r\nIf an Order, with the data specified as command parameter, already exists, the Order is first deleted, if not frozen, and then re-created. If the Order is frozen, error 11202 is returned, as returned by the call to the sub command DeleteOrder.\r\nAfter the Order creation, the command raises the FullOrderCreated event.\r\nThe command also checks if all provided dataSegregationTags exist, if not error 11308 is returned.","TypeResolved":""}},"FullIdObj":{"$ref":"3394"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Creates an Order with all its associated Entities: User Fields, Operations, and Operation Requirements (Materials, Parameters and Equipment).\r\nYou can also specify the BoMNId and Revision of an existing Bill of Materials, OR a list of Materials (Material Items) to add Material Requirements to the Operations.\r\nThe BoM Items or the Material Items can be already associated with a Catalog Operation. \r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, linked to an Order Operation, they become the Material Requirements of the Order Operation.\r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, that is not linked to an Order Operation, they become the Material Requirements of a newly created Order Operation.\r\nIf the BoM Items or the Material Items are not associated with a Catalog Operation, they become the Material Requirements of the Default Catalog Operation.\r\n\r\nIf an Order, with the data specified as command parameter, already exists, the Order is first deleted, if not frozen, and then re-created. If the Order is frozen, error 11202 is returned, as returned by the call to the sub command DeleteOrder.\r\nAfter the Order creation, the command raises the FullOrderCreated event.\r\nThe command also checks if all provided dataSegregationTags exist, if not error 11308 is returned.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Creates an Order with all its associated Entities: User Fields, Operations, and Operation Requirements (Materials, Parameters and Equipment).\r\nYou can also specify the BoMNId and Revision of an existing Bill of Materials, OR a list of Materials (Material Items) to add Material Requirements to the Operations.\r\nThe BoM Items or the Material Items can be already associated with a Catalog Operation. \r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, linked to an Order Operation, they become the Material Requirements of the Order Operation.\r\nIf the BoM Items or the Material Items are associated with a Catalog Operation, that is not linked to an Order Operation, they become the Material Requirements of a newly created Order Operation.\r\nIf the BoM Items or the Material Items are not associated with a Catalog Operation, they become the Material Requirements of the Default Catalog Operation.\r\n\r\nIf an Order, with the data specified as command parameter, already exists, the Order is first deleted, if not frozen, and then re-created. If the Order is frozen, error 11202 is returned, as returned by the call to the sub command DeleteOrder.\r\nAfter the Order creation, the command raises the FullOrderCreated event.\r\nThe command also checks if all provided dataSegregationTags exist, if not error 11308 is returned."},"SystemAnnotations":[{"$id":"3395","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"3396","$type":"DslTerminalNode","Text":"@Guid(527a24b6-c28c-4605-97e4-d7900857f21e)","FullInfo":"@Guid(527a24b6-c28c-4605-97e4-d7900857f21e)","InfoMap":{"$id":"3397","FullIdObj":{"$id":"3398","$type":"IdentificableText","Name":"@Guid(527a24b6-c28c-4605-97e4-d7900857f21e)","FullInfo":"@Guid(527a24b6-c28c-4605-97e4-d7900857f21e)","TypeResolved":""}},"FullIdObj":{"$ref":"3398"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(527a24b6-c28c-4605-97e4-d7900857f21e)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(527a24b6-c28c-4605-97e4-d7900857f21e)"}],"TagAnnotations":[],"_text":"CreateFullOrder","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"CreateFullOrder"},{"$id":"3399","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"3400","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"3401","$type":"DslCommandPropertyCollectionTree","Name":"InputProperties","ScriptInfo":{"$ref":"2466"},"Syste