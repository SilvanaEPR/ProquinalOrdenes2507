":[],"_text":"OVER","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"OVER"},{"$id":"2472","$type":"DslTerminalNode","Text":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel","InfoMap":{"$id":"2473","FullIdObj":{"$id":"2474","$type":"IdentificableText","Name":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel","TypeResolved":""}},"FullIdObj":{"$ref":"2474"},"Children":[],"Name":"ParentDomain","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel"}],"Name":"DomainDeclaration","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"Header","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":1},{"$id":"2475","$type":"DslCommandDeclarationCollectionTree","Name":"CommandCollection","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":16,"ChildrenList":[{"$id":"2476","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"2477","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"2478","$type":"DslTerminalNode","Text":"CreateOrder","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel.Commands.CreateOrder","InfoMap":{"$id":"2479","FullIdObj":{"$id":"2480","$type":"IdentificableObject","Guid":"142beeaf-2dc3-431f-ae2d-b45ed8e077cf","Name":"CreateOrder","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel.Commands.CreateOrder","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"2469"}}},"FullIdObj":{"$ref":"2480"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"2466"},"Documentation":{"$id":"2481","$type":"DslTerminalNode","Text":"Creates an Order.\r\nWhen the Order is created, the command raises the OrderCreated event.\r\nThe command checks the Order:\r\n1. if it does not exist, error 11205 is returned if it does;\r\n2. if the Quantity is not < 0, if so error 10849 is returned;\r\n3. if the UoM is defined but not the Quantity, if not error 10008 is returned;\r\n4. if the ActualStartTime >= ActualEndTime, if not error 10979 is returned; \r\n5. if PlannedStartTime >= PlannedEndTime, if not error 11201 is returned;\r\n6. if the StateMachine exists, if not error 10300 is returned;\r\n7. if the StateMachine has at least one Status, if not error 11320 is returned;\r\n8. if the StateMachine has an initial Status, if not the error 10984 is returned.","FullInfo":"Creates an Order.\r\nWhen the Order is created, the command raises the OrderCreated event.\r\nThe command checks the Order:\r\n1. if it does not exist, error 11205 is returned if it does;\r\n2. if the Quantity is not < 0, if so error 10849 is returned;\r\n3. if the UoM is defined but not the Quantity, if not error 10008 is returned;\r\n4. if the ActualStartTime >= ActualEndTime, if not error 10979 is returned; \r\n5. if PlannedStartTime >= PlannedEndTime, if not error 11201 is returned;\r\n6. if the StateMachine exists, if not error 10300 is returned;\r\n7. if the StateMachine has at least one Status, if not error 11320 is returned;\r\n8. if the StateMachine has an initial Status, if not the error 10984 is returned.","InfoMap":{"$id":"2482","FullIdObj":{"$id":"2483","$type":"IdentificableText","Name":"Creates an Order.\r\nWhen the Order is created, the command raises the OrderCreated event.\r\nThe command checks the Order:\r\n1. if it does not exist, error 11205 is returned if it does;\r\n2. if the Quantity is not < 0, if so error 10849 is returned;\r\n3. if the UoM is defined but not the Quantity, if not error 10008 is returned;\r\n4. if the ActualStartTime >= ActualEndTime, if not error 10979 is returned; \r\n5. if PlannedStartTime >= PlannedEndTime, if not error 11201 is returned;\r\n6. if the StateMachine exists, if not error 10300 is returned;\r\n7. if the StateMachine has at least one Status, if not error 11320 is returned;\r\n8. if the StateMachine has an initial Status, if not the error 10984 is returned.","FullInfo":"Creates an Order.\r\nWhen the Order is created, the command raises the OrderCreated event.\r\nThe command checks the Order:\r\n1. if it does not exist, error 11205 is returned if it does;\r\n2. if the Quantity is not < 0, if so error 10849 is returned;\r\n3. if the UoM is defined but not the Quantity, if not error 10008 is returned;\r\n4. if the ActualStartTime >= ActualEndTime, if not error 10979 is returned; \r\n5. if PlannedStartTime >= PlannedEndTime, if not error 11201 is returned;\r\n6. if the StateMachine exists, if not error 10300 is returned;\r\n7. if the StateMachine has at least one Status, if not error 11320 is returned;\r\n8. if the StateMachine has an initial Status, if not the error 10984 is returned.","TypeResolved":""}},"FullIdObj":{"$ref":"2483"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Creates an Order.\r\nWhen the Order is created, the command raises the OrderCreated event.\r\nThe command checks the Order:\r\n1. if it does not exist, error 11205 is returned if it does;\r\n2. if the Quantity is not < 0, if so error 10849 is returned;\r\n3. if the UoM is defined but not the Quantity, if not error 10008 is returned;\r\n4. if the ActualStartTime >= ActualEndTime, if not error 10979 is returned; \r\n5. if PlannedStartTime >= PlannedEndTime, if not error 11201 is returned;\r\n6. if the StateMachine exists, if not error 10300 is returned;\r\n7. if the StateMachine has at least one Status, if not error 11320 is returned;\r\n8. if the StateMachine has an initial Status, if not the error 10984 is returned.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Creates an Order.\r\nWhen the Order is created, the command raises the OrderCreated event.\r\nThe command checks the Order:\r\n1. if it does not exist, error 11205 is returned if it does;\r\n2. if the Quantity is not < 0, if so error 10849 is returned;\r\n3. if the UoM is defined but not the Quantity, if not error 10008 is returned;\r\n4. if the ActualStartTime >= ActualEndTime, if not error 10979 is returned; \r\n5. if PlannedStartTime >= PlannedEndTime, if not error 11201 is returned;\r\n6. if the StateMachine exists, if not error 10300 is returned;\r\n7. if the StateMachine has at least one Status, if not error 11320 is returned;\r\n8. if the StateMachine has an initial Status, if not the error 10984 is returned."},"SystemAnnotations":[{"$id":"2484","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"2485","$type":"DslTerminalNode","Text":"@Guid(142beeaf-2dc3-431f-ae2d-b45ed8e077cf)","FullInfo":"@Guid(142beeaf-2dc3-431f-ae2d-b45ed8e077cf)","InfoMap":{"$id":"2486","FullIdObj":{"$id":"2487","$type":"IdentificableText","Name":"@Guid(142beeaf-2dc3-431f-ae2d-b45ed8e077cf)","FullInfo":"@Guid(142beeaf-2dc3-431f-ae2d-b45ed8e077cf)","TypeResolved":""}},"FullIdObj":{"$ref":"2487"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"2466"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(142beeaf-2dc3-431f-ae2d-b45ed8e077cf)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(142beeaf-2dc3-431f-ae2d-b45ed8e077cf)"}],"TagAnnotations":[],"_text":"CreateOrder","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"CreateOrd