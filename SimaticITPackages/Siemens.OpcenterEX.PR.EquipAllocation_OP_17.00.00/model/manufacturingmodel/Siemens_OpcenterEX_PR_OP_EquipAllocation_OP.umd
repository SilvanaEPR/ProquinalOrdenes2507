agAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"237","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"238","$type":"DslTerminalNode","Text":"Guid","FullInfo":"Guid","InfoMap":{"$id":"239","FullIdObj":{"$id":"240","$type":"IdentificableTypeSystem","Name":"Guid","FullInfo":"Guid","TypeResolved":""}},"FullIdObj":{"$ref":"240"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":27,"CharPositionInLine":14,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Input declaration commands","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"241","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"242","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"243","$type":"DslTerminalNode","Text":"AllocateEquipment","FullInfo":"Siemens.OpcenterEX.PR.OperationalData.EquipAllocation_OP.OPModel.Commands.AllocateEquipment","InfoMap":{"$id":"244","FullIdObj":{"$id":"245","$type":"IdentificableObject","Guid":"4b1d03b3-4e89-426e-9320-cd2e62fc5262","Name":"AllocateEquipment","FullInfo":"Siemens.OpcenterEX.PR.OperationalData.EquipAllocation_OP.OPModel.Commands.AllocateEquipment","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"207"}}},"FullIdObj":{"$ref":"245"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"204"},"Documentation":{"$id":"246","$type":"DslTerminalNode","Text":"This command will:\r\n1. retrieve (from the given Equipment) the associated State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. allocate the given Equipment to the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exists, if not error 11600 is returned;\r\n2. if it has the standard Process Properties, if not error 11601 is returned;\r\n3. if it its Allocation State Machine is configured, if not error 11607 is returned;\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1.  if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Behavior of the current Equipment Allocation Status equals “IsNotUsed”, if not error 11604 is returned;\r\n4. if a Transition exists toward the Status configured with the Status Behavior equal to “IsInUse”, if not error 11605 is returned.\r\nThe command checks if the Status Transition has been done, if not error 11606 is returned.","FullInfo":"This command will:\r\n1. retrieve (from the given Equipment) the associated State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. allocate the given Equipment to the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exists, if not error 11600 is returned;\r\n2. if it has the standard Process Properties, if not error 11601 is returned;\r\n3. if it its Allocation State Machine is configured, if not error 11607 is returned;\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1.  if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Behavior of the current Equipment Allocation Status equals “IsNotUsed”, if not error 11604 is returned;\r\n4. if a Transition exists toward the Status configured with the Status Behavior equal to “IsInUse”, if not error 11605 is returned.\r\nThe command checks if the Status Transition has been done, if not error 11606 is returned.","InfoMap":{"$id":"247","FullIdObj":{"$id":"248","$type":"IdentificableText","Name":"This command will:\r\n1. retrieve (from the given Equipment) the associated State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. allocate the given Equipment to the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exists, if not error 11600 is returned;\r\n2. if it has the standard Process Properties, if not error 11601 is returned;\r\n3. if it its Allocation State Machine is configured, if not error 11607 is returned;\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1.  if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Behavior of the current Equipment Allocation Status equals “IsNotUsed”, if not error 11604 is returned;\r\n4. if a Transition exists toward the Status configured with the Status Behavior equal to “IsInUse”, if not error 11605 is returned.\r\nThe command checks if the Status Transition has been done, if not error 11606 is returned.","FullInfo":"This command will:\r\n1. retrieve (from the given Equipment) the associated State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. allocate the given Equipment to the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exists, if not error 11600 is returned;\r\n2. if it has the standard Process Properties, if not error 11601 is returned;\r\n3. if it its Allocation State Machine is configured, if not error 11607 is returned;\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1.  if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Behavior of the current Equipment Allocation Status equals “IsNotUsed”, if not error 11604 is returned;\r\n4. if a Transition exists toward the Status configured with the Status Behavior equal to “IsInUse”, if not error 11605 is returned.\r\nThe command checks if the Status Transition has been done, if not error 11606 is returned.","TypeResolved":""}},"FullIdObj":{"$ref":"248"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"This command will:\r\n1. retrieve (from the given Equipment) the associated State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. allocate the given Equipment to the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exists, if not error 11600 is returned;\r\n2. if it has the standard Process Properties, if not error 11601 is returned;\r\n3. if it its Allocation State Machine is configured, if not error 11607 is returned;\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1.  if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Behavior of the current Equipment Allocation Status equals “IsNotUsed”, if not error 11604 is returned;\r\n4. if a Transition exists toward the Status configured with the Status Behavior equal to “IsInUse”, if not error 11605 is returned.\r\nThe command checks if the Status Transition has been done, if not error 11606 is returned.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"This command will:\r\n1. retrieve (from the given Equipment) the associated State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. allocate the given Equipment to the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exists, if not error 11600 is returned;\r\n2. if it has the standard Process Properties, if not error 11601 is returned;\r\n3. if it its Allocation State Machine is configured, if not error 11607 is returned;\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1.  if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Behavior of the current Equipment Allocation Status equals “IsNotUsed”, if not error 11604 is returned;\r\n4. if a Transition exists toward the Status configured with the Status Behavior equal to “IsInUse”, if not error 11605 is returned.\r\nThe command checks if the Status Transition has been done, if not error 11606 is returned."},"SystemAnnotations":[{"$id":"249","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"250","$type":"DslTerminalNode","Text":"@Guid(4b1d03b3-4e89-426e-9320-cd2e62fc5262)","FullInfo":"@Guid(4b1d03b3-4e89-426e-9320-cd2e62fc5262)","InfoMap":{"$id":"251","FullIdObj":{"$id":"252","$type":"IdentificableText","Name":"@Guid(4b1d03b3-4e89-426e-9320-cd2e62fc5262)","FullInfo":"@Guid(4b1d03b3-4e89-426e-9320-cd2e62fc5262)","TypeResolved":""}},"FullIdObj":{"$ref":"252"},"Children":[],"Name":"C