ef":"466"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"204"},"Documentation":{"$id":"467","$type":"DslTerminalNode","Text":"Synchronizes allocation properties with allocation properties of the given Equipment Configuration.\r\nThe command performs the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the EquipmentAllocationPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the EquipmentAllocationProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllocationStateMachineNId.","FullInfo":"Synchronizes allocation properties with allocation properties of the given Equipment Configuration.\r\nThe command performs the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the EquipmentAllocationPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the EquipmentAllocationProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllocationStateMachineNId.","InfoMap":{"$id":"468","FullIdObj":{"$id":"469","$type":"IdentificableText","Name":"Synchronizes allocation properties with allocation properties of the given Equipment Configuration.\r\nThe command performs the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the EquipmentAllocationPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the EquipmentAllocationProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllocationStateMachineNId.","FullInfo":"Synchronizes allocation properties with allocation properties of the given Equipment Configuration.\r\nThe command performs the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the EquipmentAllocationPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the EquipmentAllocationProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllocationStateMachineNId.","TypeResolved":""}},"FullIdObj":{"$ref":"469"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Synchronizes allocation properties with allocation properties of the given Equipment Configuration.\r\nThe command performs the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the EquipmentAllocationPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the EquipmentAllocationProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllocationStateMachineNId.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Synchronizes allocation properties with allocation properties of the given Equipment Configuration.\r\nThe command performs the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the EquipmentAllocationPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the EquipmentAllocationProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllocationStateMachineNId."},"SystemAnnotations":[{"$id":"470","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"471","$type":"DslTerminalNode","Text":"@Guid(c818295d-b237-41ae-92c3-051b97fd6207)","FullInfo":"@Guid(c818295d-b237-41ae-92c3-051b97fd6207)","InfoMap":{"$id":"472","FullIdObj":{"$id":"473","$type":"IdentificableText","Name":"@Guid(c818295d-b237-41ae-92c3-051b97fd6207)","FullInfo":"@Guid(c818295d-b237-41ae-92c3-051b97fd6207)","TypeResolved":""}},"FullIdObj":{"$ref":"473"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(c818295d-b237-41ae-92c3-051b97fd6207)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(c818295d-b237-41ae-92c3-051b97fd6207)"}],"TagAnnotations":[],"_text":"SynchronizeEquipmentAllocationProperties","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"SynchronizeEquipmentAllocationProperties"},{"$id":"474","$type":"DslCommandI