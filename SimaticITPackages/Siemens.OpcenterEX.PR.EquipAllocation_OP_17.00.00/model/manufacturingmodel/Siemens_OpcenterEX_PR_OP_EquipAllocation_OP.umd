","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"336","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"337","$type":"DslTerminalNode","Text":"Guid","FullInfo":"Guid","InfoMap":{"$id":"338","FullIdObj":{"$id":"339","$type":"IdentificableTypeSystem","Name":"Guid","FullInfo":"Guid","TypeResolved":""}},"FullIdObj":{"$ref":"339"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":63,"CharPositionInLine":10,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Output declaration commands","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"340","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"341","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"342","$type":"DslTerminalNode","Text":"ReleaseEquipment","FullInfo":"Siemens.OpcenterEX.PR.OperationalData.EquipAllocation_OP.OPModel.Commands.ReleaseEquipment","InfoMap":{"$id":"343","FullIdObj":{"$id":"344","$type":"IdentificableObject","Guid":"8b6463b4-9288-470d-885a-1474317bf0ae","Name":"ReleaseEquipment","FullInfo":"Siemens.OpcenterEX.PR.OperationalData.EquipAllocation_OP.OPModel.Commands.ReleaseEquipment","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"207"}}},"FullIdObj":{"$ref":"344"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"204"},"Documentation":{"$id":"345","$type":"DslTerminalNode","Text":"The command will:\r\n1. retrieve the State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. release the Equipment from the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exist, if not error 11608 is returned;\r\n2. if it has the standard Process properties, if not, error 11609 is returned;\r\n3. if its Allocation State Machine is configured, if not 11607 is returned.\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1. if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Status Behavior of the current Equipment Allocation Status equals “IsInUse”, if not error 11610 is returned;\r\n4. if a Transition exists\r\n toward the Status configured with the Status Behavior equals to “IsNotUsed”, if not error 11611 is returned.\r\nThe command checks if the Status Transition has been done, If not error 11612 is returned.","FullInfo":"The command will:\r\n1. retrieve the State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. release the Equipment from the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exist, if not error 11608 is returned;\r\n2. if it has the standard Process properties, if not, error 11609 is returned;\r\n3. if its Allocation State Machine is configured, if not 11607 is returned.\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1. if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Status Behavior of the current Equipment Allocation Status equals “IsInUse”, if not error 11610 is returned;\r\n4. if a Transition exists\r\n toward the Status configured with the Status Behavior equals to “IsNotUsed”, if not error 11611 is returned.\r\nThe command checks if the Status Transition has been done, If not error 11612 is returned.","InfoMap":{"$id":"346","FullIdObj":{"$id":"347","$type":"IdentificableText","Name":"The command will:\r\n1. retrieve the State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. release the Equipment from the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exist, if not error 11608 is returned;\r\n2. if it has the standard Process properties, if not, error 11609 is returned;\r\n3. if its Allocation State Machine is configured, if not 11607 is returned.\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1. if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Status Behavior of the current Equipment Allocation Status equals “IsInUse”, if not error 11610 is returned;\r\n4. if a Transition exists\r\n toward the Status configured with the Status Behavior equals to “IsNotUsed”, if not error 11611 is returned.\r\nThe command checks if the Status Transition has been done, If not error 11612 is returned.","FullInfo":"The command will:\r\n1. retrieve the State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. release the Equipment from the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exist, if not error 11608 is returned;\r\n2. if it has the standard Process properties, if not, error 11609 is returned;\r\n3. if its Allocation State Machine is configured, if not 11607 is returned.\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1. if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Status Behavior of the current Equipment Allocation Status equals “IsInUse”, if not error 11610 is returned;\r\n4. if a Transition exists\r\n toward the Status configured with the Status Behavior equals to “IsNotUsed”, if not error 11611 is returned.\r\nThe command checks if the Status Transition has been done, If not error 11612 is returned.","TypeResolved":""}},"FullIdObj":{"$ref":"347"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"The command will:\r\n1. retrieve the State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. release the Equipment from the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exist, if not error 11608 is returned;\r\n2. if it has the standard Process properties, if not, error 11609 is returned;\r\n3. if its Allocation State Machine is configured, if not 11607 is returned.\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1. if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Status Behavior of the current Equipment Allocation Status equals “IsInUse”, if not error 11610 is returned;\r\n4. if a Transition exists\r\n toward the Status configured with the Status Behavior equals to “IsNotUsed”, if not error 11611 is returned.\r\nThe command checks if the Status Transition has been done, If not error 11612 is returned.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"The command will:\r\n1. retrieve the State Machine which is configured to manage the allocation;\r\n2. check if the current Status and the target Status are the expected ones;\r\n3. release the Equipment from the Entity.\r\nThe command performs the following checks on the given Equipment:\r\n1. if it exist, if not error 11608 is returned;\r\n2. if it has the standard Process properties, if not, error 11609 is returned;\r\n3. if its Allocation State Machine is configured, if not 11607 is returned.\r\nThe command performs the following checks on the configured Allocation State Machine of the given Equipment:\r\n1. if it is associated to the Equipment, if not error 11602 is returned;\r\n2. if it exists, if not error 11603 is returned;\r\n3. if the Status Behavior of the current Equipment Allocation Status equals “IsInUse”, if not error 11610 is returned;\r\n4. if a Transition exists\r\n toward the Status configured with the Status Behavior equals to “IsNotUsed”, if not error 11611 is returned.\r\nThe command checks if the Status Transition has been done, If not error 11612 is returned."},"SystemAnnotations":[{"$id":"348","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"349","$type":"DslTerminalNode","Text":"@Guid(8b6463b4-9288-470d-885a-1474317bf0ae)","FullInfo":"@Guid(8b6463b4-9288-470d-885a-1474317bf0ae)","InfoMap":{"$id":"350","FullIdObj":{"$id":"351","$type":"IdentificableText","Name":"@Guid(8b6463b4-9288-470d-885a-1474317bf0ae)","FullInfo":"@Guid(8b6463b4-9288-470d-885a-1474317bf0ae)","TypeResolved":""}},"FullIdObj":{"$ref":"351"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(8b6463b4-9288-470d-885a-1474317bf0ae)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(8b6463b4-9288-470d-885a-1474317bf0ae)"}],"TagAnnotations":[],"_text":"ReleaseEquipment","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"ReleaseEquipment"},{"$id":"352","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"353","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"354","$type":"DslCommandPropertyCollectionTree","Name":"InputProperties","ScriptInfo":{"$ref":"204"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"ChildrenList":[{"$id":"355","$type":"DslCommandPropertyTree","Children":[{"$id":"356","$type":"DslTerminalNode","Text":"EquipmentNIdToRelease","FullInfo":"Siemens.OpcenterEX.PR.OperationalData.EquipAllocation_OP.OPModel.Commands.ReleaseEquipment.EquipmentNIdToRelease","InfoMap":{"$id":"357","FullIdObj":{"$id":"358","$type":"IdentificableFakeProperty","Name":"EquipmentNIdToRelease","FullInfo":"Siemens.OpcenterEX.PR.OperationalData.EquipAllocation_OP.OPModel.Commands.ReleaseEquipment.EquipmentNIdToRelease","ContainerFullInfo":"Siemens.OpcenterEX.PR.OperationalData.EquipAllocation_OP.OPModel.Commands.ReleaseEquipment","TypeResolved":""}},"FullIdObj":{"$ref":"358"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"204"},"Documentation":{"$id":"359","$type":"DslTerminalNode","Text":"The natural key identifier of the Equipment.","FullInfo":"The natural key identifier of the Equipment.","InfoMap":{"$id":"360","FullIdObj":{"$id":"361","$type":"IdentificableText","Name":"The natural key identifier of the Equipment.","FullInfo":"The natural key identifier of the Equipment.","TypeResolved":""}},"FullIdObj":{"$ref":"361"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_