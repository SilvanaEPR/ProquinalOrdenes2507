rimary key identifier of the given Task.","InfoMap":{"$id":"10484","FullIdObj":{"$id":"10485","$type":"IdentificableText","Name":"The primary key identifier of the given Task.","FullInfo":"The primary key identifier of the given Task.","TypeResolved":""}},"FullIdObj":{"$ref":"10485"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"The primary key identifier of the given Task.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"The primary key identifier of the given Task."},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"TaskId","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"TaskId"},{"$id":"10486","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"10487","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"10488","$type":"DslTerminalNode","Text":"Guid","FullInfo":"Guid","InfoMap":{"$id":"10489","FullIdObj":{"$id":"10490","$type":"IdentificableTypeSystem","Name":"Guid","FullInfo":"Guid","TypeResolved":""}},"FullIdObj":{"$ref":"10490"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":1489,"CharPositionInLine":14,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Input declaration commands","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"10491","$type":"DslCommandDeclarationTree","HasInput":true,"Children":[{"$id":"10492","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"10493","$type":"DslTerminalNode","Text":"AddRequirementsByWorkMasterOperationToWorkOrderOperation","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddRequirementsByWorkMasterOperationToWorkOrderOperation","InfoMap":{"$id":"10494","FullIdObj":{"$id":"10495","$type":"IdentificableObject","Guid":"183468f2-97f1-4f79-8a41-b77f093a2103","Name":"AddRequirementsByWorkMasterOperationToWorkOrderOperation","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddRequirementsByWorkMasterOperationToWorkOrderOperation","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"10495"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"10496","$type":"DslTerminalNode","Text":"Adds a set of Requirements to a Work Order Operation from the Specifications of the given Work Master Operation.\r\nFor each command arguments IncludeOperationEquipmentSpecifications, IncludeOperationMaterialSpecifications, and IncludeOperationParameterSpecifications, if equal to true, the command respectively retrieves the Equipment Specifications, the Material Specifications, and/or the Parameter Specifications of the given Work Master Operation.\r\nThe commands checks the given Work Order Operation, testing:\r\n1. if it exists, if not error 10300 is raised;\r\n2. if it is Frozen, if not error 10992 is raised.\r\nThen it checks if the Work Master Operation exists: if not error 10300 is raised.\r\nIf IncludeOperationParameterSpecifications is true, the command calls the command CalculateScalingRatio.\r\nIf no error thrown, it calls the subcommand AddRequirementsToWorkOrderOperation to create all Work Order Operation Requirements.","FullInfo":"Adds a set of Requirements to a Work Order Operation from the Specifications of the given Work Master Operation.\r\nFor each command arguments IncludeOperationEquipmentSpecifications, IncludeOperationMaterialSpecifications, and IncludeOperationParameterSpecifications, if equal to true, the command respectively retrieves the Equipment Specifications, the Material Specifications, and/or the Parameter Specifications of the given Work Master Operation.\r\nThe commands checks the given Work Order Operation, testing:\r\n1. if it exists, if not error 10300 is raised;\r\n2. if it is Frozen, if not error 10992 is raised.\r\nThen it checks if the Work Master Operation exists: if not error 10300 is raised.\r\nIf IncludeOperationParameterSpecifications is true, the command calls the command CalculateScalingRatio.\r\nIf no error thrown, it calls the subcommand AddRequirementsToWorkOrderOperation to create all Work Order Operation Requirements.","InfoMap":{"$id":"10497","FullIdObj":{"$id":"10498","$type":"IdentificableText","Name":"Adds a set of Requirements to a Work Order Operation from the Specifications of the given Work Master Operation.\r\nFor each command arguments IncludeOperationEquipmentSpecifications, IncludeOperationMaterialSpecifications, and IncludeOperationParameterSpecifications, if equal to true, the command respectively retrieves the Equipment Specifications, the Material Specifications, and/or the Parameter Specifications of the given Work Master Operation.\r\nThe commands checks the given Work Order Operation, testing:\r\n1. if it exists, if not error 10300 is raised;\r\n2. if it is Frozen, if not error 10992 is raised.\r\nThen it checks if the Work Master Operation exists: if not error 10300 is raised.\r\nIf IncludeOperationParameterSpecifications is true, the command calls the command CalculateScalingRatio.\r\nIf no error thrown, it calls the subcommand AddRequirementsToWorkOrderOperation to create all Work Order Operation Requirements.","FullInfo":"Adds a set of Requirements to a Work Order Operation from the Specifications of the given Work Master Operation.\r\nFor each command arguments IncludeOperationEquipmentSpecifications, IncludeOperationMaterialSpecifications, and IncludeOperationParameterSpecifications, if equal to true, the command respectively retrieves the Equipment Specifications, the Material Specifications, and/or the Parameter Specifications of the given Work Master Operation.\r\nThe commands checks the given Work Order Operation, testing:\r\n1. if it exists, if not error 10300 is raised;\r\n2. if it is Frozen, if not error 10992 is raised.\r\nThen it checks if the Work Master Operation exists: if not error 10300 is raised.\r\nIf IncludeOperationParameterSpecifications is true, the command calls the command CalculateScalingRatio.\r\nIf no error thrown, it calls the subcommand AddRequirementsToWorkOrderOperation to create all Work Order Operation Requirements.","TypeResolved":""}},"FullIdObj":{"$ref":"10498"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Adds a set of Requirements to a Work Order Operation from the Specifications of the given Work Master Operation.\r\nFor each command arguments IncludeOperationEquipmentSpecifications, IncludeOperationMaterialSpecifications, and IncludeOperationParameterSpecifications, if equal to true, the command respectively retrieves the Equipment Specifications, the Material Specifications, and/or the Parameter Specifications of the given Work Master Operation.\r\nThe commands checks the given Work Order Operation, testing:\r\n1. if it exists, if not error 10300 is raised;\r\n2. if it is Frozen, if not error 10992 is raised.\r\nThen it checks if the Work Master Operation exists: if not error 10300 is raised.\r\nIf IncludeOperationParameterSpecifications is true, the command calls the command CalculateScalingRatio.\r\nIf no error thrown, it calls the subcommand AddRequirementsToWorkOrderOperation to create all Work Order Operation Requirements.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Adds a set of Requirements to a Work Order Operation from the Specifications of the given Work Master Operation.\r\nFor each command arguments IncludeOperationEquipmentSpecifications, IncludeOperationMaterialSpecifications, and IncludeOperationParameterSpecifications, if equal to true, the command respectively retrieves the Equipment Specifications, the Material Specifications, and/or the Parameter Specifications of the given Work Master Operation.\r\nThe commands checks the given Work Order Operation, testing:\r\n1. if it exists, if not error 10300 is raised;\r\n2. if it is Frozen, if not error 10992 is raised.\r\nThen it checks if the Work Master Operation exists: if not error 10300 is raised.\r\nIf IncludeOperationParameterSpecifications is true, the command calls the command CalculateScalingRatio.\r\nIf no error thrown, it calls the subcommand AddRequirementsToWorkOrderOperation to create all Work Order Operation Requirements."},"SystemAnnotations":[{"$id":"10499","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"10500","$type":"DslTerminalNode","Text":"@Guid(183468f2-97f1-4f79-8a41-b77f093a2103)","FullInfo":"@Guid(183468f2-97f1-4f79-8a41-b77f093a2103)","InfoMap":{"$id":"10501","FullIdObj":{"$id":"10502","$type":"IdentificableText","Name":"@Guid(183468f2-97f1-4f79-8a41-b77f093a2103)","FullInfo":"@Guid(183468f2-97f1-4f79-8a41-b77f093a2103)","TypeResolved":""}},"FullIdObj":{"$ref":"10502"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(183468f2-97f1-4f79-8a41-b77f093a2103)","Sie