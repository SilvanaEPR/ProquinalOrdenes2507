xt":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"6342","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"6343","$type":"DslTerminalNode","Text":"decimal","FullInfo":"Decimal","InfoMap":{"$id":"6344","FullIdObj":{"$id":"6345","$type":"IdentificableTypeSystem","Name":"decimal","FullInfo":"Decimal","TypeResolved":""}},"FullIdObj":{"$ref":"6345"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":398,"CharPositionInLine":17,"_text":"decimal","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"decimal"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Input declaration commands","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"6346","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"6347","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"6348","$type":"DslTerminalNode","Text":"AddWorkOrderOperationEquipmentRequirementsToWorkOrderOperation","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationEquipmentRequirementsToWorkOrderOperation","InfoMap":{"$id":"6349","FullIdObj":{"$id":"6350","$type":"IdentificableObject","Guid":"db2369b2-105e-4c56-ba94-885b3a7cb3e7","Name":"AddWorkOrderOperationEquipmentRequirementsToWorkOrderOperation","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationEquipmentRequirementsToWorkOrderOperation","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"6350"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"6351","$type":"DslTerminalNode","Text":"Associates to the specified Work Order Operation the given list of Equipment Requirements. \r\nReminder: an Equipment Requirement could be a piece of Equipment, or an Equipment Group, or both. \r\nChecks if the Work Order Operation exists. Throws the error 10948 otherwise. \r\nChecks if the Work Order Operation is Frozen. Throws the error 10992 otherwise. \r\nThen for each Equipment Requirement of the given list, the command performs the following checks: \r\n1. Checks if the Sequence of the Equipment Requirement is positive, if not error 10997 is returned. \r\n2. Checks if the Planned Equipment of the Equipment Requirement exists, if not error 10996 is returned. \r\n3. Checks that either a piece of Equipment or an Equipment Group is specified, if not error 10309 is returned. \r\n4. If both an Equipment Group and the piece of Equipment are specified, checks if the piece of Equipment belongs to this group, if not error 10993 is reutrned. \r\n5. Checks if the speicfied PlannedSetupStartTime is inferior to the specified PlannedSetupEndTime, if not error 11315 otherwise. \r\n6. If the \"IsMain\" property is set to True, checks if the Equipment Group identifier is specified, if not error -10899 is returned. ","FullInfo":"Associates to the specified Work Order Operation the given list of Equipment Requirements. \r\nReminder: an Equipment Requirement could be a piece of Equipment, or an Equipment Group, or both. \r\nChecks if the Work Order Operation exists. Throws the error 10948 otherwise. \r\nChecks if the Work Order Operation is Frozen. Throws the error 10992 otherwise. \r\nThen for each Equipment Requirement of the given list, the command performs the following checks: \r\n1. Checks if the Sequence of the Equipment Requirement is positive, if not error 10997 is returned. \r\n2. Checks if the Planned Equipment of the Equipment Requirement exists, if not error 10996 is returned. \r\n3. Checks that either a piece of Equipment or an Equipment Group is specified, if not error 10309 is returned. \r\n4. If both an Equipment Group and the piece of Equipment are specified, checks if the piece of Equipment belongs to this group, if not error 10993 is reutrned. \r\n5. Checks if the speicfied PlannedSetupStartTime is inferior to the specified PlannedSetupEndTime, if not error 11315 otherwise. \r\n6. If the \"IsMain\" property is set to True, checks if the Equipment Group identifier is specified, if not error -10899 is returned. ","InfoMap":{"$id":"6352","FullIdObj":{"$id":"6353","$type":"IdentificableText","Name":"Associates to the specified Work Order Operation the given list of Equipment Requirements. \r\nReminder: an Equipment Requirement could be a piece of Equipment, or an Equipment Group, or both. \r\nChecks if the Work Order Operation exists. Throws the error 10948 otherwise. \r\nChecks if the Work Order Operation is Frozen. Throws the error 10992 otherwise. \r\nThen for each Equipment Requirement of the given list, the command performs the following checks: \r\n1. Checks if the Sequence of the Equipment Requirement is positive, if not error 10997 is returned. \r\n2. Checks if the Planned Equipment of the Equipment Requirement exists, if not error 10996 is returned. \r\n3. Checks that either a piece of Equipment or an Equipment Group is specified, if not error 10309 is returned. \r\n4. If both an Equipment Group and the piece of Equipment are specified, checks if the piece of Equipment belongs to this group, if not error 10993 is reutrned. \r\n5. Checks if the speicfied PlannedSetupStartTime is inferior to the specified PlannedSetupEndTime, if not error 11315 otherwise. \r\n6. If the \"IsMain\" property is set to True, checks if the Equipment Group identifier is specified, if not error -10899 is returned. ","FullInfo":"Associates to the specified Work Order Operation the given list of Equipment Requirements. \r\nReminder: an Equipment Requirement could be a piece of Equipment, or an Equipment Group, or both. \r\nChecks if the Work Order Operation exists. Throws the error 10948 otherwise. \r\nChecks if the Work Order Operation is Frozen. Throws the error 10992 otherwise. \r\nThen for each Equipment Requirement of the given list, the command performs the following checks: \r\n1. Checks if the Sequence of the Equipment Requirement is positive, if not error 10997 is returned. \r\n2. Checks if the Planned Equipment of the Equipment Requirement exists, if not error 10996 is returned. \r\n3. Checks that either a piece of Equipment or an Equipment Group is specified, if not error 10309 is returned. \r\n4. If both an Equipment Group and the piece of Equipment are specified, checks if the piece of Equipment belongs to this group, if not error 10993 is reutrned. \r\n5. Checks if the speicfied PlannedSetupStartTime is inferior to the specified PlannedSetupEndTime, if not error 11315 otherwise. \r\n6. If the \"IsMain\" property is set to True, checks if the Equipment Group identifier is specified, if not error -10899 is returned. ","TypeResolved":""}},"FullIdObj":{"$ref":"6353"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Associates to the specified Work Order Operation the given list of Equipment Requirements. \r\nReminder: an Equipment Requirement could be a piece of Equipment, or an Equipment Group, or both. \r\nChecks if the Work Order Operation exists. Throws the error 10948 otherwise. \r\nChecks if the Work Order Operation is Frozen. Throws the error 10992 otherwise. \r\nThen for each Equipment Requirement of the given list, the command performs the following checks: \r\n1. Checks if the Sequence of the Equipment Requirement is positive, if not error 10997 is returned. \r\n2. Checks if the Planned Equipment of the Equipment Requirement exists, if not error 10996 is returned. \r\n3. Checks that either a piece of Equipment or an Equipment Group is specified, if not error 10309 is returned. \r\n4. If both an Equipment Group and the piece of Equipment are specified, checks if the piece of Equipment belongs to this group, if not error 10993 is reutrned. \r\n5. Checks if the speicfied PlannedSetupStartTime is inferior to the specified PlannedSetupEndTime, if not error 11315 otherwise. \r\n6. If the \"IsMain\" property is set to True, checks if the Equipment Group identifier is specified, if not error -10899 is returned. ","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Associates to the specified Work Order Operation the given list of Equipment Requirements. \r\nReminder: an Equipment Requirement could be a piece of Equipment, or an Equipment Group, or both. \r\nChecks if the Work Order Operation exists. Throws the error 10948 otherwise. \r\nChecks if the Work Order Operation is Frozen. Throws the error 10992 otherwise. \r\nThen for each Equipment Requirement of the given list, the command performs the following checks: \r\n1. Checks if the Sequence of the Equipment Requirement is positive, if not error 10997 is returned. \r\n2. Checks if the Planned Equipment of the Equipment Requirement exists, if not error 10996 is returned. \r\n3. Checks that either a piece of Equipment or an Equipment Group is specified, if not error 10309 is returned. \r\n4. If both an Equipment Group and the piece of Equipment are specified, checks if the piece of Equipment belongs to this group, if not error 10993 is reutrned. \r\n5. Checks if the speicfied PlannedSetupStartTime is inferior to the specified PlannedSetupEndTime, if not error 11315 otherwise. \r\n6. If the \"IsMain\" property is set to True, checks if the Equipment Group identifier is specified, if not error -10899 is returned. "},"SystemAnnotations":[{"$id":"6354","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"6355","$type":"DslTerminalNode","Text":"@Guid(db2369b2-105e-4c56-ba94-885b3a7cb3e7)","FullInfo":"@Guid(db2369b2-105e-4c56-ba94-885b3a7cb3e7)","InfoMap":{"$id":"6356","FullIdObj":{"$id":"6357","$type":"IdentificableText","Name":"@Guid(db2369b2-105e-4c56-ba94-885b3a7cb3e7)","FullInfo":"@Guid(db2369b2-105e-4c56-ba94-885b3a7cb3e7)","TypeResolved":""}},"FullIdObj":{"$ref":"6357"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(db2369b2-105e-4c56-ba94-885b3a7cb3e7)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(db2369b2-105e-4c56-ba94-885b3a7cb3e7)"}],"TagAnnotations":[],"_text":"AddWorkOrderOperationEquipmentRequirementsToWorkOrderOperation","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AddWorkOrderOperationEquipmentRequirementsToWorkOrderOperation"},{"$id":"6358","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"6359","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"6360","$type":"DslCommandPropertyCollectionTree","Name":"InputProperties","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"ChildrenList":[{"$id":"6361","$type":"DslCommandPropertyTree","Children":[{"$id":"6362","$type":"DslTerminalNode","Text":"WorkOrderOperationId","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWo