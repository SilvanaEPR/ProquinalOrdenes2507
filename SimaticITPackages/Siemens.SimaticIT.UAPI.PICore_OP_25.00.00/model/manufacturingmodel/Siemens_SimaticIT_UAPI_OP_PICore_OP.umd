801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":1453,"CharPositionInLine":28,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Output declaration commands","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"10403","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"10404","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"10405","$type":"DslTerminalNode","Text":"AddWorkOrderOperationActualEquipmentToWorkOrderOperation","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationActualEquipmentToWorkOrderOperation","InfoMap":{"$id":"10406","FullIdObj":{"$id":"10407","$type":"IdentificableObject","Guid":"134f1b94-5e10-44c6-a123-f509c0d8b928","Name":"AddWorkOrderOperationActualEquipmentToWorkOrderOperation","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationActualEquipmentToWorkOrderOperation","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"10407"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"10408","$type":"DslTerminalNode","Text":"Creates a new Actual Equipment of a Work Order Operation. The to-be-created WoOp Actual Equipment have properties that are initiated with the values of the Equipment Requirement that it is related to.\r\nThe commands verifies that:\r\n- the given WorkOrderOperationEquipmentRequirementId exists, otherwise it throws the error 11225;\r\n- the given Actual Equipment NId exists, otherwise it throws the error code 10859;\r\n- the related Work Order Operation isn't frozen, otherwise it throws the error code 10992.\r\nThe command creates a new WoOp Actual Equipment with the given equipment and the data of the given Equipment Requirement.\r\nIf an Actual Equipment already exists with the same data, no Actual Equipment is added and the command throws the error 11224.   \r\nAn Actual Equipment already exists when its property ActualEquipmentNId equals the given argument and its properties match the fields of the given Equipment Requirement.\r\nThe command returns an identifier of the Work Order Operation Actual Equipment that was created.","FullInfo":"Creates a new Actual Equipment of a Work Order Operation. The to-be-created WoOp Actual Equipment have properties that are initiated with the values of the Equipment Requirement that it is related to.\r\nThe commands verifies that:\r\n- the given WorkOrderOperationEquipmentRequirementId exists, otherwise it throws the error 11225;\r\n- the given Actual Equipment NId exists, otherwise it throws the error code 10859;\r\n- the related Work Order Operation isn't frozen, otherwise it throws the error code 10992.\r\nThe command creates a new WoOp Actual Equipment with the given equipment and the data of the given Equipment Requirement.\r\nIf an Actual Equipment already exists with the same data, no Actual Equipment is added and the command throws the error 11224.   \r\nAn Actual Equipment already exists when its property ActualEquipmentNId equals the given argument and its properties match the fields of the given Equipment Requirement.\r\nThe command returns an identifier of the Work Order Operation Actual Equipment that was created.","InfoMap":{"$id":"10409","FullIdObj":{"$id":"10410","$type":"IdentificableText","Name":"Creates a new Actual Equipment of a Work Order Operation. The to-be-created WoOp Actual Equipment have properties that are initiated with the values of the Equipment Requirement that it is related to.\r\nThe commands verifies that:\r\n- the given WorkOrderOperationEquipmentRequirementId exists, otherwise it throws the error 11225;\r\n- the given Actual Equipment NId exists, otherwise it throws the error code 10859;\r\n- the related Work Order Operation isn't frozen, otherwise it throws the error code 10992.\r\nThe command creates a new WoOp Actual Equipment with the given equipment and the data of the given Equipment Requirement.\r\nIf an Actual Equipment already exists with the same data, no Actual Equipment is added and the command throws the error 11224.   \r\nAn Actual Equipment already exists when its property ActualEquipmentNId equals the given argument and its properties match the fields of the given Equipment Requirement.\r\nThe command returns an identifier of the Work Order Operation Actual Equipment that was created.","FullInfo":"Creates a new Actual Equipment of a Work Order Operation. The to-be-created WoOp Actual Equipment have properties that are initiated with the values of the Equipment Requirement that it is related to.\r\nThe commands verifies that:\r\n- the given WorkOrderOperationEquipmentRequirementId exists, otherwise it throws the error 11225;\r\n- the given Actual Equipment NId exists, otherwise it throws the error code 10859;\r\n- the related Work Order Operation isn't frozen, otherwise it throws the error code 10992.\r\nThe command creates a new WoOp Actual Equipment with the given equipment and the data of the given Equipment Requirement.\r\nIf an Actual Equipment already exists with the same data, no Actual Equipment is added and the command throws the error 11224.   \r\nAn Actual Equipment already exists when its property ActualEquipmentNId equals the given argument and its properties match the fields of the given Equipment Requirement.\r\nThe command returns an identifier of the Work Order Operation Actual Equipment that was created.","TypeResolved":""}},"FullIdObj":{"$ref":"10410"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Creates a new Actual Equipment of a Work Order Operation. The to-be-created WoOp Actual Equipment have properties that are initiated with the values of the Equipment Requirement that it is related to.\r\nThe commands verifies that:\r\n- the given WorkOrderOperationEquipmentRequirementId exists, otherwise it throws the error 11225;\r\n- the given Actual Equipment NId exists, otherwise it throws the error code 10859;\r\n- the related Work Order Operation isn't frozen, otherwise it throws the error code 10992.\r\nThe command creates a new WoOp Actual Equipment with the given equipment and the data of the given Equipment Requirement.\r\nIf an Actual Equipment already exists with the same data, no Actual Equipment is added and the command throws the error 11224.   \r\nAn Actual Equipment already exists when its property ActualEquipmentNId equals the given argument and its properties match the fields of the given Equipment Requirement.\r\nThe command returns an identifier of the Work Order Operation Actual Equipment that was created.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Creates a new Actual Equipment of a Work Order Operation. The to-be-created WoOp Actual Equipment have properties that are initiated with the values of the Equipment Requirement that it is related to.\r\nThe commands verifies that:\r\n- the given WorkOrderOperationEquipmentRequirementId exists, otherwise it throws the error 11225;\r\n- the given Actual Equipment NId exists, otherwise it throws the error code 10859;\r\n- the related Work Order Operation isn't frozen, otherwise it throws the error code 10992.\r\nThe command creates a new WoOp Actual Equipment with the given equipment and the data of the given Equipment Requirement.\r\nIf an Actual Equipment already exists with the same data, no Actual Equipment is added and the command throws the error 11224.   \r\nAn Actual Equipment already exists when its property ActualEquipmentNId equals the given argument and its properties match the fields of the given Equipment Requirement.\r\nThe command returns an identifier of the Work Order Operation Actual Equipment that was created."},"SystemAnnotations":[{"$id":"10411","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"10412","$type":"DslTerminalNode","Text":"@Guid(134f1b94-5e10-44c6-a123-f509c0d8b928)","FullInfo":"@Guid(134f1b94-5e10-44c6-a123-f509c0d8b928)","InfoMap":{"$id":"10413","FullIdObj":{"$id":"10414","$type":"IdentificableText","Name":"@Guid(134f1b94-5e10-44c6-a123-f509c0d8b928)","FullInfo":"@Guid(134f1b94-5e10-44c6-a123-f509c0d8b928)","TypeResolved":""}},"FullIdObj":{"$ref":"10414"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(134f1b94-5e10-44c6-a123-f509c0d8b928)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(134f1b94-5e10-44c6-a123-f509c0d8b928)"}],"TagAnnotations":[],"_text":"AddWorkOrderOperationActualEquipmentToWorkOrderOperation","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AddWorkOrderOperationActualEquipmentToWorkOrderOperation"},{"$id":"10415","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"10416","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"10417","$type":"DslCommandPropertyCollectionTree","Name":"InputPropertie