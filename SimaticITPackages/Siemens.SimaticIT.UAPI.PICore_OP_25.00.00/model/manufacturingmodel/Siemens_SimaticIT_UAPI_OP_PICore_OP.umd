is Post-Action is triggered after the execution of the TagForMaintenanceWorkOrder Command.\r\nIt marks for deleting all the InspectionExecutionEngine and TimeBasedInspectionExecutionEngine Entities related to the respective Work Order.","InfoMap":{"$id":"12444","FullIdObj":{"$id":"12445","$type":"IdentificableText","Name":"This Post-Action is triggered after the execution of the TagForMaintenanceWorkOrder Command.\r\nIt marks for deleting all the InspectionExecutionEngine and TimeBasedInspectionExecutionEngine Entities related to the respective Work Order.","FullInfo":"This Post-Action is triggered after the execution of the TagForMaintenanceWorkOrder Command.\r\nIt marks for deleting all the InspectionExecutionEngine and TimeBasedInspectionExecutionEngine Entities related to the respective Work Order.","TypeResolved":""}},"FullIdObj":{"$ref":"12445"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"This Post-Action is triggered after the execution of the TagForMaintenanceWorkOrder Command.\r\nIt marks for deleting all the InspectionExecutionEngine and TimeBasedInspectionExecutionEngine Entities related to the respective Work Order.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"This Post-Action is triggered after the execution of the TagForMaintenanceWorkOrder Command.\r\nIt marks for deleting all the InspectionExecutionEngine and TimeBasedInspectionExecutionEngine Entities related to the respective Work Order."},"SystemAnnotations":[{"$id":"12446","$type":"DslKeywordNode","Text":"Optional","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Optional","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Optional"}],"CustomAnnotations":[{"$id":"12447","$type":"DslTerminalNode","Text":"@AddedOnMinorVersion=17.01.00","FullInfo":"@AddedOnMinorVersion=17.01.00","InfoMap":{"$id":"12448","FullIdObj":{"$id":"12449","$type":"IdentificableText","Name":"@AddedOnMinorVersion=17.01.00","FullInfo":"@AddedOnMinorVersion=17.01.00","TypeResolved":""}},"FullIdObj":{"$ref":"12449"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@AddedOnMinorVersion=17.01.00","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@AddedOnMinorVersion=17.01.00"},{"$id":"12450","$type":"DslTerminalNode","Text":"@Guid(a9af3b91-690c-441e-8ac6-17f0c8328515)","FullInfo":"@Guid(a9af3b91-690c-441e-8ac6-17f0c8328515)","InfoMap":{"$id":"12451","FullIdObj":{"$id":"12452","$type":"IdentificableText","Name":"@Guid(a9af3b91-690c-441e-8ac6-17f0c8328515)","FullInfo":"@Guid(a9af3b91-690c-441e-8ac6-17f0c8328515)","TypeResolved":""}},"FullIdObj":{"$ref":"12452"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(a9af3b91-690c-441e-8ac6-17f0c8328515)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(a9af3b91-690c-441e-8ac6-17f0c8328515)"}],"TagAnnotations":[],"_text":"TagForMaintenanceQualityInspectionsToBeDeleted","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"TagForMaintenanceQualityInspectionsToBeDeleted"},{"$id":"12453","$type":"DslTerminalNode","Text":"TagForMaintenanceWorkOrder","FullInfo":"Siemens.OpcenterEX.OperationalData.Maintenance_OP.OPModel.Commands.TagForMaintenanceWorkOrder","InfoMap":{"$id":"12454","FullIdObj":{"$ref":"12009"}},"FullIdObj":{"$ref":"12009"},"Children":[],"Name":"ReferencedCommandFullName","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":2061,"CharPositionInLine":62,"_text":"TagForMaintenanceWorkOrder","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"TagForMaintenanceWorkOrder"}],"Name":"PostCommand","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"12455","$type":"DslPostCommandDeclarationTree","Children":[{"$id":"12456","$type":"DslKeywordNode","Text":"POSTCOMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"POSTCOMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"POSTCOMMAND"},{"$id":"12457","$type":"DslTerminalNode","Text":"UpdateWorkOrderActualQuantity","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.UpdateWorkOrderActualQuantity","InfoMap":{"$id":"12458","FullIdObj":{"$id":"12459","$type":"IdentificableObject","Guid":"dc626049-3199-4df2-b677-93cae158fae1","Name":"UpdateWorkOrderActualQuantity","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.UpdateWorkOrderActualQuantity","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"12459"},"Children":[],"Name":"PostCommand","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"12460","$type":"DslTerminalNode","Text":"Updates the Work Order Actual Quantity with the total quantity of produced MTU's in the Work Order that matching the MaterialId/Revision of the Work Order.\r\nThis post action is executed after the command AddMTUsToWorkOrderOperationActualMaterials.\r\nWhen MTUs are added to an OUTPUT Material Actual on a work order operation that matches the MaterialId/Revision defined at the Work Order header.\r\n\r\nThe quantity is converted into the UoM defined in the Actual Qty UoM of the Work Order header.\r\n\r\nThe post action will:\r\n1. Retrieve the WorkOrderOperationActualMaterial\r\n2. check if the WorkOrderOperationActualMaterial exists\r\n3. retrieve the WorkOrder\r\n4. check if the WorkOrder exists\r\n5. check if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision\r\n6. retrieve the WorkOrderExtended facet\r\n7. calculate the new WorkOrderActualQuantity as sum between the current WorkOrderActualQuantity with of all the MTUs added to the WorkOrderOperationActualMaterial performing also a UoM conversion to the WorkOrder UoM.\r\n8. check if the new WorkOrderActualQuantity is different from the previous one or null\r\n9. update the WorkOrderActualQuantity (QuantityValue and UoM).\r\n\r\nThe post action performs the following checks:\r\n1. if WorkOrderOperationActualMaterial exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n2. if WorkOrder exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n3. if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision, if not post action exit without updating the WorkOrderActualQuantity.\r\n4. if the UoM conversion has been executed with success, if not a not blocking error is traced and the quantity converted is set to null.\r\n5. if the new WorkOrderActualQuantity is different from the previous one or null, if not warning and the post action exit without updating the WorkOrderActualQuantity\r\n5. if the CallCommand fails, the same error returned by command is traced. \r\n","FullInfo":"Updates the Work Order Actual Quantity with the total quantity of produced MTU's in the Work Order that matching the MaterialId/Revision of the Work Order.\r\nThis post action is executed after the command AddMTUsToWorkOrderOperationActualMaterials.\r\nWhen MTUs are added to an OUTPUT Material Actual on a work order operation that matches the MaterialId/Revision defined at the Work Order header.\r\n\r\nThe quantity is converted into the UoM defined in the Actual Qty UoM of the Work Order header.\r\n\r\nThe post action will:\r\n1. Retrieve the WorkOrderOperationActualMaterial\r\n2. check if the WorkOrderOperationActualMaterial exists\r\n3. retrieve the WorkOrder\r\n4. check if the WorkOrder exists\r\n5. check if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision\r\n6. retrieve the WorkOrderExtended facet\r\n7. calculate the new WorkOrderActualQuantity as sum between the current WorkOrderActualQuantity with of all the MTUs added to the WorkOrderOperationActualMaterial performing also a UoM conversion to the WorkOrder UoM.\r\n8. check if the new WorkOrderActualQuantity is different from the previous one or null\r\n9. update the WorkOrderActualQuantity (QuantityValue and UoM).\r\n\r\nThe post action performs the following checks:\r\n1. if WorkOrderOperationActualMaterial exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n2. if WorkOrder exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n3. if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision, if not post action exit without updating the WorkOrderActualQuantity.\r\n4. if the UoM conversion has been executed with success, if not a not blocking error is traced and the quantity converted is set to null.\r\n5. if the new WorkOrderActualQuantity is different from the previous one or null, if not warning and the post action exit without updating the WorkOrderActualQuantity\r\n5. if the CallCommand fails, the same error returned by command is traced. \r\n","InfoMap":{"$id":"12461","FullIdObj":{"$id":"12462","$type":"IdentificableText","Name":"Updates the Work Order Actual Quantity with the total quantity of produced MTU's in the Work Order that matching the MaterialId/Revision of the Work Order.\r\nThis post action is executed after the command AddMTUsToWorkOrderOperationActualMaterials.\r\nWhen MTUs are added to an OUTPUT Material Actual on a work order operation that matches the MaterialId/Revision defined at the Work Order header.\r\n\r\nThe quantity is converted into the UoM defined in the Actual Qty UoM of the Work Order header.\r\n\r\nThe post action will:\r\n1. Retrieve the WorkOrderOperationActualMaterial\r\n2. check if the WorkOrderOperationActualMaterial exists\r\n3. retrieve the WorkOrder\r\n4. check if the WorkOrder exists\r\n5. check if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision\r\n6. retrieve the WorkOrderExtended facet\r\n7. calculate the new WorkOrderActualQuantity as sum between the current WorkOrderActualQuantity with of all the MTUs added to the WorkOrderOperationActualMaterial performing also a UoM conversion to the WorkOrder UoM.\r\n8. check if the new WorkOrderActualQuantity is different from the previous one or null\r\n9. update the WorkOrderActualQuantity (QuantityValue and UoM).\r\n\r\nThe post action performs the following checks:\r\n1. if WorkOrderOperationActualMaterial exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n2. if WorkOrder exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n3. if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision, if not post action exit without updating the WorkOrderActualQuantity.\r\n4. if the UoM conversion has been executed with success, if not a not blocking error is traced and the quantity converted is set to null.\r\n5. if the new WorkOrderActualQuantity is different from the previous one or null, if not warning and the post action exit without updating the WorkOrderActualQuantity\r\n5. if the CallCommand fails, the same error returned by command is traced. \r\n","FullInfo":"Updates the Work Order Actual Quantity with the total quantity of produced MTU's in the Work Order that matching the MaterialId/Revision of the Work Order.\r\nThis post action is executed after the command AddMTUsToWorkOrderOperationActualMaterials.\r\nWhen MTUs are added to an OUTPUT Material Actual on a work order operation that matches the MaterialId/Revision defined at the Work Order header.\r\n\r\nThe quantity is converted into the UoM defined in the Actual Qty UoM of the Work Order header.\r\n\r\nThe post action will:\r\n1. Retrieve the WorkOrderOperationActualMaterial\r\n2. check if the WorkOrderOperationActualMaterial exists\r\n3. retrieve the WorkOrder\r\n4. check if the WorkOrder exists\r\n5. check if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision\r\n6. retrieve the WorkOrderExtended facet\r\n7. calculate the new WorkOrderActualQuantity as sum between the current WorkOrderActualQuantity with of all the MTUs added to the WorkOrderOperationActualMaterial performing also a UoM conversion to the WorkOrder UoM.\r\n8. check if the new WorkOrderActualQuantity is different from the previous one or null\r\n9. update the WorkOrderActualQuantity (QuantityValue and UoM).\r\n\r\nThe post action performs the following checks:\r\n1. if WorkOrderOperationActualMaterial exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n2. if WorkOrder exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n3. if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision, if not post action exit without updating the WorkOrderActualQuantity.\r\n4. if the UoM conversion has been executed with success, if not a not blocking error is traced and the quantity converted is set to null.\r\n5. if the new WorkOrderActualQuantity is different from the previous one or null, if not warning and the post action exit without updating the WorkOrderActualQuantity\r\n5. if the CallCommand fails, the same error returned by command is traced. \r\n","TypeResolved":""}},"FullIdObj":{"$ref":"12462"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Updates the Work Order Actual Quantity with the total quantity of produced MTU's in the Work Order that matching the MaterialId/Revision of the Work Order.\r\nThis post action is executed after the command AddMTUsToWorkOrderOperationActualMaterials.\r\nWhen MTUs are added to an OUTPUT Material Actual on a work order operation that matches the MaterialId/Revision defined at the Work Order header.\r\n\r\nThe quantity is converted into the UoM defined in the Actual Qty UoM of the Work Order header.\r\n\r\nThe post action will:\r\n1. Retrieve the WorkOrderOperationActualMaterial\r\n2. check if the WorkOrderOperationActualMaterial exists\r\n3. retrieve the WorkOrder\r\n4. check if the WorkOrder exists\r\n5. check if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision\r\n6. retrieve the WorkOrderExtended facet\r\n7. calculate the new WorkOrderActualQuantity as sum between the current WorkOrderActualQuantity with of all the MTUs added to the WorkOrderOperationActualMaterial performing also a UoM conversion to the WorkOrder UoM.\r\n8. check if the new WorkOrderActualQuantity is different from the previous one or null\r\n9. update the WorkOrderActualQuantity (QuantityValue and UoM).\r\n\r\nThe post action performs the following checks:\r\n1. if WorkOrderOperationActualMaterial exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n2. if WorkOrder exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n3. if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision, if not post action exit without updating the WorkOrderActualQuantity.\r\n4. if the UoM conversion has been executed with success, if not a not blocking error is traced and the quantity converted is set to null.\r\n5. if the new WorkOrderActualQuantity is different from the previous one or null, if not warning and the post action exit without updating the WorkOrderActualQuantity\r\n5. if the CallCommand fails, the same error returned by command is traced. \r\n","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Updates the Work Order Actual Quantity with the total quantity of produced MTU's in the Work Order that matching the MaterialId/Revision of the Work Order.\r\nThis post action is executed after the command AddMTUsToWorkOrderOperationActualMaterials.\r\nWhen MTUs are added to an OUTPUT Material Actual on a work order operation that matches the MaterialId/Revision defined at the Work Order header.\r\n\r\nThe quantity is converted into the UoM defined in the Actual Qty UoM of the Work Order header.\r\n\r\nThe post action will:\r\n1. Retrieve the WorkOrderOperationActualMaterial\r\n2. check if the WorkOrderOperationActualMaterial exists\r\n3. retrieve the WorkOrder\r\n4. check if the WorkOrder exists\r\n5. check if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision\r\n6. retrieve the WorkOrderExtended facet\r\n7. calculate the new WorkOrderActualQuantity as sum between the current WorkOrderActualQuantity with of all the MTUs added to the WorkOrderOperationActualMaterial performing also a UoM conversion to the WorkOrder UoM.\r\n8. check if the new WorkOrderActualQuantity is different from the previous one or null\r\n9. update the WorkOrderActualQuantity (QuantityValue and UoM).\r\n\r\nThe post action performs the following checks:\r\n1. if WorkOrderOperationActualMaterial exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n2. if WorkOrder exists, if not post action exit without updating the WorkOrderActualQuantity.\r\n3. if there is a match between WorkOrder material NId/Revision and WorkOrderOperationActualMaterial NId/Revision, if not post action exit without updating the WorkOrderActualQuantity.\r\n4. if the UoM conversion has been executed with success, if not a not blocking error is traced and the quantity converted is set to null.\r\n5. if the new WorkOrderActualQuantity is different from the previous one or null, if not warning and the post action exit without updating the WorkOrderActualQuantity\r\n5. if the CallCommand fails, the same error returned by command is traced. \r\n"},"SystemAnnotations":[{"$id":"12463","$type":"DslKeywordNode","Text":"Optional","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Optional","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Optional"}],"CustomAnnotations":[{"$id":"12464","$type":"DslTerminalNode","Text":"@Guid(dc626049-3199-4df2-b677-93cae158fae1)","FullInfo":"@Guid(dc626049-3199-4df2-b677-93cae158fae1)","InfoMap":{"$id":"12465","FullIdObj":{"$id":"12466","$type":"IdentificableText","Name":"@Guid(dc626049-3199-4df2-b677-93cae158fae1)","FullInfo":"@Guid(dc626049-3199-4df2-b677-93cae158fae1)","TypeResolved":""}},"FullIdObj":{"$ref":"12466"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(dc626049-3199-4df2-b677-93cae158fae1)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(dc626049-3199-4df2-b677-93cae158fae1)"}],"TagAnnotations":[],"_text":"UpdateWorkOrderActualQuantity","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"UpdateWorkOrderActualQuantity"},{"$id":"12467","$type":"DslTerminalNode","Text":"AddMTUsToWorkOrderOperationActualMaterialV2","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddMTUsToWorkOrderOperationActualMaterialV2","InfoMap":{"$id":"12468","FullIdObj":{"$ref":"8921"}},"FullIdObj":{"$ref":"8921"},"Children":[],"Name":"ReferencedCommandFullName","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":2090,"CharPositionInLine":45,"_text":"AddMTUsToWorkOrderOperationActualMaterialV2","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AddMTUsToWorkOrderOperationActualMaterialV2"}],"Name":"PostCommand","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"12469","$type":"DslPostCommandDeclarationTree","Children":[{"$id":"12470","$type":"DslKeywordNode","Text":"POSTCOMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"