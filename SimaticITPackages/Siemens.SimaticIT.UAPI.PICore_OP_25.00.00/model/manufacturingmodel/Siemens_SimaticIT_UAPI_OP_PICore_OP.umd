Info":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationActualEquipmentToWorkOrderOperationFromTask","InfoMap":{"$id":"10467","FullIdObj":{"$id":"10468","$type":"IdentificableObject","Guid":"0af8d60f-e148-43a6-a78f-921dbec19ff9","Name":"AddWorkOrderOperationActualEquipmentToWorkOrderOperationFromTask","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationActualEquipmentToWorkOrderOperationFromTask","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"10468"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"10469","$type":"DslTerminalNode","Text":"Retrieves the EquipmentNId as saved in the EquipmentNId property of the given Task.\r\nChecks that the Task exists, otherwise throws the Error 11309.\r\nIf the Task has its property Assign\\_From_Equipment\\_Requirement set to true, the command searches for eventual related Equipment Requirements of the Work Order Operation related to the Task.\r\nOnly if the property Assign\\_From\\_Equipment\\_Requirement is set to true, it calls the command AddWorkOrderOperationActualEquipmentToWorkOrderOperation that will create the Actual Equipment.\r\nIf the result of the AddWorkOrderOperationActualEquipmentToWorkOrderOperation command returns an error code (that isn't equal to error code 11224), it throws the error 11226.","FullInfo":"Retrieves the EquipmentNId as saved in the EquipmentNId property of the given Task.\r\nChecks that the Task exists, otherwise throws the Error 11309.\r\nIf the Task has its property Assign\\_From_Equipment\\_Requirement set to true, the command searches for eventual related Equipment Requirements of the Work Order Operation related to the Task.\r\nOnly if the property Assign\\_From\\_Equipment\\_Requirement is set to true, it calls the command AddWorkOrderOperationActualEquipmentToWorkOrderOperation that will create the Actual Equipment.\r\nIf the result of the AddWorkOrderOperationActualEquipmentToWorkOrderOperation command returns an error code (that isn't equal to error code 11224), it throws the error 11226.","InfoMap":{"$id":"10470","FullIdObj":{"$id":"10471","$type":"IdentificableText","Name":"Retrieves the EquipmentNId as saved in the EquipmentNId property of the given Task.\r\nChecks that the Task exists, otherwise throws the Error 11309.\r\nIf the Task has its property Assign\\_From_Equipment\\_Requirement set to true, the command searches for eventual related Equipment Requirements of the Work Order Operation related to the Task.\r\nOnly if the property Assign\\_From\\_Equipment\\_Requirement is set to true, it calls the command AddWorkOrderOperationActualEquipmentToWorkOrderOperation that will create the Actual Equipment.\r\nIf the result of the AddWorkOrderOperationActualEquipmentToWorkOrderOperation command returns an error code (that isn't equal to error code 11224), it throws the error 11226.","FullInfo":"Retrieves the EquipmentNId as saved in the EquipmentNId property of the given Task.\r\nChecks that the Task exists, otherwise throws the Error 11309.\r\nIf the Task has its property Assign\\_From_Equipment\\_Requirement set to true, the command searches for eventual related Equipment Requirements of the Work Order Operation related to the Task.\r\nOnly if the property Assign\\_From\\_Equipment\\_Requirement is set to true, it calls the command AddWorkOrderOperationActualEquipmentToWorkOrderOperation that will create the Actual Equipment.\r\nIf the result of the AddWorkOrderOperationActualEquipmentToWorkOrderOperation command returns an error code (that isn't equal to error code 11224), it throws the error 11226.","TypeResolved":""}},"FullIdObj":{"$ref":"10471"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Retrieves the EquipmentNId as saved in the EquipmentNId property of the given Task.\r\nChecks that the Task exists, otherwise throws the Error 11309.\r\nIf the Task has its property Assign\\_From_Equipment\\_Requirement set to true, the command searches for eventual related Equipment Requirements of the Work Order Operation related to the Task.\r\nOnly if the property Assign\\_From\\_Equipment\\_Requirement is set to true, it calls the command AddWorkOrderOperationActualEquipmentToWorkOrderOperation that will create the Actual Equipment.\r\nIf the result of the AddWorkOrderOperationActualEquipmentToWorkOrderOperation command returns an error code (that isn't equal to error code 11224), it throws the error 11226.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Retrieves the EquipmentNId as saved in the EquipmentNId property of the given Task.\r\nChecks that the Task exists, otherwise throws the Error 11309.\r\nIf the Task has its property Assign\\_From_Equipment\\_Requirement set to true, the command searches for eventual related Equipment Requirements of the Work Order Operation related to the Task.\r\nOnly if the property Assign\\_From\\_Equipment\\_Requirement is set to true, it calls the command AddWorkOrderOperationActualEquipmentToWorkOrderOperation that will create the Actual Equipment.\r\nIf the result of the AddWorkOrderOperationActualEquipmentToWorkOrderOperation command returns an error code (that isn't equal to error code 11224), it throws the error 11226."},"SystemAnnotations":[{"$id":"10472","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"10473","$type":"DslTerminalNode","Text":"@Guid(0af8d60f-e148-43a6-a78f-921dbec19ff9)","FullInfo":"@Guid(0af8d60f-e148-43a6-a78f-921dbec19ff9)","InfoMap":{"$id":"10474","FullIdObj":{"$id":"10475","$type":"IdentificableText","Name":"@Guid(0af8d60f-e148-43a6-a78f-921dbec19ff9)","FullInfo":"@Guid(0af8d60f-e148-43a6