ject","Guid":"38a329f5-6365-46cb-b73a-ad3189e2ea9e","Name":"AddWorkOrderOperationByWorkMasterOperation","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationByWorkMasterOperation","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"10253"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"10254","$type":"DslTerminalNode","Text":"Adds a Work Order Operation, together with its Requirements, to a Work Order, given the data of a Work Master Operation, which has been made available for Work Order enrichment.\r\nChecks if the Work Order exists, otherwise it throws the error 10300.\r\nChecks if the Work Order is frozen, otherwise it throws the error 10992.\r\nChecks if the Work Master exists, otherwise it throws the error 10300.\r\nChecks if the State Machine (of the given Work Master Operation) exists, and that this State Machine has an initial status, otherwise it throws the error 10984.","FullInfo":"Adds a Work Order Operation, together with its Requirements, to a Work Order, given the data of a Work Master Operation, which has been made available for Work Order enrichment.\r\nChecks if the Work Order exists, otherwise it throws the error 10300.\r\nChecks if the Work Order is frozen, otherwise it throws the error 10992.\r\nChecks if the Work Master exists, otherwise it throws the error 10300.\r\nChecks if the State Machine (of the given Work Master Operation) exists, and that this State Machine has an initial status, otherwise it throws the error 10984.","InfoMap":{"$id":"10255","FullIdObj":{"$id":"10256","$type":"IdentificableText","Name":"Adds a Work Order Operation, together with its Requirements, to a Work Order, given the data of a Work Master Operation, which has been made available for Work Order enrichment.\r\nChecks if the Work Order exists, otherwise it throws the error 10300.\r\nChecks if the Work Order is frozen, otherwise it throws the error 10992.\r\nChecks if the Work Master exists, otherwise it throws the error 10300.\r\nChecks if the State Machine (of the given Work Master Operation) exists, and that this State Machine has an initial status, otherwise it throws the error 10984.","FullInfo":"Adds a Work Order Operation, together with its Requirements, to a Work Order, given the data of a Work Master Operation, which has been made available for Work Order enrichment.\r\nChecks if the Work Order exists, otherwise it throws the error 10300.\r\nChecks if the Work Order is frozen, otherwise it throws the error 10992.\r\nChecks if the Work Master exists, otherwise it throws the error 10300.\r\nChecks if the State Machine (of the given Work Master Operation) exists, and that this State Machine has an initial status, otherwise it throws the error 10984.","TypeResolved":""}},"FullIdObj":{"$ref":"10256"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Adds a Work Order Operation, together with its Requirements, to a Work Order, given the data of a Work Master Operation, which has been made available for Work Order enrichment.\r\nChecks if the Work Order exists, otherwise it throws the error 10300.\r\nChecks if the Work Order is frozen, otherwise it throws the error 10992.\r\nChecks if the Work Master exists, otherwise it throws the error 10300.\r\nChecks if the State Machine (of the given Work Master Operation) exists, and that this State Machine has an initial status, otherwise it throws the error 10984.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Adds a Work Order Operation, together with its Requirements, to a Work Order, given the data of a Work Master Operation, which has been made available for Work Order enrichment.\r\nChecks if the Work Order exists, otherwise it throws the error 10300.\r\nChecks if the Work Order is frozen, otherwise it throws the error 10992.\r\nChecks if the Work Master exists, otherwise it throws the error 10300.\r\nChecks if the State Machine (of the given Work Master Operation) exists, and that this State Machine has an initial status, otherwise it throws the error 10984."},"SystemAnnotations":[{"$id":"10257","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"10258","$type":"DslTerminalNode","Text":"@Guid(38a329f5-6365-46cb-b73a-ad3189e2ea9e)","FullInfo":"@Guid(38a329f5-6365-46cb-b73a-ad3189e2ea9e)","InfoMap":{"$id":"10259","FullIdObj":{"$id":"10260","$type":"IdentificableText","Name":"@Guid(38a329f5-6365-46cb-b73a-ad3189e2ea9e)","FullInfo":"@Guid(38a329f5-6365-46cb-b73a-ad3189e2ea9e)","TypeResolved":""}},"FullIdObj":{"$ref":"10260"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(38a329f5-6365-46cb-b73a-ad3189e2ea9e)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(38a329f5-6365-46cb-b73a-ad3189e2ea9e)"}],"TagAnnotations":[],"_text":"AddWorkOrderOperationByWorkMasterOperation","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AddWorkOrderOperationByWorkMasterOperation"},{"$id":"10261","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"10262","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"10263","$type":"DslCommandPropertyCollectionTree","Name":"InputProperties","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"ChildrenList":[{"$id":"10264","$type":"DslCommandPropertyTree","Children":[{"$id":"10265","$type":"DslTerminalNode","Text":"WorkMasterNId","FullInfo":"Siemens.SimaticIT.UAPI.OperationalDa