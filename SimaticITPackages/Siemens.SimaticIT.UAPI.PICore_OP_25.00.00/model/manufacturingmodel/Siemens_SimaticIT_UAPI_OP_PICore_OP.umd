nnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"10692","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"10693","$type":"DslKeywordNode","Text":"list of","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"list of","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"list of"},{"$id":"10694","$type":"DslTerminalNode","Text":"Guid","FullInfo":"Guid","InfoMap":{"$id":"10695","FullIdObj":{"$id":"10696","$type":"IdentificableTypeSystem","Name":"Guid","FullInfo":"Guid","TypeResolved":""}},"FullIdObj":{"$ref":"10696"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":1555,"CharPositionInLine":51,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Output declaration commands","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"10697","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"10698","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"10699","$type":"DslTerminalNode","Text":"AddParameterRequirementsToWorkOrderOperationFromCatalogCalculatingPercentages","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddParameterRequirementsToWorkOrderOperationFromCatalogCalculatingPercentages","InfoMap":{"$id":"10700","FullIdObj":{"$id":"10701","$type":"IdentificableObject","Guid":"ac81c217-a84b-4755-b63d-1dbe15ce4619","Name":"AddParameterRequirementsToWorkOrderOperationFromCatalogCalculatingPercentages","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddParameterRequirementsToWorkOrderOperationFromCatalogCalculatingPercentages","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"10701"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"10702","$type":"DslTerminalNode","Text":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nThis command takes in account if the limits and tolerances are expressed in percents. If so, the values of the limits and tolerances are calculated. They are of the same type than the Parameter Requirement. \r\nTheir value is calculated based on their percentage value of the Target Value.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","FullInfo":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nThis command takes in account if the limits and tolerances are expressed in percents. If so, the values of the limits and tolerances are calculated. They are of the same type than the Parameter Requirement. \r\nTheir value is calculated based on their percentage value of the Target Value.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","InfoMap":{"$id":"10703","FullIdObj":{"$id":"10704","$type":"IdentificableText","Name":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nThis command takes in account if the limits and tolerances are expressed in percents. If so, the values of the limits and tolerances are calculated. They are of the same type than the Parameter Requirement. \r\nTheir value is calculated based on their percentage value of the Target Value.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","FullInfo":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nThis command takes in account if the limits and tolerances are expressed in percents. If so, the values of the limits and tolerances are calculated. They are of the same type than the Parameter Requirement. \r\nTheir value is calculated based on their percentage value of the Target Value.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","TypeResolved":""}},"FullIdObj":{"$ref":"10704"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nThis command takes in account if the limits and tolerances are expressed in percents. If so, the values of the limits and tolerances are calculated. They are of the same type than the Parameter Requirement. \r\nTheir value is calculated based on their percentage value of the Target Value.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nThis command takes in account if the limits and tolerances are expressed in percents. If so, the values of the limits and tolerances are calculated. They are of the same type than the Parameter Requirement. \r\nTheir value is calculated based on their percentage value of the Target Value.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all."},"SystemAnnotations":[{"$id":"10705","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[