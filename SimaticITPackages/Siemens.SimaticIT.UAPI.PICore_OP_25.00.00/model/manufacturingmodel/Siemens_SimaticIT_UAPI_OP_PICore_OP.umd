st of primary key identifiers of the Work Order Operations that have been added to the Work Order.","FullInfo":"The list of primary key identifiers of the Work Order Operations that have been added to the Work Order.","TypeResolved":""}},"FullIdObj":{"$ref":"7962"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"The list of primary key identifiers of the Work Order Operations that have been added to the Work Order.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"The list of primary key identifiers of the Work Order Operations that have been added to the Work Order."},"SystemAnnotations":[{"$id":"7963","$type":"DslKeywordNode","Text":"Optional","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Optional","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Optional"}],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WorkOrderOperationIds","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WorkOrderOperationIds"},{"$id":"7964","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"7965","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"7966","$type":"DslKeywordNode","Text":"list of","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"list of","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"list of"},{"$id":"7967","$type":"DslTerminalNode","Text":"Guid","FullInfo":"Guid","InfoMap":{"$id":"7968","FullIdObj":{"$id":"7969","$type":"IdentificableTypeSystem","Name":"Guid","FullInfo":"Guid","TypeResolved":""}},"FullIdObj":{"$ref":"7969"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":822,"CharPositionInLine":37,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Output declaration commands","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"7970","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"7971","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"7972","$type":"DslTerminalNode","Text":"AddParameterRequirementsToWorkOrderOperationFromCatalog","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddParameterRequirementsToWorkOrderOperationFromCatalog","InfoMap":{"$id":"7973","FullIdObj":{"$id":"7974","$type":"IdentificableObject","Guid":"a65d4915-4136-419c-9ff6-43f021281460","Name":"AddParameterRequirementsToWorkOrderOperationFromCatalog","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddParameterRequirementsToWorkOrderOperationFromCatalog","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"7974"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"7975","$type":"DslTerminalNode","Text":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nThis command creates Parameter Requirements where the values of the limits and tolerances are initiated as they are provided to the command, even if they are expessed in percents.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","FullInfo":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nThis command creates Parameter Requirements where the values of the limits and tolerances are initiated as they are provided to the command, even if they are expessed in percents.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","InfoMap":{"$id":"7976","FullIdObj":{"$id":"7977","$type":"IdentificableText","Name":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nThis command creates Parameter Requirements where the values of the limits and tolerances are initiated as they are provided to the command, even if they are expessed in percents.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","FullInfo":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nThis command creates Parameter Requirements where the values of the limits and tolerances are initiated as they are provided to the command, even if they are expessed in percents.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","TypeResolved":""}},"FullIdObj":{"$ref":"7977"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nThis command creates Parameter Requirements where the values of the limits and tolerances are initiated as they are provided to the command, even if they are expessed in percents.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nThis command creates Parameter Requirements where the values of the limits and tolerances are initiated as they are provided to the command, even if they are expessed in percents.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all."},"SystemAnnotations":[{"$id":"7978","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"7979","$type":"DslTerminalNode","Text":"@Guid(a65d4915-4136-419c-9ff6-43f021281460)","FullInfo":"@Guid(a65d4915-4136-419c-9ff6-43f021281460)","InfoMap":{"$id":"7980","FullIdObj":{"$id":"7981","$type":"IdentificableText","Name":"@Guid(a65d4915-4136-419c-9ff6-43f021281460)","FullInfo":"@Guid(a65d4915-4136-419c-9ff6-43f021281460)","TypeResolved":""}},"FullIdObj":{"$ref":"7981"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(a65d4915-4136-419c-9ff6-43f021281460)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(a65d4915-4136-419c-9ff6-43f021281460)"}],"TagAnnotations":[],"_text":"AddParameterRequirementsToWorkOrderOperationFromCatalog","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AddParameterRequirementsToWorkOrderOperationFromCatalog"},{"$id":"7982","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"7983","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"7984","$type":"DslCommandPropertyCollectionTree","Name":"InputProperties","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"ChildrenList":[{"$id":"7985","$type":"DslCommandPropertyTree","Children":[{"$id":"7986","$type":"DslTerminalNode","Text":"Id","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_O