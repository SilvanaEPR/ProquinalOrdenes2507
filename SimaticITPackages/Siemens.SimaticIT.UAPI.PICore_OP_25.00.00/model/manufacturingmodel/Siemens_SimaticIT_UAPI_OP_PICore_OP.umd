dd2","Name":"AddMTUsToWorkOrderOperationActualMaterialV2","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddMTUsToWorkOrderOperationActualMaterialV2","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"8921"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"8922","$type":"DslTerminalNode","Text":"Associates a list of MTUs and/or Material Lots and/or Material Tracking Unit Aggregates to a Work Order Operation Actual Material. \r\nThe Command checks: \r\nIf the Work Order Operation has any Actual Material, if not Error -10940 is returned. \r\nIf there is at least one MTU to add , if not the Command returns an empty list as an answer. \r\n\r\n\r\n","FullInfo":"Associates a list of MTUs and/or Material Lots and/or Material Tracking Unit Aggregates to a Work Order Operation Actual Material. \r\nThe Command checks: \r\nIf the Work Order Operation has any Actual Material, if not Error -10940 is returned. \r\nIf there is at least one MTU to add , if not the Command returns an empty list as an answer. \r\n\r\n\r\n","InfoMap":{"$id":"8923","FullIdObj":{"$id":"8924","$type":"IdentificableText","Name":"Associates a list of MTUs and/or Material Lots and/or Material Tracking Unit Aggregates to a Work Order Operation Actual Material. \r\nThe Command checks: \r\nIf the Work Order Operation has any Actual Material, if not Error -10940 is returned. \r\nIf there is at least one MTU to add , if not the Command returns an empty list as an answer. \r\n\r\n\r\n","FullInfo":"Associates a list of MTUs and/or Material Lots and/or Material Tracking Unit Aggregates to a Work Order Operation Actual Material. \r\nThe Command checks: \r\nIf the Work Order Operation has any Actual Material, if not Error -10940 is returned. \r\nIf there is at least one MTU to add , if not the Command returns an empty list as an answer. \r\n\r\n\r\n","TypeResolved":""}},"FullIdObj":{"$ref":"8924"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Associates a list of MTUs and/or Material Lots and/or Material Tracking Unit Aggregates to a Work Order Operation Actual Material. \r\nThe Command checks: \r\nIf the Work Order Operation has any Actual Material, if not Error -10940 is returned. \r\nIf there is at least one MTU to add , if not the Command returns an empty list as an answer. \r\n\r\n\r\n","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Associates a list of MTUs and/or Material Lots and/or Material Tracking Unit Aggregates to a Work Order Operation Actual Material. \r\nThe Command checks: \r\nIf the Work Order Operation has any Actual Material, if not Error -10940 is returned. \r\nIf there is at least one MTU to add , if not the Command returns an empty list as an answer. \r\n\r\n\r\n"},"SystemAnnotations":[{"$id":"8925","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"8926","$type":"DslTerminalNode","Text":"@Guid(939731b2-152e-47cf-adef-991998030dd2)","FullInfo":"@Guid(939731b2-152e-47cf-adef-991998030dd2)","InfoMap":{"$id":"8927","FullIdObj":{"$id":"8928","$type":"IdentificableText","Name":"@Guid(939731b2-152e-47cf-adef-991998030dd2)","FullInfo":"@Guid(939731b2-152e-47cf-adef-991998030dd2)","TypeResolved":""}},"FullIdObj":{"$ref":"8928"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(939731b2-152e-47cf-adef-991998030dd2)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(939731b2-152e-47cf-adef-991998030dd2)"}],"TagAnnotations":[],"_text":"AddMTUsToWorkOrderOperationActualMaterialV2","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AddMTUsToWorkOrderOperationActualMaterialV