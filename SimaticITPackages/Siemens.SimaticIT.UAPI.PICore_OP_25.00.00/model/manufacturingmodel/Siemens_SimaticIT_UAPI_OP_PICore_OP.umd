":{"$id":"10585","$type":"DslTerminalNode","Text":"The primary key identifier of the Actual Equipment to be deleted.","FullInfo":"The primary key identifier of the Actual Equipment to be deleted.","InfoMap":{"$id":"10586","FullIdObj":{"$id":"10587","$type":"IdentificableText","Name":"The primary key identifier of the Actual Equipment to be deleted.","FullInfo":"The primary key identifier of the Actual Equipment to be deleted.","TypeResolved":""}},"FullIdObj":{"$ref":"10587"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"The primary key identifier of the Actual Equipment to be deleted.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"The primary key identifier of the Actual Equipment to be deleted."},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Id","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Id"},{"$id":"10588","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"10589","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"10590","$type":"DslTerminalNode","Text":"Guid","FullInfo":"Guid","InfoMap":{"$id":"10591","FullIdObj":{"$id":"10592","$type":"IdentificableTypeSystem","Name":"Guid","FullInfo":"Guid","TypeResolved":""}},"FullIdObj":{"$ref":"10592"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":1520,"CharPositionInLine":10,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Input declaration commands","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"10593","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"10594","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"10595","$type":"DslTerminalNode","Text":"AddWorkOrderOperationActualMaterialsByMaterialRequirements","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationActualMaterialsByMaterialRequirements","InfoMap":{"$id":"10596","FullIdObj":{"$id":"10597","$type":"IdentificableObject","Guid":"8702dce5-97a0-4adf-89a3-73a1e92a7db1","Name":"AddWorkOrderOperationActualMaterialsByMaterialRequirements","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationActualMaterialsByMaterialRequirements","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"4804"}}},"FullIdObj":{"$ref":"10597"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"4801"},"Documentation":{"$id":"10598","$type":"DslTerminalNode","Text":"Associates, to the specified Work Order Operation, the list of Actual Materials that will be used during its execution, based on the Material Requirements already associated to the same Work Order Operation.\r\nAbout the Work Order Operation, the command checks:\r\n1. if it exists, if not error 10300 is returned;\r\n2. if it is not Frozen, if not error 10992 is returned.\r\nIf there are any Material Requirements, it checks if there are already Actual Materials related to the given Work Order Operation :\r\n1. if there are none, it calls the subcommand AddWorkOrderOperationActualMaterialWithMTUs;\r\n2. if there are some, it calls the subcommand AddMTUsToWorkOrderOperationActualMaterialV2. \r\nIf it fails, an error is returned by the involved subcommand.","FullInfo":"Associates, to the specified Work Order Operation, the list of Actual Materials that will be used during its execution, based on the Material Requirements already associated to the same Work Order Operation.\r\nAbout the Work Order Operation, the command checks:\r\n1. if it exists, if not error 10300 is returned;\r\n2. if it is not Frozen, if not error 10992 is returned.\r\nIf there are any Material Requirements, it checks if there are already Actual Materials related to the given Work Order Operation :\r\n1. if there are none, it calls the subcommand AddWorkOrderOperationActualMaterialWithMTUs;\r\n2. if there are some, it calls the subcommand AddMTUsToWorkOrderOperationActualMaterialV2. \r\nIf it fails, an error is returned by the involved subcommand.","InfoMap":{"$id":"10599","FullIdObj":{"$id":"10600","$type":"IdentificableText","Name":"Associates, to the specified Work Order Operation, the list of Actual Materials that will be used during its execution, based on the Material Requirements already associated to the same Work Order Operation.\r\nAbout the Work Order Operation, the command checks:\r\n1. if it exists, if not error 10300 is returned;\r\n2. if it is not Frozen, if not error 10992 is returned.\r\nIf there are any Material Requirements, it checks if there are already Actual Materials related to the given Work Order Operation :\r\n1. if there are none, it calls the subcommand AddWorkOrderOperationActualMaterialWithMTUs;\r\n2. if there are some, it calls the subcommand AddMTUsToWorkOrderOperationActualMaterialV2. \r\nIf it fails, an error is returned by the involved subcommand.","FullInfo":"Associates, to the specified Work Order Operation, the list of Actual Materials that will be used during its execution, based on the Material Requirements already associated to the same Work Order Operation.\r\nAbout the Work Order Operation, the command checks:\r\n1. if it exists, if not error 10300 is returned;\r\n2. if it is not Frozen, if not error 10992 is returned.\r\nIf there are any Material Requirements, it checks if there are already Actual Materials related to the given Work Order Operation :\r\n1. if there are none, it calls the subcommand AddWorkOrderOperationActualMaterialWithMTUs;\r\n2. if there are some, it calls the subcommand AddMTUsToWorkOrderOperationActualMaterialV2. \r\nIf it fails, an error is returned by the involved subcommand.","TypeResolved":""}},"FullIdObj":{"$ref":"10600"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Associates, to the specified Work Order Operation, the list of Actual Materials that will be used during its execution, based on the Material Requirements already associated to the same Work Order Operation.\r\nAbout the Work Order Operation, the command checks:\r\n1. if it exists, if not error 10300 is returned;\r\n2. if it is not Frozen, if not error 10992 is returned.\r\nIf there are any Material Requirements, it checks if there are already Actual Materials related to the given Work Order Operation :\r\n1. if there are none, it calls the subcommand AddWorkOrderOperationActualMaterialWithMTUs;\r\n2. if there are some, it calls the subcommand AddMTUsToWorkOrderOperationActualMaterialV2. \r\nIf it fails, an error is returned by the involved subcommand.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Associates, to the specified Work Order Operation, the list of Actual Materials that will be used during its execution, based on the Material Requirements already associated to the same Work Order Operation.\r\nAbout the Work Order Operation, the command checks:\r\n1. if it exists, if not error 10300 is returned;\r\n2. if it is not Frozen, if not error 10992 is returned.\r\nIf there are any Material Requirements, it checks if there are already Actual Materials related to the given Work Order Operation :\r\n1. if there are none, it calls the subcommand AddWorkOrderOperationActualMaterialWithMTUs;\r\n2. if there are some, it calls the subcommand AddMTUsToWorkOrderOperationActualMaterialV2. \r\nIf it fails, an error is returned by the involved subcommand."},"SystemAnnotations":[{"$id":"10601","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"10602","$type":"DslTerminalNode","Text":"@Guid(8702dce5-97a0-4adf-89a3-73a1e92a7db1)","FullInfo":"@Guid(8702dce5-97a0-4adf-89a3-73a1e92a7db1)","InfoMap":{"$id":"10603","FullIdObj":{"$id":"10604","$type":"IdentificableText","Name":"@Guid(8702dce5-97a0-4adf-89a3-73a1e92a7db1)","FullInfo":"@Guid(8702dce5-97a0-4adf-89a3-73a1e92a7db1)","TypeResolved":""}},"FullIdObj":{"$ref":"10604"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(8702dce5-97a0-4adf-89a3-73a1e92a7db1)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(8702dce5-97a0-4adf-89a3-73a1e92a7db1)"}],"TagAnnotations":[],"_text":"AddWorkOrderOperationActualMaterialsByMaterialRequirements","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AddWorkOrderOperationActualMaterialsByMaterialRequirements"},{"$id":"10605","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"10606","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"10607","$type":"DslCommandPropertyCollectionTree","Name":"InputProperties","ScriptInfo":{"$ref":"4801"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"ChildrenList":[{"$id":"10608","$type":"DslCommandProperty