<?xml version="1.0" encoding="utf-8" ?>
<!-- This file is used to define Application Log messages. You should follow below instructions while defining messages: 
    - The <message> structure should be repeated for each Application Log message.
    - The <id> attribute is mandatory and should be unique in this file.
    - The <short> attribute represents the short text message and should be less than or up to 100 characters.
    - The <long> attribute represents the long text message and should be less than or up to 400 characters.
    - The <level> attribute is mandatory and its value should be one of: Verbose | Error | Warning | Critical | Informational.
    - The <param> structure should be repeated for each parameter of the Application Log message.
    - The <key> attribute represents the unique identifier for a parameter that repeats multiple times in the message text.
    - The <type> attribute represents the datatype of the parameter and its value should be one of the primitive types: string | byte | int | decimal | float | double | long | boolean | Guid | Datetime | Timespan.  -->
<messages>
  <message>
	<id>-10320</id>
	<short>Task can't be updated.</short>
	<long>Batch %BatchName% with BatchId %TaskNId% can't be updated due to the following reason: %ErrorMessage%.</long>
	<level>Error</level>
	<params>
	<param>
		<key>Id</key>
		<type>Guid</type>
	</param>
	<param>
		<key>BatchName</key>
		<type>string</type>
	</param>
	<param>
		<key>ErrorMessage</key>
		<type>string</type>
	</param>
	<param>
		<key>TaskNId</key>
		<type>string</type>
	</param>
	<param>
		<key>EquipmentNId</key>
		<type>string</type>
	</param>
	<param>
		<key>WorkOrderNId</key>
		<type>string</type>
	</param>
	<param>
		<key>WorkOrderOperationNId</key>
		<type>string</type>
	</param>
	</params>
  </message>
</messages>

