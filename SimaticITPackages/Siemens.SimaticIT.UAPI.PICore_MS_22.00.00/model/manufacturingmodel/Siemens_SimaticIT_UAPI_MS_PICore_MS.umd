"FullIdObj":{"$ref":"9940"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":1113,"CharPositionInLine":41,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Output declaration commands","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"9941","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"9942","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"9943","$type":"DslTerminalNode","Text":"AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefinition","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefinition","InfoMap":{"$id":"9944","FullIdObj":{"$id":"9945","$type":"IdentificableObject","Guid":"0b8d8898-02e4-4186-bf9a-2f3c820ba37b","Name":"AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefinition","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefinition","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"5776"}}},"FullIdObj":{"$ref":"9945"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"5773"},"Documentation":{"$id":"9946","$type":"DslTerminalNode","Text":"Adds a set of Parameter Specifications to a Work Master Operation by copying all the Parameters of a Process Definition.\r\nThis command creates one Parameter Specification per Process Definition Parameter except if this Process Definition Parameter resulted from being imported from a Catalog Parameter, see the description of the sub-command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition.\r\nThe command checks: \r\n1. if the given Process Definition with the given Process Definition Revision exists, if not error 10811 is returned;\r\n2. if there is a Revision set as current for the given Process Definition (when the Revision of the Process Definition is empty), if not error 10889 is returned;\r\n3. if the Process Definition has at least one Parameter, if not error 10897 is returned.\r\nIf the sub command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition fails to execute, this command will return it.","FullInfo":"Adds a set of Parameter Specifications to a Work Master Operation by copying all the Parameters of a Process Definition.\r\nThis command creates one Parameter Specification per Process Definition Parameter except if this Process Definition Parameter resulted from being imported from a Catalog Parameter, see the description of the sub-command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition.\r\nThe command checks: \r\n1. if the given Process Definition with the given Process Definition Revision exists, if not error 10811 is returned;\r\n2. if there is a Revision set as current for the given Process Definition (when the Revision of the Process Definition is empty), if not error 10889 is returned;\r\n3. if the Process Definition has at least one Parameter, if not error 10897 is returned.\r\nIf the sub command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition fails to execute, this command will return it.","InfoMap":{"$id":"9947","FullIdObj":{"$id":"9948","$type":"IdentificableText","Name":"Adds a set of Parameter Specifications to a Work Master Operation by copying all the Parameters of a Process Definition.\r\nThis command creates one Parameter Specification per Process Definition Parameter except if this Process Definition Parameter resulted from being imported from a Catalog Parameter, see the description of the sub-command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition.\r\nThe command checks: \r\n1. if the given Process Definition with the given Process Definition Revision exists, if not error 10811 is returned;\r\n2. if there is a Revision set as current for the given Process Definition (when the Revision of the Process Definition is empty), if not error 10889 is returned;\r\n3. if the Process Definition has at least one Parameter, if not error 10897 is returned.\r\nIf the sub command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition fails to execute, this command will return it.","FullInfo":"Adds a set of Parameter Specifications to a Work Master Operation by copying all the Parameters of a Process Definition.\r\nThis command creates one Parameter Specification per Process Definition Parameter except if this Process Definition Parameter resulted from being imported from a Catalog Parameter, see the description of the sub-command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition.\r\nThe command checks: \r\n1. if the given Process Definition with the given Process Definition Revision exists, if not error 10811 is returned;\r\n2. if there is a Revision set as current for the given Process Definition (when the Revision of the Process Definition is empty), if not error 10889 is returned;\r\n3. if the Process Definition has at least one Parameter, if not error 10897 is returned.\r\nIf the sub command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition fails to execute, this command will return it.","TypeResolved":""}},"FullIdObj":{"$ref":"9948"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Adds a set of Parameter Specifications to a Work Master Operation by copying all the Parameters of a Process Definition.\r\nThis command creates one Parameter Specification per Process Definition Parameter except if this Process Definition Parameter resulted from being imported from a Catalog Parameter, see the description of the sub-command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition.\r\nThe command checks: \r\n1. if the given Process Definition with the given Process Definition Revision exists, if not error 10811 is returned;\r\n2. if there is a Revision set as current for the given Process Definition (when the Revision of the Process Definition is empty), if not error 10889 is returned;\r\n3. if the Process Definition has at least one Parameter, if not error 10897 is returned.\r\nIf the sub command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition fails to execute, this command will return it.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Adds a set of Parameter Specifications to a Work Master Operation by copying all the Parameters of a Process Definition.\r\nThis command creates one Parameter Specification per Process Definition Parameter except if this Process Definition Parameter resulted from being imported from a Catalog Parameter, see the description of the sub-command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition.\r\nThe command checks: \r\n1. if the given Process Definition with the given Process Definition Revision exists, if not error 10811 is returned;\r\n2. if there is a Revision set as current for the given Process Definition (when the Revision of the Process Definition is empty), if not error 10889 is returned;\r\n3. if the Process Definition has at least one Parameter, if not error 10897 is returned.\r\nIf the sub command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition fails to execute, this command will return it."},"SystemAnnotations":[{"$id":"9949","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"9950","$type":"DslTerminalNode","Text":"@Guid(0b8d8898-02e4-4186-bf9a-2f3c820ba37b)","FullInfo":"@Guid(0b8d8898-02e4-4186-bf9a-2f3c820ba37b)","InfoMap":{"$id":"9951","FullIdObj":{"$id":"9952","$type":"IdentificableText","Name":"@Guid(0b8d8898-02e4-4186-bf9a-2f3c820ba37b)","FullInfo":"@Guid(0b8d8898-02e4-4186-bf9a-2f3c820ba37b)","TypeResolved":""}},"FullIdObj":{"$ref":"9952"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(0b8d8898-02e4-4186-bf9a-2f3c820ba37b)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(0b8d8898-02e4-4186-bf9a-2f3c820ba37b)"}],"TagAnnotations":[],"_text":"AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefinition","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefinition"},{"$id":"9953","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"9954","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"9955","$type":"DslCommandPropertyCollectionTree","Name":"InputProperties","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"ChildrenList":[{"$id":"9956","$type":"DslCommandPropertyTree","Children":[{"$id":"9957","$type":"DslTerminalNode","Text":"WorkMasterOperationId","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefin