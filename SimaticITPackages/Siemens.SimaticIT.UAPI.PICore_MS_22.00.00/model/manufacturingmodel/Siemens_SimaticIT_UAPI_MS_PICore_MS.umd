,"_parentObject":{"$ref":"4843"}}},"FullIdObj":{"$ref":"5040"},"Children":[],"Name":"PropertyName","ScriptInfo":{"$ref":"3094"},"Documentation":{"$id":"5041","$type":"DslTerminalNode","Text":"If TRUE, the operations, added to the Work Master, by default, are available as Template. This means that the Work Master Operations, together with their specifications, can be added to another Work Master or, at runtime, to a Work Order even if it has not been generated starting from the Work Master you are currently configuring.","FullInfo":"If TRUE, the operations, added to the Work Master, by default, are available as Template. This means that the Work Master Operations, together with their specifications, can be added to another Work Master or, at runtime, to a Work Order even if it has not been generated starting from the Work Master you are currently configuring.","InfoMap":{"$id":"5042","FullIdObj":{"$id":"5043","$type":"IdentificableText","Name":"If TRUE, the operations, added to the Work Master, by default, are available as Template. This means that the Work Master Operations, together with their specifications, can be added to another Work Master or, at runtime, to a Work Order even if it has not been generated starting from the Work Master you are currently configuring.","FullInfo":"If TRUE, the operations, added to the Work Master, by default, are available as Template. This means that the Work Master Operations, together with their specifications, can be added to another Work Master or, at runtime, to a Work Order even if it has not been generated starting from the Work Master you are currently configuring.","TypeResolved":""}},"FullIdObj":{"$ref":"5043"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"If TRUE, the operations, added to the Work Master, by default, are available as Template. This means that the Work Master Operations, together with their specifications, can be added to another Work Master or, at runtime, to a Work Order even if it has not been generated starting from the Work Master you are currently configuring.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"If TRUE, the operations, added to the Work Master, by default, are available as Template. This means that the Work Master Operations, together with their specifications, can be added to another Work Master or, at runtime, to a Work Order even if it has not been generated starting from the Work Master you are currently configuring."},"SystemAnnotations":[{"$id":"5044","$type":"DslKeywordNode","Text":"Optional","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"3094"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Optional","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Optional"}],"CustomAnnotations":[{"$id":"5045","$type":"DslTerminalNode","Text":"@Guid(7b96800d-12c4-4a0b-8445-b7d556bbee77)","FullInfo":"@Guid(7b96800d-12c4-4a0b-8445-b7d556bbee77)","InfoMap":{"$id":"5046","FullIdObj":{"$id":"5047","$type":"IdentificableText","Name":"@Guid(7b96800d-12c4-4a0b-8445-b7d556bbee77)","FullInfo":"@Guid(7b96800d-12c4-4a0b-8445-b7d556bbee77)","TypeResolved":""}},"FullIdObj":{"$ref":"5047"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"3094"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(7b96800d-12c4-4a0b-8445-b7d556bbee77)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(7b96800d-12c4-4a0b-8445-b7d556bbee77)"}],"TagAnnotations":[],"_text":"WorkMasterParameterType.AvailableAsTemplate","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WorkMasterParameterType.AvailableAsTemplate"},{"$id":"5048","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"3094"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"5049","$type":"DslParameterTypePropertyTypeTree","Children":[{"$id":"5050","$type":"DslTerminalNo