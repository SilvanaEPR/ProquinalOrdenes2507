"9026","$type":"IdentificableObject","Guid":"c7c53342-3484-41f9-af5d-3626e2423eb0","Name":"UpdateWorkMasterOperation","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.UpdateWorkMasterOperation","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"5776"}}},"FullIdObj":{"$ref":"9026"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"5773"},"Documentation":{"$id":"9027","$type":"DslTerminalNode","Text":"Updates an existing instance of a Work Master Operation with the specified input. Fields with Null value will not be updated.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: The Work Master Operation specified in input does not exist.\r\nThe command may return the following error codes, during its execution:\r\n* Error -10813: The WorkMaster with the specified NId and Revision is locked and cannot be edited.\r\n* Error -11314: The Estimated Duration of the Operation cannot be negative.\r\n* Error -10301: The piece of Equipment with the specified NId already exists.\r\n\r\n","FullInfo":"Updates an existing instance of a Work Master Operation with the specified input. Fields with Null value will not be updated.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: The Work Master Operation specified in input does not exist.\r\nThe command may return the following error codes, during its execution:\r\n* Error -10813: The WorkMaster with the specified NId and Revision is locked and cannot be edited.\r\n* Error -11314: The Estimated Duration of the Operation cannot be negative.\r\n* Error -10301: The piece of Equipment with the specified NId already exists.\r\n\r\n","InfoMap":{"$id":"9028","FullIdObj":{"$id":"9029","$type":"IdentificableText","Name":"Updates an existing instance of a Work Master Operation with the specified input. Fields with Null value will not be updated.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: The Work Master Operation specified in input does not exist.\r\nThe command may return the following error codes, during its execution:\r\n* Error -10813: The WorkMaster with the specified NId and Revision is locked and cannot be edited.\r\n* Error -11314: The Estimated Duration of the Operation cannot be negative.\r\n* Error -10301: The piece of Equipment with the specified NId already exists.\r\n\r\n","FullInfo":"Updates an existing instance of a Work Master Operation with the specified input. Fields with Null value will not be updated.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: The Work Master Operation specified in input does not exist.\r\nThe command may return the following error codes, during its execution:\r\n* Error -10813: The WorkMaster with the specified NId and Revision is locked and cannot be edited.\r\n* Error -11314: The Estimated Duration of the Operation cannot be negative.\r\n* Error -10301: The piece of Equipment with the specified NId already exists.\r\n\r\n","TypeResolved":""}},"FullIdObj":{"$ref":"9029"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Updates an existing instance of a Work Master Operation with the specified input. Fields with Null value will not be updated.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: The Work Master Operation specified in input does not exist.\r\nThe command may return the following error codes, during its execution:\r\n* Error -10813: The WorkMaster with the specified NId and Revision is locked and cannot be edited.\r\n* Error -11314: The Estimated Duration of the Operation cannot be negative.\r\n* Error -10301: The piece of Equipment with the specified NId already exists.\r\n\r\n","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Updates an existing instance of a Work Master Operation with the specified input. Fields with Null value will not be updated.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: The Work Master Operation specified in input does not exist.\r\nThe command may return the following error codes, during its execution:\r\n* Error -10813: The WorkMaster with the specified NId and Revision is locked and cannot be edited.\r\n* Error -11314: The Estimated Duration of the Operation cannot be negative.\r\n* Error -10301: The piece of Equipment with the specified NId already exists.\r\n\r\n"},"SystemAnnotations":[{"$id":"9030","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"9031","$type":"DslTerminalNode","Text":"@Guid(c7c53342-3484-41f9-af5d-3626e2423eb0)","FullInfo":"@Guid(c7c53342-3484-41f9-af5d-3626e2423eb0)","InfoMap":{"$id":"9032","FullIdObj":{"$id":"9033","$type":"IdentificableText","Name":"@Guid(c7c53342-3484-41f9-af5d-3626e2423eb0)","FullInfo":"@Guid(c7c53342-3484-41f9-af5d-3626e2423eb0)","TypeResolved":""}},"FullIdObj":{"$ref":"9033"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(c7c53342-3484-41f9-af5d-3626e2423eb0)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(c7c53342-3484-41f9-af5d-3626e2423eb0)"}],"TagAnnotations":[],"_text":"UpdateWorkMasterOperation","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"UpdateWorkMasterOperation"},{"$id":"9034","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"9035","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"