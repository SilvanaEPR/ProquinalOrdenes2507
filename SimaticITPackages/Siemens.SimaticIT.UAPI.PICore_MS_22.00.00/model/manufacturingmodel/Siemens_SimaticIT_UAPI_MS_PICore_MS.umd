67fe9ce","SourceName":"T:\\PI_AG002\\_work\\104\\s\\SRC\\PI\\Core\\PICore_MS\\PICore_MS\\PICore_MS.MSModel\\Model\\Command\\Command.ul"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"IN","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"IN"},{"$id":"5774","$type":"DslTerminalNode","Text":"Commands","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands","InfoMap":{"$id":"5775","FullIdObj":{"$id":"5776","$type":"IdentificableDomain","Guid":"f9202b41-a957-4f79-addb-d26cb079fde4","Name":"Commands","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands","ServiceKind":4,"TypeResolved":"","SubDomainGuids":{"$id":"5777"},"_project":{"$ref":"12"}}},"FullIdObj":{"$ref":"5776"},"Children":[],"Name":"Domain","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Commands","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Commands"},{"$id":"5778","$type":"DslKeywordNode","Text":"OVER","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"OVER","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"OVER"},{"$id":"5779","$type":"DslTerminalNode","Text":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel","InfoMap":{"$id":"5780","FullIdObj":{"$id":"5781","$type":"IdentificableText","Name":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel","TypeResolved":""}},"FullIdObj":{"$ref":"5781"},"Children":[],"Name":"ParentDomain","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel"}],"Name":"DomainDeclaration","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"Header","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":1},{"$id":"5782","$type":"DslCommandDeclarationCollectionTree","Name":"CommandCollection","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":13,"ChildrenList":[{"$id":"5783","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"5784","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"5785","$type":"DslTerminalNode","Text":"CreateCatalogueParameter","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.CreateCatalogueParameter","InfoMap":{"$id":"5786","FullIdObj":{"$id":"5787","$type":"IdentificableObject","Guid":"cb848583-ba2c-47fd-9457-88bb9e02cdc8","Name":"CreateCatalogueParameter","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.CreateCatalogueParameter","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"5776"}}},"FullIdObj":{"$ref":"5787"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"5773"},"Documentation":{"$id":"5788","$type":"DslTerminalNode","Text":"Creates a new instance of a catalog parameter.\r\nYou should specify the Unit of Measure of the Parameter you are defining only if you set ParameterType to Quantity. Choosing another ParameterType and setting the ParameterUoMNId value could lead to inconsistencies when the parameter is imported as Process Definition Parameter from catalog.\r\nChecks if the given ParameterNId exists, otherwise throws the error 10801. If it exists, it verifies that there is only one respective catalog parameter, otherwise it throws the error 10802.\r\nIf the value of ParameterType is \"Quantity\", it verifies that there is a Unit of Measure; otherwise it throws the error 10007.\r\nChecks if the given ParameterUoMNId exists, otherwise it throws the error 10803.\r\nChecks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835. \r\nIf the given ProcessDefinitionNId isn't null or empty, checks if it exists, otherwise it throws the error 11210.\r\nIf the given ProcessDefinitionRevision isn't null or empty, the command controls that this value exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.","FullInfo":"Creates a new instance of a catalog parameter.\r\nYou should specify the Unit of Measure of the Parameter you are defining only if you set ParameterType to Quantity. Choosing another ParameterType and setting the ParameterUoMNId value could lead to inconsistencies when the parameter is imported as Process Definition Parameter from catalog.\r\nChecks if the given ParameterNId exists, otherwise throws the error 10801. If it exists, it verifies that there is only one respective catalog parameter, otherwise it throws the error 10802.\r\nIf the value of ParameterType is \"Quantity\", it verifies that there is a Unit of Measure; otherwise it throws the error 10007.\r\nChecks if the given ParameterUoMNId exists, otherwise it throws the error 10803.\r\nChecks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835. \r\nIf the given ProcessDefinitionNId isn't null or empty, checks if it exists, otherwise it throws the error 11210.\r\nIf the given ProcessDefinitionRevision isn't null or empty, the command controls that this value exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.","InfoMap":{"$id":"5789","FullIdObj":{"$id":"5790",