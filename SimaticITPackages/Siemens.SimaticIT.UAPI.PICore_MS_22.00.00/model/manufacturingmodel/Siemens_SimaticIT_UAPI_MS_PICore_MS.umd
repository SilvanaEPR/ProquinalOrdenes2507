ons":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"9354","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"9355","$type":"DslKeywordNode","Text":"list of","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"list of","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"list of"},{"$id":"9356","$type":"DslTerminalNode","Text":"Guid","FullInfo":"Guid","InfoMap":{"$id":"9357","FullIdObj":{"$id":"9358","$type":"IdentificableTypeSystem","Name":"Guid","FullInfo":"Guid","TypeResolved":""}},"FullIdObj":{"$ref":"9358"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":955,"CharPositionInLine":40,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Output declaration commands","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"9359","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"9360","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"9361","$type":"DslTerminalNode","Text":"AddParameterSpecificationsToWorkMasterOperationFromCatalog","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddParameterSpecificationsToWorkMasterOperationFromCatalog","InfoMap":{"$id":"9362","FullIdObj":{"$id":"9363","$type":"IdentificableObject","Guid":"f82aaa81-9372-4ee9-a0ee-46d49428d9d7","Name":"AddParameterSpecificationsToWorkMasterOperationFromCatalog","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddParameterSpecificationsToWorkMasterOperationFromCatalog","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"5776"}}},"FullIdObj":{"$ref":"9363"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"5773"},"Documentation":{"$id":"9364","$type":"DslTerminalNode","Text":"Adds a set of Parameter Specifications to the Work Master Operation given as input, from a set of Catalog parameters.\r\nThe argument ParameterSpecifcations is a collection of ParameterSpecificationFromCatalog.\r\nThis Parameter Type has a property ParameterNId that is the natural identifier of a Catalog Parameter.\r\nThe Parameter Specifications can inherit the same property values than the respective Catalog Parameters. In which case, simply fill the ParameterNId of each element of ParameterSpecifcations list.\r\nIf you want to override a Catalaog Parameter property, fill the necessary property of the respective ParameterSpecificationFromCatalog element. \r\nChecks if the given WorkMasterOperationId exists, otherwise it throws the error 10300.\r\nChecks if the Work Master associated to the given Work Master Operation Parameter Specification is not locked, otherwise it throws the error 10813.\r\nThe command performs a serie of controls on thecontent of ParamerSpecifications. \r\nIf one control fails, the command is cancelled for all parameters: no Parameter Specificaiton will be added.\r\nFor each element of ParameterSpecifcations list:\r\n- Checks if the ParameterNId does not match with an existing Work Master Operation Parameter Specification, otherwise no parameter is added and it throws the error 10837.\r\n- Checks if the ParameterNId matches with an existing Catalog Parameter, otherwise it throws the error 10814.\r\n- Checks if the given ParameterUoMNId exists, otherwise it throws the error 11210.\r\n- Checks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835.\r\n- In case the given Process Definition is different from an already defined Process Definition of the Catalog Parameter, the command checks:\r\n- if the given ProcessDefinitionNId exists, otherwise it throws the error 11210;\r\n- if the given argument SetToUseCurrentRevisionOfProcessDefinition is set to true, the property ProcessDefinitionRevision of the to-be-created Parameter Specification will be deleted; if not and if you pass a Revision to override the Catalog Parameter property, then the command controls that the ProcessDefinitionRevision exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.","FullInfo":"Adds a set of Parameter Specifications to the Work Master Operation given as input, from a set of Catalog parameters.\r\nThe argument ParameterSpecifcations is a collection of ParameterSpecificationFromCatalog.\r\nThis Parameter Type has a property ParameterNId that is the natural identifier of a Catalog Parameter.\r\nThe Parameter Specifications can inherit the same property values than the respective Catalog Parameters. In which case, simply fill the ParameterNId of each element of ParameterSpecifcations list.\r\nIf you want to override a Catalaog Parameter property, fill the necessary property of the respective ParameterSpecificationFromCatalog element. \r\nChecks if the given WorkMasterOperationId exists, otherwise it throws the error 10300.\r\nChecks if the Work Master associated to the given Work Master Operation Parameter Specification is not locked, otherwise it throws the error 10813.\r\nThe command performs a serie of controls on thecontent of ParamerSpecifications. \r\nIf one control fails, the command is cancelled for all parameters: no Parameter Specificaiton will be added.\r\nFor each element of ParameterSpecifcations list:\r\n- Checks if the ParameterNId does not match with an existing Work Master Operation Parameter Specification, otherwise no parameter is added and it throws the error 10837.\r\n- Checks if the ParameterNId matches with an existing Catalog Parameter, otherwise it throws the error 10814.\r\n- Checks if the given ParameterUoMNId exists, otherwise it throws the error 11210.\r\n- Checks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835.\r\n- In case the given Process Definition is different from an already defined Process Definition of the Catalog Parameter, the command checks:\r\n- if the given ProcessDefinitionNId exists, otherwise it throws the error 11210;\r\n- if the given argument SetToUseCurrentRevisionOfProcessDefinition is set to true, the property ProcessDefinitionRevision of the to-be-created Parameter Specification will be deleted; if not and if you pass a Revision to override the Catalog Parameter property, then the command controls that the ProcessDefinitionRevision exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.","InfoMap":{"$id":"9365","FullIdObj":{"$id":"9366","$type":"IdentificableText","Name":"Adds a set of Parameter Specifications to the Work Master Operation given as input, from a set of Catalog parameters.\r\nThe argument ParameterSpecifcations is a collection of ParameterSpecificationFromCatalog.\r\nThis Parameter Type has a property ParameterNId that is the natural identifier of a Catalog Parameter.\r\nThe Parameter Specifications can inherit the same property values than the respective Catalog Parameters. In which case, simply fill the ParameterNId of each element of ParameterSpecifcations list.\r\nIf you want to override a Catalaog Parameter property, fill the necessary property of the respective ParameterSpecificationFromCatalog element. \r\nChecks if the given WorkMasterOperationId exists, otherwise it throws the error 10300.\r\nChecks if the Work Master associated to the given Work Master Operation Parameter Specification is not locked, otherwise it throws the error 10813.\r\nThe command performs a serie of controls on thecontent of ParamerSpecifications. \r\nIf one control fails, the command is cancelled for all parameters: no Parameter Specificaiton will be added.\r\nFor each element of ParameterSpecifcations list:\r\n- Checks if the ParameterNId does not match with an existing Work Master Operation Parameter Specification, otherwise no parameter is added and it throws the error 10837.\r\n- Checks if the ParameterNId matches with an existing Catalog Parameter, otherwise it throws the error 10814.\r\n- Checks if the given ParameterUoMNId exists, otherwise it throws the error 11210.\r\n- Checks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835.\r\n- In case the given Process Definition is different from an already defined Process Definition of the Catalog Parameter, the command checks:\r\n- if the given ProcessDefinitionNId exists, otherwise it throws the error 11210;\r\n- if the given argument SetToUseCurrentRevisionOfProcessDefinition is set to true, the property ProcessDefinitionRevision of the to-be-created Parameter Specification will be deleted; if not and if you pass a Revision to override the Catalog Parameter property, then the command controls that the ProcessDefinitionRevision exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.","FullInfo":"Adds a set of Parameter Specifications to the Work Master Operation given as input, from a set of Catalog parameters.\r\nThe argument ParameterSpecifcations is a collection of ParameterSpecificationFromCatalog.\r\nThis Parameter Type has a property ParameterNId that is the natural identifier of a Catalog Parameter.\r\nThe Parameter Specifications can inherit the same property values than the respective Catalog Parameters. In which case, simply fill the ParameterNId of each element of ParameterSpecifcations list.\r\nIf you want to override a Catalaog Parameter property, fill the necessary property of the respective ParameterSpecificationFromCatalog element. \r\nChecks if the given WorkMasterOperationId exists, otherwise it throws the error 10300.\r\nChecks if the Work Master associated to the given Work Master Operation Parameter Specification is not locked, otherwise it throws the error 10813.\r\nThe command performs a serie of controls on thecontent of ParamerSpecifications. \r\nIf one control fails, the command is cancelled for all parameters: no Parameter Specificaiton will be added.\r\nFor each element of ParameterSpecifcations list:\r\n- Checks if the ParameterNId does not match with an existing Work Master Operation Parameter Specification, otherwise no parameter is added and it throws the error 10837.\r\n- Checks if the ParameterNId matches with an existing Catalog Parameter, otherwise it throws the error 10814.\r\n- Checks if the given ParameterUoMNId exists, otherwise it throws the error 11210.\r\n- Checks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835.\r\n- In case the given Process Definition is different from an already defined Process Definition of the Catalog Parameter, the command checks:\r\n- if the given ProcessDefinitionNId exists, otherwise it throws the error 11210;\r\n- if the given argument SetToUseCurrentRevisionOfProcessDefinition is set to true, the property ProcessDefinitionRevision of the to-be-created Parameter Specification will be deleted; if not and if you pass a Revision to override the Catalog Parameter property, then the command controls that the ProcessDefinitionRevision exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.","TypeResolved":""}},"FullIdObj":{"$ref":"9366"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Adds a set of Parameter Specifications to the Work Master Operation given as input, from a set of Catalog parameters.\r\nThe argument ParameterSpecifcations is a collection of ParameterSpecificationFromCatalog.\r\nThis Parameter Type has a property ParameterNId that is the natural identifier of a Catalog Parameter.\r\nThe Parameter Specifications can inherit the same property values than the respective Catalog Parameters. In which case, simply fill the ParameterNId of each element of ParameterSpecifcations list.\r\nIf you want to override a Catalaog Parameter property, fill the necessary property of the respective ParameterSpecificationFromCatalog element. \r\nChecks if the given WorkMasterOperationId exists, otherwise it throws the error 10300.\r\nChecks if the Work Master associated to the given Work Master Operation Parameter Specification is not locked, otherwise it throws the error 10813.\r\nThe command performs a serie of controls on thecontent of ParamerSpecifications. \r\nIf one control fails, the command is cancelled for all parameters: no Parameter Specificaiton will be added.\r\nFor each element of ParameterSpecifcations list:\r\n- Checks if the ParameterNId does not match with an existing Work Master Operation Parameter Specification, otherwise no parameter is added and it throws the error 10837.\r\n- Checks if the ParameterNId matches with an existing Catalog Parameter, otherwise it throws the error 10814.\r\n- Checks if the given ParameterUoMNId exists, otherwise it throws the error 11210.\r\n- Checks if the given ParameterTargetValue, P