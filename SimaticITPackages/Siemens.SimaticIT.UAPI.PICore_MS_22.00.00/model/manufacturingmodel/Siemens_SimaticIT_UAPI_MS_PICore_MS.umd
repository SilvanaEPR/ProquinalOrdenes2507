n the previous Work Order Operation switches to the Status IsCompleted.  \r\nThe order of the Work Order Operations depend on the Sequence. \r\nSet to FALSE otherwise.","FullInfo":"Set to TRUE if you want that the Status of the Work Order Operations with first Sequence are automatically updated at runtime, according to the Status change of the respective Work Order, for the Statuses IsInProgress and IsCompleted.  \r\nIf there are more than one Work Order Operations and if they are configured with Execution Propagation set to True, each following Work Order Operations will automatically switch to the Status IsInProgress when the previous Work Order Operation switches to the Status IsCompleted.  \r\nThe order of the Work Order Operations depend on the Sequence. \r\nSet to FALSE otherwise.","InfoMap":{"$id":"10241","FullIdObj":{"$id":"10242","$type":"IdentificableText","Name":"Set to TRUE if you want that the Status of the Work Order Operations with first Sequence are automatically updated at runtime, according to the Status change of the respective Work Order, for the Statuses IsInProgress and IsCompleted.  \r\nIf there are more than one Work Order Operations and if they are configured with Execution Propagation set to True, each following Work Order Operations will automatically switch to the Status IsInProgress when the previous Work Order Operation switches to the Status IsCompleted.  \r\nThe order of the Work Order Operations depend on the Sequence. \r\nSet to FALSE otherwise.","FullInfo":"Set to TRUE if you want that the Status of the Work Order Operations with first Sequence are automatically updated at runtime, according to the Status change of the respective Work Order, for the Statuses IsInProgress and IsCompleted.  \r\nIf there are more than one Work Order Operations and if they are configured with Execution Propagation set to True, each following Work Order Operations will automatically switch to the Status IsInProgress when the previous Work Order Operation switches to the Status IsCompleted.  \r\nThe order of the Work Order Operations depend on the Sequence. \r\nSet to FALSE otherwise.","TypeResolved":""}},"FullIdObj":{"$ref":"10242"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Set to TRUE if you want that the Status of the Work Order Operations with first Sequence are automatically updated at runtime, according to the Status change of the respective Work Order, for the Statuses IsInProgress and IsCompleted.  \r\nIf there are more than one Work Order Operations and if they are configured with Execution Propagation set to True, each following Work Order Operations will automatically switch to the Status IsInProgress when the previous Work Order Operation switches to the Status IsCompleted.  \r\nThe order of the Work Order Operations depend on the Sequence. \r\nSet to FALSE otherwise.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Set to TRUE if you want that the Status of the Work Order Operations with first Sequence are automatically updated at runtime, according to the Status change of the respective Work Order, for the Statuses IsInProgress and IsCompleted.  \r\nIf there are more than one Work Order Operations and if they are configured with Execution Propagation set to True, each following Work Order Operations will automatically switch to the Status IsInProgress when the previous Work Order Operation switches to the Status IsCompleted.  \r\nThe order of the Work Order Operations depend on the Sequence. \r\nSet to FALSE otherwise."},"SystemAnnotations":[{"$id":"10243","$type":"DslKeywordNode","Text":"Optional","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Optional","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Optional"}],"CustomAnnotations":[],"TagAnnotations":[],"_text":"IsInExecutionPropagation","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"IsInExecutionPropagation"},{"$id":"10244","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"10245","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"10246","$type":"DslTerminalNode","Text":"bool","FullInfo":"Boolean","InfoMap":{"$id":"10247","FullIdObj":{"$id":"10248","$type":"IdentificableTypeSystem","Name":"bool","FullInfo":"Boolean","TypeResolved":""}},"FullIdObj":{"$ref":"10248"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":1198,"CharPositionInLine":32,"_text":"bool","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"bool"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"10249","$type":"DslCommandPropertyTree","Children":[{"$id":"10250","$type":"DslTerminalNode","Text":"IsPlannable","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddWorkMasterOperationFromWorkMasterOperation.IsPlannable","InfoMap":{"$id":"10251","FullIdObj":{"$id":"10252","$type":"IdentificableFakeProperty","Name":"IsPlannable","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddWorkMasterOperationFromWorkMasterOperation.IsPlannable","ContainerFullInfo":"Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddWorkMasterOperationFromWorkMasterOperation","TypeResolved":""}},"FullIdObj":{"$ref":"10252"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"5773"},"Documentation":{"$id":"10253","$type":"DslTerminalNode","Text":"Set to TRUE to indicate that the Work Master Operation, that you are adding, can be planned by an advanced planning system. ","FullI