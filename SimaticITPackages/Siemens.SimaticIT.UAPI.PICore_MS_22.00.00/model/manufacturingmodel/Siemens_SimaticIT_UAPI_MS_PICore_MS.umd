ork Master or, at runtime, to a Work Order even if it has not been generated starting from the Work Master you are currently configuring. FALSE otherwise.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"TRUE if you want the operations, added to the Work Master, to be, by default, available as Template. This means that the Work Master Operations, together with their specifications, can be added to another Work Master or, at runtime, to a Work Order even if it has not been generated starting from the Work Master you are currently configuring. FALSE otherwise."},"SystemAnnotations":[{"$id":"8434","$type":"DslKeywordNode","Text":"Optional","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Optional","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Optional"}],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AvailableAsTemplate","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AvailableAsTemplate"},{"$id":"8435","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"8436","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"8437","$type":"DslTerminalNode","Text":"bool","FullInfo":"Boolean","InfoMap":{"$id":"8438","FullIdObj":{"$id":"8439","$type":"IdentificableTypeSystem","Name":"bool","FullInfo":"Boolean","TypeResolved":""}},"FullIdObj":{"$ref":"8439"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":704,"CharPositionInLine":27,"_text":"bool","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"bool"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"5773"},"SystemAnnotations":[],"CustomAnnotations"