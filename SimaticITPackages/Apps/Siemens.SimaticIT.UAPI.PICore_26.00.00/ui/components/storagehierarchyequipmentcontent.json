{
  "manifestVersion": "02.00.00",
  "uiComponent": {
    "identity": {
      "name": "storagehierarchyequipmentcontent",
      "version": "1.0.0",
      "title": "Display Storage Hierarchy Equipment Details",
      "source": "storagehierarchyequipmentcontent",
      "dependencies": []
    },
    "metadata": {
      "description": "Display Storage Hierarchy Equipment Details",
      "icon": "sit sit-pi-material-storage-details",
      "image": "data:image/png;base64,",
      "size": {
        "default": {
          "rows": 6,
          "columns": 6
        },
        "min": {
          "rows": 1,
          "columns": 1
        },
        "max": {
          "rows": 12,
          "columns": 12
        }
      }
    },
    "contracts": {
      "api": {
        "methods": {
          "setStorageHierarchyEquipmentContext": {
            "description": "Sets the parameters used to retrieve the details of the selected Storage Hierarchy Equipment",
            "parameters": {
              "storageHierarchyId": {
                "type": "string"
              },
              "equipmentId": {
                "type": "string"
              }
            }
          }
        },
        "events": {
          "onMtuSelected": {
            "description": "Raised when a Material Tracking Unit is selected from the list.",
            "arguments": {
              "mtuNId": {
                "type": "string"
              }
            }
          },
          "onMaterialLotSelected": {
            "description": "Raised when a Material Lot is selected from the list.",
            "arguments": {
              "materialLotNId": {
                "type": "string"
              }
            }
          },
          "onMaterialSelected": {
            "description": "Raised when a Material is selected from the list.",
            "arguments": {
              "materialNId": {
                "type": "string"
              }
            }
          }
        }
      },
      "dpc": {}
    }
  }
}
