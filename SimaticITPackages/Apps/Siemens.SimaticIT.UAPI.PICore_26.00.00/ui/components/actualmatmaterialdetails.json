{
  "manifestVersion": "02.00.00",
  "uiComponent": {
    "identity": {
      "name": "actualmatmaterialdetails",
      "version": "1.0.0",
      "title": "Actual Material Details",
      "source": "actualmatmaterialdetails",
      "dependencies": []
    },
    "metadata": {
      "description": "Display Actual Material Details",
      "icon": "sit sit-pi-work-order-operation-material-list",
      "image": "data:image/png;base64,",
      "size": {
        "default": {
          "rows": 6,
          "columns": 6
        },
        "min": {
          "rows": 1,
          "columns": 1
        },
        "max": {
          "rows": 12,
          "columns": 12
        }
      }
    },
    "contracts": {
      "api": {
        "methods": {
          "setWorkOrderOperationMaterialRequirementId": {
            "description": "Sets the Work Order Operation Material Requirement for which the details are to be displayed.",
            "parameters": {
              "workOrderOperationMaterialRequirementId": {
                "type": "string"
              }
            }
          },
          "enableCloseButton": {
            "description": "Sets the visibility of the Close button.",
            "parameters": {
              "isCloseButtonEnabled": {
                "type": "Boolean"
              }
            }
          },
          "setTargetStates": {
            "description": "Sets the strings (that is, the module state) that will be used to navigate to another module state.",
            "parameters": {
              "backStateId": {
                "type": "string"
              }
            }
          },
          "setActionBarVisibility": {
            "description": "Sets the visibility of the action bar in the list of Required Material Details.",
            "parameters": {
              "isActionBarVisible": {
                "type": "Boolean"
              }
            }
          }
        },
        "events": {
          "onClose": {
            "description": "Raised upon clicking the Close button.",
            "arguments": {
              "targetStateId": {
                "type": "string"
              },
              "workOrderOperationId": {
                "type": "string"
              },
              "workOrderId": {
                "type": "string"
              }
            }
          }
        }
      },
      "dpc": {}
    }
  }
}
