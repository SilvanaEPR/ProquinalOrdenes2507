    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.UpdateWorkOrderExtendedV2",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.UpdateWorkOrderExtendedV2",
      "Description": "Resets and/or Updates one or more editable properties of a Work Order and its Work Order Extended. The command resets a property when it has been modified to empty and updates a property when it has been modified to a new value.\r\nThe command may return the following error codes, during its execution:\r\n* -10934: The Work Order has not been found.\r\n* -10992: The Work Order is frozen.\r\n* -11311: Planned Start Time cannot be equal to or later than the Planned End Time.\r\n* -10979: Actual Start Time cannot be equal to or later than the Actual End Time.\r\n* -10807: The Material does not exist.\r\n* -10855: No Material is set as current.\r\n* -10002: Not compatible unit of measures.\r\n* -10957: There is no Operation referencing a current Operation.\r\n* -10956: There is no Operation that references the specified Operation.\r\n* -10984: The State Machine is not valid, because it has no initial Status.\r\n* -10981: The specified Work Order Operation could not be updated.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "Id",
          "Description": "The primary key identifier of the Work Order to be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "TemplateNId",
          "Description": "The natural key identifier of the Work Order Template. If empty, the default Work Order Template is used.",
          "Type": "String"
        },
        {
          "Name": "Name",
          "Description": "The name assigned to the Work Order. ",
          "Type": "String"
        },
        {
          "Name": "Description",
          "Description": "Additional information on the Work Order",
          "Type": "String"
        },
        {
          "Name": "StatusNId",
          "Description": "The natural identifier of the Work Order Status.",
          "Type": "String"
        },
        {
          "Name": "StateMachineNId",
          "Description": "The natural key identifier of the State Machine to which the Status of the Work Order belongs.",
          "Type": "String"
        },
        {
          "Name": "MaterialNId",
          "Description": "The natural identifier of the Work Order Material.",
          "Type": "String"
        },
        {
          "Name": "MaterialRevision",
          "Description": "The revision of the Material. If empty, the current Material revision is used.",
          "Type": "String"
        },
        {
          "Name": "Quantity",
          "Description": "The quantity of Material in terms of value and Unit of Measure.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.QuantityParameterType",
          "MemberArtifactType": "ParameterType"
        },
        {
          "Name": "BillOfMaterialsNId",
          "Description": "The natural identifier of the BoM to be associated with the Work Order.",
          "Type": "String"
        },
        {
          "Name": "BillOfMaterialsRevision",
          "Description": "The revision of the BoM to be associated with the Work Order. If empty, the current BoM revision is used.",
          "Type": "String"
        },
        {
          "Name": "WorkOrderOperations",
          "Description": "The list of Work Order Operations to be added to the Work Order.",
          "Type": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Types.WorkOrderOperationExtended",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "PlannedStartTime",
          "Description": "The planned start time of the Work Order.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "ActualStartTime",
          "Description": "The actual start time of the Work Order.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "ActualEndTime",
          "Description": "The actual end time of the Work Order.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "PlannedEndTime",
          "Description": "The planned end time of the Work Order.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "ActualQuantity",
          "Description": "The actual quantity of Material in terms of value and Unit of Measure.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.QuantityParameterType",
          "MemberArtifactType": "ParameterType"
        },
        {
          "Name": "Type",
          "Description": "Type of activity.",
          "Type": "String"
        },
        {
          "Name": "EquipmentNId",
          "Description": "The natural key identifier of the Equipment.",
          "Type": "String"
        },
        {
          "Name": "Priority",
          "Description": "The Priority of the Work Order.",
          "Type": "Int32"
        },
        {
          "Name": "ResetProperty",
          "Description": "This is an optional parameter. If it is set to True, the command resets one or more editable properties of a Work Order and its Work Order Extended, when the property has been modified to empty.",
          "Type": "Boolean"
        },
        {
          "Name": "WorkMasterNId",
