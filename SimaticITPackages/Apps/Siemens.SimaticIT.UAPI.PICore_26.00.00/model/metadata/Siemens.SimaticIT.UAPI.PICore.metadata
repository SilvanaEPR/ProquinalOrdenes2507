    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.UpdateOperationEquipmentSpecification",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.UpdateOperationEquipmentSpecification",
      "Description": "Updates the Sequence number, Requirement Tag and IsMain Properties of the Operation Equipment Specification. \r\n\r\nThe command will: \r\n1. retrieve the Work Master Operation and the Work Master; \r\n2. check if the Work Master can be edited; \r\n3. update the Work Master Operation Equipment Specification according to the given command inputs. \r\n\r\nThe command checks if the given Work Master Operation exists, If not error -10300 is returned. \r\nThe command checks if the Work Master associated to the given Work Master Operation is locked for editing, If so, error -10813 is returned. \r\nThe command checks if the Operation Equipment Specification specifies an Equipment Group identifier when the IsMain Property is set to True, If not error -10899 is returned ",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "Id",
          "Description": "The primary key identifier of the Operation Equipment Specification that must be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "Sequence",
          "Description": "The new value to be assigned.",
          "Type": "Int32",
          "IsMandatory": "True"
        },
        {
          "Name": "SpecificationTag",
          "Description": "This field is used to indicate Equipments related to each other.",
          "Type": "String"
        },
        {
          "Name": "IsMain",
          "Description": "TRUE if the Equipment Specification is the most relevant in the list; FALSE otherwise.\r\nThis property applies to Equipment Group only.\r\nOnly one Equipment Specification can be set as Main.",
          "Type": "Boolean"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.UpdateOperationEquipmentSpecification"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.CreateWorkMasterV2",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.CreateWorkMasterV2",
      "Description": "Creates a new Work Master.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10804: The Work Master with the specified NId and Revision already exists.\r\n* Error -10805: More than one Work Master with the specified NId and Revision exists.\r\nThe command may return the following error codes, during its execution:\r\n* Error -10818: The Work Master identifier generation failed.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "NId",
          "Description": "The natural identifier of the Work Master.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "Name",
          "Description": "The name assigned to the Work Master.",
          "Type": "String"
        },
        {
          "Name": "Description",
          "Description": "Additional information on the Work Master.",
          "Type": "String"
        },
        {
          "Name": "Revision",
          "Description": "The revision of the Work Master.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "MaterialGroupNId",
          "Description": "The natural identifier of the Material Group the Material belongs to.",
          "Type": "String"
        },
        {
          "Name": "MaterialNId",
          "Description": "The natural identifier of the Material.",
          "Type": "String"
        },
        {
          "Name": "MaterialRevision",
          "Description": "The revision of the Material. An empty field implies the use of the current revision of the Material.",
          "Type": "String"
        },
        {
          "Name": "Quantity",
          "Description": "The quantity of Material in terms of value and Unit of Measure.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.QuantityParameterType",
          "MemberArtifactType": "ParameterType"
        },
        {
          "Name": "Type",
          "Description": "Type of activity.",
          "Type": "String"
        },
        {
          "Name": "AvailableAsTemplate",
          "Description": "TRUE if you want the operations, added to the Work Master, to be, by default, available as Template. This means that the Work Master Operations, together with their specifications, can be added to another Work Master or, at runtime, to a Work Order even if it has not been generated starting from the Work Master you are currently configuring. FALSE otherwise.",
          "Type": "Boolean"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "Id",
          "Description": "The identifier of the work master that has been created.",
          "Type": "Guid"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.CreateWorkMasterV2"
    },
    {
