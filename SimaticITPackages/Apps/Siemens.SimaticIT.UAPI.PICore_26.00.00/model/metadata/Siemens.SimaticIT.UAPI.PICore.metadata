    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.CreateWorkOrderByWorkOrder",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.CreateWorkOrderByWorkOrder",
      "Description": "Creates a new Work Order as copy of an an existing Work Order.\r\nThe command may return the following error codes, during its execution:\r\n* Error -10938: The Work Order already exists.\r\n* Error -10937: The Work Order with the specified NId was not found.\r\n* Error -10963: The CreateWorkOrderByWorkOrder command failed creating the Work Order.\r\n* Error -10950: The Work Order update failed.\r\n* Error -10956: There is no Operation that references the Operation with the specified NId and Revision.\r\n* Error -10995: It was not possible to associate the Equipment Requirement with the Operation. \r\n* Error -10978: It was not possible to associate Material with the Operation Material Requirement.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "NId",
          "Description": "The natural identifier of the Work Order that will be created.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "SourceWorkOrderNId",
          "Description": "The natural identifier of the Work Order of which the new Work Order will be a copy.",
          "Type": "String",
          "IsMandatory": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.CreateWorkOrderByWorkOrder"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.DeleteProcessParameterToWorkOrderHeader",
