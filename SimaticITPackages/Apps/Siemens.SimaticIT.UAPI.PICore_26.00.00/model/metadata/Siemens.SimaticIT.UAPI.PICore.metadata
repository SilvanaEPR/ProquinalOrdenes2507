    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddParameterRequirementsToWorkOrderOperationFromCatalog",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddParameterRequirementsToWorkOrderOperationFromCatalog",
      "Description": "Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nThis command creates Parameter Requirements where the values of the limits and tolerances are initiated as they are provided to the command, even if they are expessed in percents.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.",
      "ArtifactType": "Command",
      "NotSupportedBySignalRule": "True",
      "Members": [
        {
          "Name": "Id",
          "Description": "The identifier of the Work Order Operation.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ProcessParameters",
          "Description": "The list of the catalog parameters that must be added to the Work Order Operation ",
          "Type": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Types.ParameterSpecificationFromCatalog",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "ParameterRequirementIds",
          "Description": "The list of identifiers of the Work Order Operation Parameter Requirements that have been added.",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddParameterRequirementsToWorkOrderOperationFromCatalog"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddParameterRequirementsToWorkOrderOperationFromProcessDefinition",
