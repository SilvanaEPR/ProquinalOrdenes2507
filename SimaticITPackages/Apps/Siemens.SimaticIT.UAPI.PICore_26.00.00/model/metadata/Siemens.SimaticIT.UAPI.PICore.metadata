    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.CreateAndAssociateProcessParametersToWorkMaster",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.CreateAndAssociateProcessParametersToWorkMaster",
      "Description": "Creates a process Parameter and associates it to a Work Master. \r\nWhenever you define a new Parameter, the system stores this Parameter into a catalog. \r\nThen this catalog Parameter is available to be used as Work Master Parameters, Parameter Specifications of Work Master Operation, and Work Order Parameters.\r\nThe command CreateCatalogueParameter is called for each process Parameter.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "ParameterNId",
          "Description": "The natural identifier of the parameter.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "ParameterName",
          "Description": "The name assigned to the parameter.",
          "Type": "String"
        },
        {
          "Name": "ParameterDescription",
          "Description": "Additional information on the parameter.",
          "Type": "String"
        },
        {
          "Name": "ParameterTargetValue",
          "Description": "The default target value of the parameter.",
