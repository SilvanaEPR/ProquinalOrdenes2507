          "IsMandatory": "True",
          "IsLogicalKey": "True"
        },
        {
          "Name": "Description",
          "Type": "String"
        },
        {
          "Name": "CriticalityNId",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
