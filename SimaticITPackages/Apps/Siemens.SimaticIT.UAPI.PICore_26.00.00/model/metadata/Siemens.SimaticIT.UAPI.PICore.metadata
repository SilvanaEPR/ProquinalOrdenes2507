      "ReferencedFullInfo": "Siemens.OpcenterEX.OperationalData.Maintenance_OP.OPModel.Commands.TagForMaintenanceInspectionOrder",
      "Description": "This command starts the maintenance process of an Inspection Order. \r\nIt does not perform anything by itself but it triggers several Post Actions that are responsible for the maintenance of an Inspection Order, such as cleaning or deleting the entities related to the given Inspection Order. It triggers the following Post Actions:\r\n-TagForMaintenanceQualityInspections\r\n-TagForMaintenanceInspectionOrderSample\r\n-TagForMaintenanceInspectionWorkProcessesToBeDeleted\r\n-TagForMaintenanceInspectionTasks\r\n-TagForMaintenanceInspectionProductionHistoryRecords\r\n-TagForMaintenanceInspectionEquipmentOperationsTracking\r\n-TagForMaintenanceInspectionStepFlows\r\n-TagForMaintenanceInspectionWorkInstructions",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "InspectionOrderIds",
          "Description": "A list of Inspection Orders to be tagged for maintenance. The property stores the identifiers of Inspection Orders.",
          "Type": "Guid",
          "IsCollection": "True",
          "IsMandatory": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.TagForMaintenanceInspectionOrder"
    },
