          "Name": "WorkOrderOperationId",
          "Description": "The primary key identifier of the Work Order Operation.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ProcessDefinitions",
          "Description": "The list of Process Definitions that must be associated to the selected Work Order Operation. Each Process Definition is identified by its natural identifier and revision. The revision field can be empty and the current revision of the Process Definition will be used, when required.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.LinkToRevisonedEntity",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
