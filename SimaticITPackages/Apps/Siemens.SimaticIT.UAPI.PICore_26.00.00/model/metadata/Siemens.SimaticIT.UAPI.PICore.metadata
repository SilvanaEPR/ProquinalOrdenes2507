      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.CreateWorkOrderExtended",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.CreateWorkOrderExtended",
      "Description": "Creates a Work Order and its Work Order Extended. The Planned Start Time property is specific of the Work Order Extended. This command is used by the UI and does not create WO operations.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "NId",
          "Description": "The natural identifier of the Work Order.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "Name",
          "Description": "The name of the Work Order.",
          "Type": "String"
        },
        {
          "Name": "Description",
          "Description": "Additional information on the Work Order.",
          "Type": "String"
        },
        {
          "Name": "TemplateNId",
          "Description": "The natural identifier of the Work Order Template. If empty, the default Work Order Template is used.",
          "Type": "String"
        },
        {
          "Name": "MaterialNId",
          "Description": "The natural identifier of the Material that is produced by Work Order.",
          "Type": "String"
        },
        {
          "Name": "MaterialRevision",
          "Description": "The revision of the Material. If empty, the current Material revision is used.",
          "Type": "String"
        },
        {
          "Name": "Quantity",
          "Description": "The quantity of Material in terms of value and Unit of Measure.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.QuantityParameterType",
          "MemberArtifactType": "ParameterType"
        },
        {
          "Name": "BillOfMaterialsNId",
          "Description": "The natural identifier of the BoM to be associated with the Work Order.",
          "Type": "String"
        },
        {
          "Name": "BillOfMaterialsRevision",
          "Description": "The revision of the BoM to be associated with the Work Order. If empty, the current BoM revision is used.",
          "Type": "String"
        },
        {
          "Name": "PlannedStartTime",
          "Description": "The planned start time of the Work Order.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "PlannedEndTime",
          "Description": "The planned end time of the Work Order.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "ActualQuantity",
          "Description": "The quantity of Material, in terms of value and Unit of Measure, when the Work Order is going to be executed.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.QuantityParameterType",
          "MemberArtifactType": "ParameterType"
        },
        {
          "Name": "OrderNId",
          "Description": "The natural identifier of the Order.",
          "Type": "String"
        },
        {
          "Name": "Type",
