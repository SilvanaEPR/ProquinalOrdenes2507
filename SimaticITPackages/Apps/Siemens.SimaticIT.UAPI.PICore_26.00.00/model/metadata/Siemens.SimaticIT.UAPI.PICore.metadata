    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.UpdateWorkOrderOperationExtended",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.UpdateWorkOrderOperationExtended",
      "Description": "Resets and/or Updates one or more properties of a Work Order Operation and its extension. The command resets a property when it has been set to empty and updates its value, if specified.\r\nThe command may return the following error codes, during its execution:\r\n* -10948: The Work Order Operation does not exist.\r\n* -10996: The Work Master Operation has not been found.\r\n* -11314: The Estimated Duration cannot be negative.\r\n* -10996: The piece of Equipment set as Actual Equipment has not been found.\r\n* -11311: Planned Start Time cannot be equal to or later than the Planned End Time.\r\n* -10979: Actual Start Time cannot be equal to or later than the Actual End Time.\r\n* -10981: The Update of the Work Order Operation failed.\r\n* -10982: The creation of the Task for the specified Work Order has failed.\r\n",
      "IsComplexParameter": "True",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "Id",
          "Description": "The identifier of the Work Order Operation to be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "OperationNId",
          "Description": "The natural identifier of the Operation.",
          "Type": "String"
        },
        {
          "Name": "OperationRevision",
          "Description": "The revision of the Operation. If empty, the current revision of the Operation is used.",
          "Type": "String"
        },
        {
          "Name": "Name",
          "Description": "The name of the Work Order Operation.",
          "Type": "String"
        },
        {
          "Name": "Description",
          "Description": "Additional information on the Work Order Operation.",
          "Type": "String"
        },
        {
          "Name": "Sequence",
          "Description": "The sequence number of the Work Order Operation inside the Work Order.",
          "Type": "Int32"
        },
        {
          "Name": "EquipmentNId",
          "Description": "The natural identifier of the Equipment where the Work Order Operation is executed.",
          "Type": "String"
        },
        {
          "Name": "StatusNId",
          "Description": "The natural identifier of the Work Order Operation Status.",
          "Type": "String"
        },
        {
          "Name": "StateMachineNId",
          "Description": "The natural identifier of the State Machine to which the Status of the Work Order Operation belongs.",
          "Type": "String"
        },
        {
          "Name": "ActualEquipmentNId",
          "Description": "The natural identifier of the Equipment to be set as actual.",
          "Type": "String"
        },
        {
          "Name": "ActualStartTime",
          "Description": "The actual start time of the Work Order Operation.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "ActualEndTime",
          "Description": "The actual end time of the Work Order Operation.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "IsInExecutionPropagation",
          "Description": "TRUE if you want the Work Order Operation to take part in an automatic mechanism for status propagation in the context of the Work Order. FALSE otherwise.",
          "Type": "Boolean"
        },
        {
          "Name": "WorkOrderOperationMaterialRequirements",
          "Description": "The list of Work Order Operation Material Requirements to be added to the Work Order Operation.",
          "Type": "Siemens.SimaticIT.OperationalData.UDM_OP.OPModel.Types.ReferenceWorkOrderOperationMaterialRequirementParameterType",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "WorkOrderOperationMaterialRequirementsExtended",
          "Description": "The list of Work Order Operation Material Requirements to be added to the Work Order Operation. Use this parameter to include also information such as the Usage and Direction of the Work Order Operation Material Requirement and optionally the BoM Item the Material belongs to.",
          "Type": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Types.ReferenceWorkOrderOperationMaterialRequirementExtendedParameterType",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "WorkOrderOperationActualMaterials",
          "Description": "The list of Work Order Operation Actual Materials to be added to the Work Order Operation. Use this parameter to include also information such as the Usage and Direction of the Work Order Operation Actual Material and optionally the BoM Item the Material belongs to.",
          "Type": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Types.ReferenceWorkOrderOperationActualMaterialParameterType",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "WorkOrderOperationEquipmentRequirements",
          "Description": "The list of Work Order Operation Equipment Requirements to be added.",
          "Type": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Types.ReferenceWorkOrderOperationEquipmentRequirementParameterType",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "PlannedStartTime",
          "Description": "The planned start time of the Work Order Operation.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "PlannedEndTime",
          "Description": "The planned end time of the Work Order Operation.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "IsPlannable",
          "Description": "TRUE to indicate that the Work Order Operation can be planned by an APS. FALSE otherwise.",
          "Type": "Boolean"
        },
        {
