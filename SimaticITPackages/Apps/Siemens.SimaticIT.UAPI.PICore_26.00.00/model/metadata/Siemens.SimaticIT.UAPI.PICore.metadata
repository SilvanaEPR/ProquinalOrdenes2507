    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.SetWorkOrderOperationActualEquipmentFromTask",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.SetWorkOrderOperationActualEquipmentFromTask",
      "Description": "Updates the Actual Equipment of Work Order Operation based on a related Task, setting the Actual Equipment value equal to the Task Equipment value. \r\nBy default, this only happens when the Task Status switches to InProgress.   \r\n\r\nThe command performs the following checks: \r\n1. if the given Task exists, if not error -11309 is returned; \r\n2. if the given Task is specified with a piece of Equipment, if not error -11326 is returned; \r\n3. if the given Task is related to a Work Order Operation, if not error -11326 is returned; \r\n4. if the Work Order Operation related to the Task exists, if not error -11312 is returned; \r\n5. if the call to the sub Command UpdateWorkOrderOperationExtended is successful, if not error -10981 is returned. ",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "TaskId",
          "Description": "The primary key identifier of the Task.",
          "Type": "Guid",
          "IsMandatory": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.SetWorkOrderOperationActualEquipmentFromTask"
    },
