          "Description": "List of the values for the Work Process Paramenter.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.ParameterValueParameterType",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "ContextUserFieldValues",
          "Description": "List of the values of the Work Process Context User Fields.",
          "Type": "Siemens.SimaticIT.OperationalData.BPF_OP.OPModel.Types.ContextUserFieldValueParameterType",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "ChainId",
          "Description": "A unified identifier for a chain of commands/events.",
          "Type": "Guid"
        },
        {
          "Name": "NId",
          "Description": "The natural key identifier of the new Work Process.",
          "Type": "String"
        },
        {
          "Name": "ParentWorkProcessId",
          "Description": "A unified identifier of the parent Work Process.",
          "Type": "Guid"
        },
        {
          "Name": "Name",
          "Description": "The name assigned to the Work Process.",
          "Type": "String"
        },
        {
          "Name": "Description",
          "Description": "The description assigned to the Work Process.",
          "Type": "String"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "WorkProcessId",
          "Description": "The primary key identifier of the new Work Process.",
          "Type": "Guid"
        },
        {
