    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.CreateFullWorkMaster",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.CreateFullWorkMaster",
      "Description": "Creates a Work Master data including Parameters and Work Master Operations.\r\nEach Work Master Operation can include Parameter Specifications, Material Specifications, Equipment Specifications and Process Definitions.\r\nIf a Work Master, with the same NId and Revision, already exists, the Work Master is updated (parameters and operations are deleted and recreated), if not locked. \r\nIf a Work Master, with the same NId and different Revision, already exists, a new Work Master Revision is created..\r\nAfter the Work Master creation, the command raises the FullWorkMasterCreated event.\r\n\r\nThe command may call from these commands and one of them raise an error, it will be returned in the message of error 11350:\r\n  CreateWorkMasterV2 / UpdateWorkMasterV2\r\n  CreateAndAssociateProcessParametersToWorkMaster / AddProcessParametersToWorkMasterHeader / DeleteWorkMasterHeaderParameter\r\n  AddWorkMasterOperation / AssociateOperationsToWorkMaster / DeleteWorkMasterOperations\r\n    CreateAndAssociateProcessParameterToWorkMasterOperation / AddParameterSpecificationsToWorkMasterOperationFromCatalog\r\n    AddMaterialSpecificationsToWorkMasterOperationFromMaterial\r\n    AddEquipmentSpecificationsToWorkMasterOperation\r\n    AssociateProcessDefinitionsWithWorkMasterOperation\r\n\r\nIf one of above commands raise an error, it will be returned in the reason part of the message with error code 11350.\r\nThe command may return the following error codes, during its execution:\r\n* Error -11350: The execution of CreateFullWorkMaster with specified NId and Revision has failed, for the following reason.\r\n* Error -11308: Segregation tag(s) does/do not exist.",
      "IsComplexParameter": "True",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "WorkMaster",
          "Description": "Work Master data including Parameters and Work Master Operations.",
          "Type": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Types.WorkMasterParameterType",
          "MemberArtifactType": "ParameterType",
          "IsMandatory": "True"
        },
        {
          "Name": "DataSegregationTags",
          "Description": "List of Data Segregation Tags to be added to the WorkMaster.",
          "Type": "String",
          "IsCollection": "True"
        },
        {
          "Name": "Bag",
          "Description": "WorkMaster structure in B2MML format.",
          "Type": "String"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "WorkMasterId",
          "Description": "Logical identifier of the created Work Master.",
          "Type": "Guid"
        },
        {
          "Name": "WorkMasterNId",
          "Description": "The natural identifier of the Work Master.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "WorkMasterRevision",
          "Description": "The revision of the Work Master.",
          "Type": "String",
          "IsMandatory": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.CreateFullWorkMaster"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AssociateInspectionMasterPlanWithWorkMaster",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AssociateInspectionMasterPlanWithWorkMaster",
      "Description": "Associates the Inspection Master Plan to a Work Master.",
      "ArtifactType": "Command",
      "Members": [
        {
