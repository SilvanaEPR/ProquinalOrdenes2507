          "Type": "String"
        },
        {
          "Name": "Direction",
          "Description": "Specifies how the Material will be used during the execution of a Work Order Operation. For example, the Material could represent either the contribution or the result of the Work Order Operation. The pre-defined values that can be assigned to this property are: INPUT and OUTPUT.",
          "Type": "String"
        },
        {
          "Name": "Usage",
          "Description": "Classifies the Material depending on how it is used during the execution of a Work Order Operation, for example as consumed or produced. No predefined values are provided.",
