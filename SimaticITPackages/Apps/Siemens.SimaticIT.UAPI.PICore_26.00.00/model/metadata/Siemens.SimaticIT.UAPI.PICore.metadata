    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddWorkMasterOperationFromWorkMasterOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddWorkMasterOperationFromWorkMasterOperation",
      "Description": "Adds a Work Master Operation to a Work Master by copying a Work Master Operation from another Work Master.  \r\nThe new Work Master Operation is created with all requested Specifications of the Work Master Operation of origin: Parameter Specifications, Material Specifications, and Equipment Specifications. \r\n\r\nThe AssociateOperationsToWorkMaster Command is first called to create the Work Master Operation without specifications. \r\n\r\n The command checks if the given Work Master Operation exists, if not error 10300 is returned. ",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "WorkMasterOperationSourceId",
          "Description": "The primary key identifier of the Work Master Operation to be copied.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "WorkMasterDestinationId",
          "Description": "The primary key identifier of the Work Master to which the Work Master Operation will be added.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "Description",
          "Description": "Additional information on the Work Master Operation.",
          "Type": "String"
        },
        {
          "Name": "Sequence",
          "Description": "A number that specifies a hypothetical execution order of the Work Order Operations (created at runtime from the Work Master Operations of the Work Master to which you are adding the Work Master Operation).",
          "Type": "Int32",
          "IsMandatory": "True"
        },
        {
          "Name": "EstimatedDuration",
          "Description": "The estimation in minutes of the duration of the resulting Work Order Operation.",
          "Type": "Int32"
        },
        {
          "Name": "AvailableAtRuntime",
          "Description": "Set to  true to be able to add the Work Order Operation, that you are adding, to a Work Order from the Work Master Operation that you are adding. ",
          "Type": "Boolean"
        },
        {
          "Name": "IsInExecutionPropagation",
          "Description": "Set to TRUE if you want that the Status of the Work Order Operations with first Sequence are automatically updated at runtime, according to the Status change of the respective Work Order, for the Statuses IsInProgress and IsCompleted.  \r\nIf there are more than one Work Order Operations and if they are configured with Execution Propagation set to True, each following Work Order Operations will automatically switch to the Status IsInProgress when the previous Work Order Operation switches to the Status IsCompleted.  \r\nThe order of the Work Order Operations depend on the Sequence. \r\nSet to FALSE otherwise.",
          "Type": "Boolean"
        },
        {
          "Name": "IsPlannable",
          "Description": "Set to TRUE to indicate that the Work Master Operation, that you are adding, can be planned by an advanced planning system. ",
          "Type": "Boolean"
        },
        {
          "Name": "Name",
          "Description": "The name assigned to the Work Master Operation.",
          "Type": "String"
        },
        {
          "Name": "AreMaterialSpecificationsIncluded",
          "Description": "Set to true if you want to include the Material Specifications of the Work Master Operation of origin. \r\nSet to false otherwise. ",
          "Type": "Boolean",
          "IsMandatory": "True"
        },
        {
          "Name": "AreEquipmentSpecificationsIncluded",
          "Description": "Set to true if you want to include the Equipment Specifications of the Work Master Operation of origin. \r\nSet to false otherwise. ",
          "Type": "Boolean",
          "IsMandatory": "True"
        },
        {
          "Name": "AreParameterSpecificationsIncluded",
          "Description": "Set to true if you want to include the Parameter Specifications of the Work Master Operation of origin. \r\nSet to false otherwise. ",
          "Type": "Boolean",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "WorkMasterOperationId",
          "Description": "The primary key identifier of the created Work Master Operation.",
          "Type": "Guid"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddWorkMasterOperationFromWorkMasterOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AssociateEquipmentWithOperationParameterSpecification",
