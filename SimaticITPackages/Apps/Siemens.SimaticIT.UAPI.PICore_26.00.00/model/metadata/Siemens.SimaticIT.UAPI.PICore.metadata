      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.DeleteProcessParameterToWorkOrderOperation",
      "Description": "Deletes a process parameter from a Work Order Operation.",
