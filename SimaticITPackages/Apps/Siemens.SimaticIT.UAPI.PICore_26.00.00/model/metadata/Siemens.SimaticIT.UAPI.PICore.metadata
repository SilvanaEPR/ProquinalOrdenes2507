      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.DeleteProcessParameterToWorkOrderOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.UpdateProcessParameterToWorkOrderOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.UpdateProcessParameterToWorkOrderOperation",
      "Description": "Updates the value of a Parameter Requirement of a Work Order Operation. If the Parameter Requirement is linked to a Task Parameter, and the Task has not been activated yet, the Task Parameter value is updated with the given argument ParameterValue.\r\nIf the value of an input parameter is empty or null, the respective property of the Parameter Requirement is not changed.\r\nChecks if:\r\n- the given Id of the Parameter Requirement of the Work Order Operation exists, otherwise it throws the error 10945;\r\n- the given ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh, ParameterActualValue values are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\nChecks if the Parameter Requirement of the Work Order Operation has a TaskNId and a TaskParameterNId neither null nor empty; If so, if the given Task is in an initial status, the command calls the command UpdateTaskParameter which will update the value of the Task Parameter property of the respective Parameter Requirement with the ParameterValue passed by the original command:\r\n- if the UpdateTaskParameter command fails, it throws an error code that this command will return (to know more about the possible errors, check the ref. doc. of the UpdateTaskParameter);\r\n- if, for some reason, it is impossible to call the UpdateTaskParameter command, the error 10960 is thrown.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "Id",
          "Description": "The identifier of the process parameter of the Work Order Operation that has to be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ParameterValue",
          "Description": "The actual value of the process parameter, i.e. the value that was actually used during the process execution.",
          "Type": "String"
        },
        {
          "Name": "ParameterLimitLow",
          "Description": "Lowest limit of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterToleranceLow",
          "Description": "Lowest tolerance of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterToleranceHigh",
          "Description": "Highest tolerance of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterLimitHigh",
          "Description": "Highest limit of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterActualValue",
          "Description": "The new actual value of the process parameter.",
          "Type": "String"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.UpdateProcessParameterToWorkOrderOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.UpdateProcessParameterToWorkOrderHeader",
