    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.StartNewWorkProcessExtended",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.StartNewWorkProcessExtended",
      "Description": "Creates and runs a new Work Process.\r\nChecks that the Process Definition exists for the given revision, that the revision is set as current, and that the process definition is set as executable. \r\nIf the parameter NId is not specified, a value is generated automatically by using the Numbering Pattern for Work Process.\r\nIf the parameter Name is not specified, the Process Definition name is used as value.\r\nIf the parameter Description is not specified, the Process Definition description is used as value.\r\nThe command may return the following error codes:\r\n* Error -11200: The Process Definition is not executable.\r\n* Error -10889: The Process Definition revision is undefined and there is no current revision\r\n* Error -10895: The Process Definition does not exists with the given revision.\r\n* Error -10818: The Work Process NId cannot be generated using the Numbering Pattern.",
      "IsComplexParameter": "True",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "ProcessDefinitionNId",
          "Description": "The natural key identifier of the Process Definition.",
          "Type": "String",
