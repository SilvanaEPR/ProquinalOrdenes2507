          "Type": "String"
        },
        {
          "Name": "WorkMasterOperationId",
          "Description": "The identifier of the Work Master Operation to which the process parameter must be associated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ParameterLimitLow",
          "Description": "Lowest limit of the parameter value.",
