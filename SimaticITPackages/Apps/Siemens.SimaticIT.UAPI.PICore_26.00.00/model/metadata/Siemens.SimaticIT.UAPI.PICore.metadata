    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddWorkMasterOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddWorkMasterOperation",
      "Description": "Creates a Work Master Operation from scratch and associates it to the Work Master.  \r\nThe new Work Master Operation is created without Specifications and Process Definitions.\r\n\r\nThe AssociateOperationsToWorkMaster Command is first called to create the Work Master Operation without specifications.\r\n\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: the State Machine, identified by StateMachineNId, does not exist.\r\n* Error -11320: the State Machine does not contain statuses.\r\n* Error -10984: the initial status does not exist in the State Machine.\r\n* Error -10300: the Equipment Configuration, identified by EquipmentNId, does not exist.\r\n* Error -10316: the Name parameter is empty.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "NId",
          "Description": "The natural identifier of the Work Master Operation. If it is not specified, an autogenerated indentifier will  be used in according to a numeric pattern defined.",
          "Type": "String"
        },
        {
          "Name": "Name",
          "Description": "The name assigned to the Work Master Operation.",
          "Type": "String"
        },
        {
          "Name": "Sequence",
          "Description": "A number that specifies a hypothetical execution order of the Work Order Operations (created at runtime from the Work Master Operations of the Work Master to which you are adding the Work Master Operation).",
          "Type": "Int32",
          "IsMandatory": "True"
        },
        {
          "Name": "Description",
          "Description": "Additional information on the Work Master Operation.",
          "Type": "String"
        },
        {
          "Name": "EquipmentNId",
          "Description": "The natural key identifier of the Equipment, which is associated to the Work Master Operation.",
          "Type": "String"
        },
        {
          "Name": "StateMachineNId",
          "Description": "The natural key identifier of the State Machine to which the Status of the Work Master Operation belongs.",
          "Type": "String"
        },
        {
          "Name": "EstimatedDuration",
          "Description": "The estimation in minutes of the duration of the resulting Work Order Operation.",
          "Type": "Int32"
        },
        {
          "Name": "IsInExecutionPropagation",
          "Description": "Set to TRUE if you want that the Status of the Work Order Operations with first Sequence are automatically updated at runtime, according to the Status change of the respective Work Order, for the Statuses IsInProgress and IsCompleted.  ",
          "Type": "Boolean"
        },
        {
          "Name": "AvailableAtRuntime",
          "Description": "Set to  true to be able to add the Work Order Operation, that you are adding, to a Work Order from the Work Master Operation that you are adding. ",
          "Type": "Boolean"
        },
        {
          "Name": "CanBePlanned",
          "Description": "Set to TRUE to indicate that the Work Master Operation, that you are adding, can be planned by an advanced planning system. ",
          "Type": "Boolean"
        },
        {
          "Name": "WorkMasterDestinationId",
          "Description": "The primary key identifier of the Work Master to which the Work Master Operation will be added.",
          "Type": "Guid",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "Id",
          "Description": "The primary key identifier of the created Work Master Operation.",
          "Type": "Guid"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddWorkMasterOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.DisassociateProcessDefinitionsFromWorkMasterOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.DisassociateProcessDefinitionsFromWorkMasterOperation",
      "Description": "Removes the link between the Work Master Operation and one or more Process Definitions.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: The Work Master Operation with the specified NId does not exist.\r\n* Error -10843: There is no Process Definition with NId and revision linked to the Operation.",
      "ArtifactType": "Command",
      "NotSupportedBySignalRule": "True",
      "Members": [
        {
          "Name": "WorkMasterOperationId",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ProcessDefinitions",
          "Description": "The list of Process Definitions for which the link to the Work Master Operation must be removed. Each Process Definition is identified by its natural identifier and revision.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.LinkToRevisonedEntity",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True",
          "IsMandatory": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.DisassociateProcessDefinitionsFromWorkMasterOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AssociateProcessDefinitionsWithWorkMasterOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AssociateProcessDefinitionsWithWorkMasterOperation",
      "Description": "Associates a Work Master Operation to one or more Process Definitions.\r\n\r\nThe command may return the following error codes:\r\n* -10300: The Work Master Operation specified in input does not exist.\r\n* -10890: Two revisions of a Process Definition cannot be associated to the Work Master Operation.\r\n* -10889: One of the Process Definitions you are associating has no revision set to current. \r\n* -10811: A Process Definition with specified NId and Revision  does not exist.\r\n* -10892: A Process Definition could not be found.",
      "ArtifactType": "Command",
      "NotSupportedBySignalRule": "True",
      "Members": [
        {
          "Name": "WorkMasterOperationId",
          "Description": "The primary key identifier of the Work Master Operation.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ProcessDefinitions",
          "Description": "The list of Process Definitions that must be associated to the selected Work Master Operation. Each Process Definition is identified by its natural identifier and revision. The revision field can be empty and the current revision of the Process Definition will be used, when required.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.LinkToRevisonedEntity",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True",
          "IsMandatory": "True"
        },
        {
          "Name": "IsForManualExecution",
          "Description": "Specifies whether the ProcessDefinitions should be treated as manual and not executed automatically",
          "Type": "Boolean"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "ProcessDefinitionIds",
          "Description": "The list of primary key identifiers of the Process Definition associated with the Work Master Operation",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AssociateProcessDefinitionsWithWorkMasterOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.SetWorkMasterOperationAsStandalone",
