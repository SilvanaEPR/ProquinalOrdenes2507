          "Type": "String"
        },
        {
          "Name": "MaterialNId",
          "Description": "The natural key identifier of the Actual Material associated to the Work Order Operation. If the MaterialGroupNId field is not empty, the Actual Material must belong to the specified Group.",
          "Type": "String"
        },
        {
          "Name": "MaterialRevision",
          "Description": "The revision of the Actual Material associated to the Work Order Operation. If this field is empty the current revision of the Actual Material is used.",
          "Type": "String"
        },
        {
          "Name": "Quantity",
          "Description": "The quantity of the Work Order Operation Actual Material, in terms of value and UoM.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.QuantityParameterType",
          "MemberArtifactType": "ParameterType"
        },
        {
          "Name": "Sequence",
          "Description": "The sequence number of the Work Order Operation Actual Material.",
          "Type": "Int32"
        },
        {
          "Name": "BoMNId",
          "Description": "The natural identifier of the BoM. This field is empty if the Material has not been chosen from a BoM.",
          "Type": "String"
        },
        {
          "Name": "BoMRevision",
          "Description": "The revision of the BoM. If the BoMNId is not empty and this field is empty the current revision of the BoM ise used.",
