    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddParameterSpecificationsToWorkMasterOperationFromCatalog",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddParameterSpecificationsToWorkMasterOperationFromCatalog",
      "Description": "Adds a set of Parameter Specifications to the Work Master Operation given as input, from a set of Catalog parameters.\r\nThe argument ParameterSpecifcations is a collection of ParameterSpecificationFromCatalog.\r\nThis Parameter Type has a property ParameterNId that is the natural identifier of a Catalog Parameter.\r\nThe Parameter Specifications can inherit the same property values than the respective Catalog Parameters. In which case, simply fill the ParameterNId of each element of ParameterSpecifcations list.\r\nIf you want to override a Catalaog Parameter property, fill the necessary property of the respective ParameterSpecificationFromCatalog element. \r\nChecks if the given WorkMasterOperationId exists, otherwise it throws the error 10300.\r\nChecks if the Work Master associated to the given Work Master Operation Parameter Specification is not locked, otherwise it throws the error 10813.\r\nThe command performs a serie of controls on thecontent of ParamerSpecifications. \r\nIf one control fails, the command is cancelled for all parameters: no Parameter Specificaiton will be added.\r\nFor each element of ParameterSpecifcations list:\r\n- Checks if the ParameterNId does not match with an existing Work Master Operation Parameter Specification, otherwise no parameter is added and it throws the error 10837.\r\n- Checks if the ParameterNId matches with an existing Catalog Parameter, otherwise it throws the error 10814.\r\n- Checks if the given ParameterUoMNId exists, otherwise it throws the error 11210.\r\n- Checks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835.\r\n- In case the given Process Definition is different from an already defined Process Definition of the Catalog Parameter, the command checks:\r\n- if the given ProcessDefinitionNId exists, otherwise it throws the error 11210;\r\n- if the given argument SetToUseCurrentRevisionOfProcessDefinition is set to true, the property ProcessDefinitionRevision of the to-be-created Parameter Specification will be deleted; if not and if you pass a Revision to override the Catalog Parameter property, then the command controls that the ProcessDefinitionRevision exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.",
      "ArtifactType": "Command",
      "NotSupportedBySignalRule": "True",
      "Members": [
        {
          "Name": "WorkMasterOperationId",
          "Description": "The primary key identifier of the Work Master Operation.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ParameterSpecifications",
          "Description": "The list of process parameters to be added to the Work Master Operation.",
          "Type": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Types.ParameterSpecificationFromCatalog",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "ParameterSpecificationIds",
          "Description": "The list of the primary key idendifiers of the parameters that have been added to the Work Master Operation.",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddParameterSpecificationsToWorkMasterOperationFromCatalog"
    },
    {
