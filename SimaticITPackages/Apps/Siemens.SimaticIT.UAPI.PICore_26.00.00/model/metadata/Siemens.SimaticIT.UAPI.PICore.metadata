    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.UpdateWorkMasterOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.UpdateWorkMasterOperation",
      "Description": "Updates an existing instance of a Work Master Operation with the specified input. Fields with Null value will not be updated.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: The Work Master Operation specified in input does not exist.\r\nThe command may return the following error codes, during its execution:\r\n* Error -10813: The WorkMaster with the specified NId and Revision is locked and cannot be edited.\r\n* Error -11314: The Estimated Duration of the Operation cannot be negative.\r\n* Error -10301: The piece of Equipment with the specified NId already exists.\r\n\r\n",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "Id",
          "Description": "The primary key identifier of the Work Master Operation to be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "Name",
          "Description": "The name assigned to the Work Master Operation.",
          "Type": "String"
        },
        {
          "Name": "Description",
          "Description": "Additional information on the Work Master Operation.",
          "Type": "String"
        },
        {
          "Name": "IsInExecutionPropagation",
          "Description": "TRUE if you want the Work Order Operation, which is the runtime instance of the Work Master Operation, to take part in an automatic mechanism for status propagation in the context of the Work Order. FALSE otherwise.",
          "Type": "Boolean"
        },
        {
          "Name": "Sequence",
          "Description": "Specifies in what order the Work Master or the Operation is assigned to the Work Master.",
          "Type": "Int32"
        },
        {
          "Name": "AvailableAtRuntime",
          "Description": "TRUE if you want the Operation Specifications, linked to the Work Master, to be available at runtime in order to be used as Requirements of a Work Order Operation. FALSE otherwise.",
          "Type": "Boolean"
        },
        {
          "Name": "IsPlannable",
          "Description": "TRUE if you want the Work Order Operation, which is the runtime instance of the Work Master Operation, to be planned by an APS in the context of the Work Order. FALSE otherwise.",
          "Type": "Boolean"
        },
        {
          "Name": "EstimatedDuration",
          "Description": "The estimated duration (in minutes) of the Work Master Operation.",
          "Type": "Int32"
        },
        {
          "Name": "EquipmentNId",
          "Description": "The natural identifier of the piece of Equipment.",
          "Type": "String"
        },
        {
          "Name": "StateMachineNId",
          "Description": "The natural identifier of the State Machine.",
          "Type": "String"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.UpdateWorkMasterOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddMaterialSpecificationsToWorkMasterOperationFromBoM",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddMaterialSpecificationsToWorkMasterOperationFromBoM",
      "Description": "Adds a list of Operation Material Specifications to the Work Master Operation. The Material data are taken from the BoM that is given as input.",
