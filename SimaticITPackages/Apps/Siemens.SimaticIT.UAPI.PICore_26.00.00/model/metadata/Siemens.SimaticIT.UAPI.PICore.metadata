    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.ComputeMTUSourcesAndDestinations",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PITnT_OP.OPModel.Commands.ComputeMTUSourcesAndDestinations",
      "Description": "Joins the lists returned by ComputeMTUDestinations and ComputeMTUSources.",
      "IsComplexParameter": "True",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "MTUId",
          "Description": "The identifier of MTU.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "Distance",
          "Description": "The maximum path lenght that must be explored in order to detect all the manufacturing operations that have received a contribution from  and have given a contribution to the given MTU.",
          "Type": "Int32"
        },
        {
          "Name": "FromDate",
          "Description": "Starting date of the time range filtering the retrieval of MTU Sources and Destination (expressed in UTC format).",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "ToDate",
          "Description": "Ending date of the time range filtering the retrieval of MTU Destination and Sources  (expressed in UTC format).",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "ReferenceQuantity",
          "Description": "Reference quantity (of material) that can be used to calculate which percentage of the material, contained in the source MTU, has been used to perform the manufacturing operations leading to the material quantity of the given MTU and which percentage of the material, contained in the given MTU, is used to perform the manufacturing operation leading to each MTU destination.",
          "Type": "Decimal"
        },
        {
          "Name": "ReferenceUoMNId",
          "Description": "The Unit of Measure of the reference quantity.",
          "Type": "String"
        },
        {
          "Name": "ExcludedOperationTypes",
          "Description": "Set a list of manufacturing operation types to be excluded from the exploration.",
          "Type": "String",
          "IsCollection": "True"
        },
        {
          "Name": "IncludeOperationsWhereSourceMTUEqualsToDestinationMTU",
          "Description": "TRUE if you want to include in the calculation all the manufacturing operations that do not change the MTU NId; FALSE otherwise.",
          "Type": "Boolean"
        },
        {
          "Name": "CollapseParallelEdges",
          "Description": "TRUE to collapse all the parallel edges into a single edge. FALSE otherwise. Two edges are defined parallel when sharing the same vertices.",
          "Type": "Boolean"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "Nodes",
          "Description": "The list of MTUs which have either given or received a material contribution.",
          "Type": "Siemens.SimaticIT.UAPI.OperationalData.PITnT_OP.OPModel.Types.GraphNode",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "Edges",
          "Description": "The list of material contributions, in terms of material quantity.",
          "Type": "Siemens.SimaticIT.UAPI.OperationalData.PITnT_OP.OPModel.Types.GraphEdge",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.ComputeMTUSourcesAndDestinations"
    },
