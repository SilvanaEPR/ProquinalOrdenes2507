    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition",
      "Description": "Adds a set of Parameter Specifications to a Work Master Operation by copying all the parameters of a Process Definition.\r\nYou can override the target value of each parameter.\r\nThis command creates one Parameter Specification per Process Definition Parameter except if this Process Definition Parameter resulted from importing a Catalog Parameter to the Process Definition.\r\nWhen importing a Catalog Parameter in a Process Definition, a set of Process Definition parameters can be generated, representing the limits and tolerances of the imported Catalog Parameter.\r\nIf it is the case, this command creates only one Parameter Specification that will be defined with the target values of the related Process Definition parameters, each target value being either a limit or a tolerance of the Parameter Specification to be created.",
      "ArtifactType": "Command",
      "NotSupportedBySignalRule": "True",
      "Members": [
        {
          "Name": "WorkMasterOperationId",
          "Description": "The primary key identifier of the Work Master Operation.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ParameterSpecifications",
          "Description": "The list of Parameter Specification that must be added to the Work Master Operation.",
          "Type": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Types.ParameterSpecificationFromProcessDefinition",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "ParameterSpecificationIds",
          "Description": "The list of the primary key identifiers that have been assigned to the Parameter Specifications, which have been added.",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefinition",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefinition",
      "Description": "Adds a set of Parameter Specifications to a Work Master Operation by copying all the Parameters of a Process Definition.\r\nThis command creates one Parameter Specification per Process Definition Parameter except if this Process Definition Parameter resulted from being imported from a Catalog Parameter, see the description of the sub-command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition.\r\nThe command checks: \r\n1. if the given Process Definition with the given Process Definition Revision exists, if not error 10811 is returned;\r\n2. if there is a Revision set as current for the given Process Definition (when the Revision of the Process Definition is empty), if not error 10889 is returned;\r\n3. if the Process Definition has at least one Parameter, if not error 10897 is returned.\r\nIf the sub command AddParameterSpecificationsToWorkMasterOperationFromProcessDefinition fails to execute, this command will return it.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "WorkMasterOperationId",
          "Description": "The primary key identifier of the Work Master Operation.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ProcessDefinitionNId",
          "Description": "The natural identifier of the Process Definition.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "ProcessDefinitionRevision",
          "Description": "The revision of the Process Definition. If this field is empty, the current revision of the Process Definition is used.",
          "Type": "String"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "ParameterSpecificationIds",
          "Description": "The list of the primary key identifiers that have been assigned to the Parameter Specifications, which have been added.",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddAllParameterSpecificationsToWorkMasterOperationFromProcessDefinition"
    },
