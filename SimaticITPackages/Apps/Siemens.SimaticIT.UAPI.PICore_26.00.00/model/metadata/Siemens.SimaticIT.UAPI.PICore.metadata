    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddWorkOrderOperationToWorkOrderWithRequirements",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationToWorkOrderWithRequirements",
      "Description": "Adds a Work Order Operation with all its Requirements to a Work Order.\r\nAbout the Work Order, the command checks:\r\n1. if it exists, if not error 10300 is returned;\r\n2. if it is not Frozen, if not error 10992 is returned.\r\nThen, the command updates the Work Order by adding the new Work Order Operation. \r\nIf it fails, an error is returned by the involved subcommand: UpdateWorkOrderExtendedV2.\r\nThen the command adds the Requirements to the added Work Order Operation. \r\nIf it fails, an error is returned by the involved subcommand AddRequirementsToWorkOrderOperation.",
      "IsComplexParameter": "True",
      "ArtifactType": "Command",
      "NotSupportedBySignalRule": "True",
      "Members": [
