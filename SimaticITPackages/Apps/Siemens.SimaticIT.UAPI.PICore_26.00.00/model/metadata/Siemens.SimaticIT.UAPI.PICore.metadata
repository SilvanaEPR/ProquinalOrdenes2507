    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.DisassociateManualProcessDefinitionsFromWorkOrderOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.DisassociateManualProcessDefinitionsFromWorkOrderOperation",
      "Description": "Removes the link between the Work Order Operation and one or more Process Definitions.\r\nThe command may return the following error codes, if some checks on input parameters fail:\r\n* Error -10300: The Work Order Operation with the specified NId does not exist.\r\n* Error -10843: There is no Process Definition with NId and revision linked to the Operation.\r\n* Error -11347: The Process Definition with specified NId and Revision is not for Manual Execution.\r\n* Error -11348: The Process Definition with specified NId and Revision has been already executed.",
      "ArtifactType": "Command",
      "NotSupportedBySignalRule": "True",
      "Members": [
