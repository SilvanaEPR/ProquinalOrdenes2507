    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddWorkOrderOperationActualMaterialsByMaterialRequirements",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationActualMaterialsByMaterialRequirements",
      "Description": "Associates, to the specified Work Order Operation, the list of Actual Materials that will be used during its execution, based on the Material Requirements already associated to the same Work Order Operation.\r\nAbout the Work Order Operation, the command checks:\r\n1. if it exists, if not error 10300 is returned;\r\n2. if it is not Frozen, if not error 10992 is returned.\r\nIf there are any Material Requirements, it checks if there are already Actual Materials related to the given Work Order Operation :\r\n1. if there are none, it calls the subcommand AddWorkOrderOperationActualMaterialWithMTUs;\r\n2. if there are some, it calls the subcommand AddMTUsToWorkOrderOperationActualMaterialV2. \r\nIf it fails, an error is returned by the involved subcommand.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "WorkOrderOperationId",
          "Description": "The primary key identifier of the Work Order Operation to be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "WorkOrderOperationActualMaterialIds",
          "Description": "The list of primary key identifier of the Actual Materials that have been associated to the Work Order Operation.",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddWorkOrderOperationActualMaterialsByMaterialRequirements"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddParameterRequirementsToWorkOrderOperationFromCatalogCalculatingPercentages",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddParameterRequirementsToWorkOrderOperationFromCatalogCalculatingPercentages",
      "Description": "Adds a list of Parameter Requirements to a Work Order Operation, from a list of Catalog parameters.\r\nIf you wish to assign the real values of these limits and tolerances in the Parameter Requirements to be created, you must call another command; AddParameterRequirementsToWorkOrderOperationFromCatalog.\r\nThis command takes in account if the limits and tolerances are expressed in percents. If so, the values of the limits and tolerances are calculated. They are of the same type than the Parameter Requirement. \r\nTheir value is calculated based on their percentage value of the Target Value.\r\nChecks if :\r\n- the Work Order Operation Id exists, otherwise it throws the error 10948;\r\n- the Work Order Operation isn't frozen, otherwise it throws the error 10992;\r\nFor each element of the given ProcessParameters list, the command controls:\r\n- if the selected Catalog Parameter exists in the Catalog and if the Catalog Parameter doesn't exists already for the given Work Order Operation, otherwise it throws the error 10999;\r\n- if the ParameterValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values of the given Catalog Parameter are of the same type than its ParameterType value, otherwise it throws the error 10835;\r\n- the given Catalog Parameter ProcessDefinitionNId exists (if defined), otherwise it throws the error 11210;\r\n- the given Catalog Parameter UoMNId exists (if defined), otherwise it throws the error 10803.\r\n- if a given Catalog Parameter ProcessDefinitionRevision isn't null or empty, checks if it exists and belongs to the associated ProcessDefinitionNId, otherwise it throws the error 10895.\r\nIf any of the controls on the list elements fails, the command will not add any Parameter Requirement at all.",
      "ArtifactType": "Command",
      "NotSupportedBySignalRule": "True",
      "Members": [
        {
          "Name": "Id",
          "Description": "The identifier of the Work Order Operation.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ProcessParameters",
          "Description": "The list of the catalog parameters that must be added to the Work Order Operation ",
          "Type": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Types.ParameterSpecificationFromCatalog",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "ParameterRequirementIds",
          "Description": "The list of identifiers of the Work Order Operation Parameter Requirements that have been added.",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddParameterRequirementsToWorkOrderOperationFromCatalogCalculatingPercentages"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.ManageTaskOutcomingStatus",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.ManageTaskOutcomingStatus",
