    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddWorkOrderOperationEquipmentRequirementsToWorkOrderOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationEquipmentRequirementsToWorkOrderOperation",
      "Description": "Associates to the specified Work Order Operation the given list of Equipment Requirements. \r\nReminder: an Equipment Requirement could be a piece of Equipment, or an Equipment Group, or both. \r\nChecks if the Work Order Operation exists. Throws the error 10948 otherwise. \r\nChecks if the Work Order Operation is Frozen. Throws the error 10992 otherwise. \r\nThen for each Equipment Requirement of the given list, the command performs the following checks: \r\n1. Checks if the Sequence of the Equipment Requirement is positive, if not error 10997 is returned. \r\n2. Checks if the Planned Equipment of the Equipment Requirement exists, if not error 10996 is returned. \r\n3. Checks that either a piece of Equipment or an Equipment Group is specified, if not error 10309 is returned. \r\n4. If both an Equipment Group and the piece of Equipment are specified, checks if the piece of Equipment belongs to this group, if not error 10993 is reutrned. \r\n5. Checks if the speicfied PlannedSetupStartTime is inferior to the specified PlannedSetupEndTime, if not error 11315 otherwise. \r\n6. If the \"IsMain\" property is set to True, checks if the Equipment Group identifier is specified, if not error -10899 is returned. ",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "WorkOrderOperationId",
          "Description": "The primary key identifier of the Work Order Operation to be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "WorkOrderOperationEquipmentRequirements",
          "Description": "The list of Work Order Operation Equipment Requirements to be aassociated.",
          "Type": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Types.ReferenceWorkOrderOperationEquipmentRequirementParameterType",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "IsCommandCalledFromCreateWorkOrder",
          "Type": "Boolean"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "WorkOrderOperationEquipmentRequirementIds",
          "Description": "The list of primary key identifier of the Work Order Operation Equipment Requirement that have been associated to the Work Order Operation.",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddWorkOrderOperationEquipmentRequirementsToWorkOrderOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.DeleteWorkOrderOperationEquipmentRequirement",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.DeleteWorkOrderOperationEquipmentRequirement",
      "Description": "Deletes a Work Order Operation Equipment Requirement.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "Id",
          "Description": "The primary key identifier of the Work Order Operation Equipment Requirement that must be deleted.",
          "Type": "Guid",
          "IsMandatory": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.DeleteWorkOrderOperationEquipmentRequirement"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.UpdateWorkOrderOperationEquipmentRequirement",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.UpdateWorkOrderOperationEquipmentRequirement",
      "Description": "Updates a Work Order Operation Equipment Requirement. \r\nAssigns the value of Sequence, RequirementTag and PlannedEquipmentNId Properties from the given command inputs: if an empty value is given, it deletes an existing value.  \r\nThis is not applied for the value of the arguments EquipmentGroupNId and EquipmentNId: an empty value does not delete an existing value. \r\nOptionally flags the Equipment Requirement setting is as Main. This applies only to Equipment Requirement that specifies the EquipmentGroupNId. Any other Equipment Requirement previously set as Main will have the flag reset. \r\nWarning: if you define both the EquipmentNId and EquipmentGroupNId arguments: the command verifies if the piece of Equipment defined by the EquipmentNId is part of Equipment Group defined by the EquipmentGroupNId. If it is not the case, it throws the error 10861. \r\nChecks if the given Equipment Requirement Id exists. Throws the error 10300 otherwise. \r\nChecks if the PlannedEquipmentNId, EquipmentNId, or EquipmentGroupNId exist. Throws the error 10996 otherwise. \r\nChecks if the value of the PlannedSetupStartTime is inferior to the value of the PlannedSetupEndTime. Throws the error 11315 otherwise. \r\nIf the \"IsMain\" property is set equal to True, checks if the Equipment Group identifier is specified, If not error -10899 is returned; ",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "Id",
          "Description": "The primary key identifier of the Work Order Operation Equipment Requirement that must be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "Sequence",
          "Description": "The new value to be assigned.",
          "Type": "Int32"
        },
        {
          "Name": "RequirementTag",
          "Description": "This field is used to define a Requirement Tag. A Requirement Tag helps indicating which Requirements are related to each other.",
          "Type": "String"
        },
        {
          "Name": "PlannedEquipmentNId",
          "Description": "The natural identifier of the piece of equipment planned by the APS.",
          "Type": "String"
        },
        {
          "Name": "EquipmentGroupNId",
          "Description": "The natural identifier of the Group of Equipment where the Work Order Operation can be executed.  ",
          "Type": "String"
        },
        {
          "Name": "EquipmentNId",
          "Description": "The natural identifier of the piece of equipment where the Work Order Operation can be executed.",
          "Type": "String"
        },
        {
          "Name": "PlannedSetupStartTime",
          "Description": "The planned start time of the setup phase.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "PlannedSetupEndTime",
          "Description": "The planned end time of the setup phase.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "IsMain",
          "Description": "TRUE if the Equipment Requirement is the most relevant in the list; FALSE otherwise.\r\nThis property applies to Equipment Group only.\r\nOnly one Equipment Requirement can be set as Main.",
          "Type": "Boolean"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.UpdateWorkOrderOperationEquipmentRequirement"
    },
