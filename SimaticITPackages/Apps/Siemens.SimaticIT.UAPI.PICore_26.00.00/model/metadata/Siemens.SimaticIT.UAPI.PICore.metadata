    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddEquipmentSpecificationsToWorkMasterOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddEquipmentSpecificationsToWorkMasterOperation",
      "Description": "Adds a set of Equipment Specifications to the selected Work Master Operation \r\n\r\nThe command will: \r\n1. retrieve the Work Master Operation and the Work Master; \r\n2. check if the Work Master can be edited; \r\n3. perform consistency checks for the given Equipment and Equipment Groups; \r\n4. create an Operation Equipment Specification for each given Equipment and Equipment Group, associating them to the Work Master Operation. \r\n\r\nThe command checks if the given Work Master Operation exists, If not error -10300 is returned. \r\nThe command checks if the Work Master associated to the given Work Master Operation is not Locked for editing, If not error -10813 is returned. \r\n\r\nThe command performs the following checks for each Equipment Specification: \r\n1. if only one Equipment Specification has the IsMain Property set to True, if not error -10898 is returned; \r\n2. if an Equipment Group identifier is specified when the IsMain Property is set to True, If not error -10899 is returned; \r\n3. if either a piece of Equipment identifier or an Equipment Group identifier is specified, if not error -10309 is returned; \r\n4. if the specified piece of Equipment exists, if not, error -10859 is returned; \r\n5. if the specified Equipment Group exists, if not, error -10860 is returned; \r\n6. when both are specified, if the piece of Equipment belongs to the Equipment Group, If not error -10861 is returned. ",
      "ArtifactType": "Command",
      "NotSupportedBySignalRule": "True",
      "Members": [
        {
          "Name": "WorkMasterOperationId",
          "Description": "The primary key identifier of the Work Master Operation to which the Equipment Specifications must be added.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "EquipmentSpecifications",
          "Description": "The list of Equipment Specifications that must be added to the Work Master Operation.",
          "Type": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Types.EquipmentSpecification",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "EquipmentSpecificationIds",
          "Description": "The list of the primary key identifiers that have been assigned to the Equipment Specifications.",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddEquipmentSpecificationsToWorkMasterOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddMaterialSpecificationsToWorkMasterOperationFromMaterial",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddMaterialSpecificationsToWorkMasterOperationFromMaterial",
