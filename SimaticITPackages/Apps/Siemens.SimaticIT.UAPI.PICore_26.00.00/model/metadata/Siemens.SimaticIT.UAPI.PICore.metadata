      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.CreateMTUOperationTracking",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PITnT_OP.OPModel.Commands.CreateMTUOperationTracking",
      "Description": "Creates a MTU Operation Tracking.\r\nThe command checks:\r\n1. If the MTU Operation Type is invalid. If yes, error code -11005 is returned.\r\n2. If the Custom fields contains malformed properties. if yes, the message will contain malformed properties and error code -10312 is returned",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "OperationType",
          "Description": "The type of the operation. It is used to track manufacturing operations. Predefined values are: *CreateIdentity*, *Create*, *Delete*, *Move* and *RemoveIdentity*.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "Timestamp",
          "Description": "Time (in UTC) when the operation is started.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "ReasonCode",
          "Description": "Represents the reason why the operation has been executed.",
          "Type": "String"
        },
        {
          "Name": "User",
          "Description": "The actor which has executed the operation.",
          "Type": "String"
        },
        {
          "Name": "SourceEquipmentNId",
          "Description": "The natural identifier of the equipment where the operation starts.",
          "Type": "String"
        },
        {
          "Name": "DestinationEquipmentNId",
          "Description": "The natural identifier of the equipment where the operation ends.",
          "Type": "String"
        },
        {
          "Name": "SourceMaterialNId",
          "Description": "The natural identifier of the Material that is assigned to the MTU when the operation execution starts.",
          "Type": "String"
        },
        {
          "Name": "SourceMaterialName",
          "Description": "The name of the Material, which is assigned to the MTU when the operation execution starts.",
          "Type": "String"
        },
        {
          "Name": "SourceMaterialRevision",
          "Description": "The revision of the Material, which is assigned to the MTU when the operation execution starts.",
          "Type": "String"
        },
        {
          "Name": "SourceLotNId",
          "Description": "The natural identifier of the Material Lot when the operation starts.",
          "Type": "String"
        },
        {
          "Name": "DestinationMaterialNId",
          "Description": "The natural identifier of the Material, which is assigned to the MTU, when the operation execution ends.",
          "Type": "String"
        },
        {
          "Name": "DestinationMaterialName",
          "Description": "The name of the Material, which is assigned to the MTU, when the operation execution ends.",
          "Type": "String"
        },
        {
          "Name": "DestinationMaterialRevision",
          "Description": "The revision of the Material, which is assigned to the MTU, when the operation execution ends.",
          "Type": "String"
        },
        {
          "Name": "DestinationLotNId",
          "Description": "The natural identifier of the Material Lot when the operation is completed.",
          "Type": "String"
        },
        {
          "Name": "SourceQuantity",
          "Description": "The quantity of Material when the operation starts.",
          "Type": "Decimal"
        },
        {
          "Name": "DestinationQuantity",
          "Description": "The quantity of Material when the operation ends.",
          "Type": "Decimal"
        },
        {
          "Name": "SourceMTUId",
          "Description": "The identifier of the MTU when the operation starts.",
          "Type": "Guid"
        },
        {
          "Name": "SourceMTUNId",
          "Description": "The natural identifier of the MTU when the operation starts.",
          "Type": "String"
        },
        {
          "Name": "DestinationMTUId",
          "Description": "The identifier of the MTU when the operation ends.",
          "Type": "Guid"
        },
        {
          "Name": "DestinationMTUNId",
          "Description": "The natural identifier of the MTU when the operation ends.",
          "Type": "String"
        },
        {
          "Name": "SourceUoMNId",
          "Description": "The natural identifier of the Unit of Measure when the operation starts.",
          "Type": "String"
        },
        {
          "Name": "DestinationUoMNId",
          "Description": "The natural identifier of the Unit of Measure used when the operation ends.",
          "Type": "String"
        },
        {
          "Name": "SourceOrderNId",
          "Description": "The natural identifier of the Order when the operation starts.",
          "Type": "String"
        },
        {
          "Name": "SourceWorkOrderNId",
          "Description": "The natural identifier of the Work Order when the operation starts.",
          "Type": "String"
        },
        {
          "Name": "SourceWorkOrderOperationNId",
          "Description": "The natural identifier of the Work Order Operation when the operation starts.",
          "Type": "String"
        },
        {
          "Name": "SourceActualMaterialSequence",
          "Description": "Specifies the sequence number corresponding to the actual material setting when the operation starts.",
          "Type": "Int32"
        },
        {
          "Name": "DestinationOrderNId",
          "Description": "The natural identifier of the Order when the operation ends.",
          "Type": "String"
        },
        {
          "Name": "DestinationWorkOrderNId",
          "Description": "The natural identifier of the Work Order when the operation ends.",
          "Type": "String"
        },
        {
          "Name": "DestinationWorkOrderOperationNId",
          "Description": "The natural iIdentifier of the Work Order Operation when the operation ends.",
          "Type": "String"
        },
        {
          "Name": "DestinationActualMaterialSequence",
          "Description": "Specifies the sequence number corresponding to the actual material setting when the operation ends.",
          "Type": "Int32"
        },
        {
          "Name": "Properties",
          "Description": "The list of custom properties. This properties allow to enrich the information that are going to be traced when an operation is executed.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.PropertyParameterTypeCreate",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "MTUTrackingInconsistencies",
          "Description": "The list of errors and alerts that may have occurred during the execution of the manufacturing operation.",
          "Type": "Siemens.SimaticIT.UAPI.OperationalData.PITnT_OP.OPModel.Types.MTUTrackingInconsistencyParameterType",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        },
        {
          "Name": "SourceMTUAggregate",
          "Description": " List of string values, containing the NId of the Source MTU Aggregate. In case of nested MTU Aggregates, it contains the NIds of all the MTU Aggregates, in the order they are nested. ",
          "Type": "String",
          "IsCollection": "True"
        },
        {
          "Name": "DestinationMTUAggregate",
          "Description": "List of string values, containing the NId of the Destination MTU Aggregate. In case of nested MTU Aggregates, it contains the NIds of all the MTU Aggregates, in the order they are nested. ",
          "Type": "String",
          "IsCollection": "True"
        }
      ],
      "ResponseMembers": [
