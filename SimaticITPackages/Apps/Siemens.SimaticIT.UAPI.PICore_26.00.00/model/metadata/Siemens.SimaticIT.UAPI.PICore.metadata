      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.UpdateOperationParameterSpecification",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.UpdateOperationParameterSpecification",
      "Description": "Updates a Parameter Specification of the given Work Master Operation.\r\nApart from Id, each input argument is respective to one property of a Parameter Specification.\r\nThe command only updates the properties of the Parameter Specification given as input for which you pass a value. If you pass no value for an argument (other than Id), the respective property of the Parameter Specification is unchanged by the command.\r\nChecks if the given Id exists, otherwise it throws the error 10824.\r\nChecks if the Work Master Operation associated to the given Work Master Operation Parameter Specification exists, otherwise it throws the error 10300.\r\nChecks if the Work Master associated to the given Work Master Operation Parameter Specification exists, otherwise it throws the error 10812. If it exists but it is locked, it throws the error 10813.\r\nChecks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835.\r\nIf the given Process Definition is different from the Process Definition defined in the Parameter Specification, the command checks:\r\n- if the given ProcessDefinitionNId exists, otherwise it throws the error 11210;\r\n- if the given argument SetToUseCurrentRevisionOfProcessDefinition is set to true, the property ProcessDefinitionRevision of the Parameter Specification will be deleted; if not, the command controls that the given argument ProcessDefinitionRevision exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "Id",
          "Description": "The identifier of the Work Master Operation Parameter Specification to be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ParameterTargetValue",
          "Description": "The new target value of the Work Master Operation Parameter Specification.",
          "Type": "String"
        },
        {
          "Name": "ParameterLimitHigh",
          "Description": "Highest limit of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterLimitLow",
          "Description": "Lowest limit of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterToleranceHigh",
          "Description": "Highest tolerance of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterToleranceLow",
          "Description": "Lowest tolerance of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "IsScaled",
          "Description": "Specifies if the target value must be scaled (according to the Order or Work Master/Work Order quantity) before to start the process.",
          "Type": "Boolean"
        },
        {
          "Name": "IsLimitsInPercentage",
          "Description": "Defines if the limits and tolerances are expressed in % instead of the value of ParameterUoMNId.",
          "Type": "Boolean"
        },
        {
          "Name": "ProcessDefinitionNId",
          "Description": "The Process Definition corresponding to the Process Definition of deviation to launch if any limit is reached during the process.",
          "Type": "String"
        },
        {
          "Name": "ProcessDefinitionRevision",
          "Description": "Revision of the Process Definition. An empty field implies the use of the current revision of the Process Definition.",
          "Type": "String"
        },
        {
          "Name": "SetToUseCurrentRevisionOfProcessDefinition",
          "Description": "Indicates that the current revision of the given Process Definition will be retrieved during runtime.  If set to true, any previous value of the property ProcessDefinitionRevision will be deleted. ",
          "Type": "Boolean"
        },
        {
          "Name": "TraceChangeDetails",
          "Description": "Specifies if the updates to the Parameters of Work Order or Work Order Operation, must be traced to generate Production History Record.",
          "Type": "Boolean"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.UpdateOperationParameterSpecification"
    },
