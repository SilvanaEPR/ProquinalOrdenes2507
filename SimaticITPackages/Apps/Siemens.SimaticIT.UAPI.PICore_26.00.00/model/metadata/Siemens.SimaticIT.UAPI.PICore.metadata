      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.CreateOrder",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PIOrder_OP.OPModel.Commands.CreateOrder",
      "Description": "Creates an Order.\r\nWhen the Order is created, the command raises the OrderCreated event.\r\nThe command checks the Order:\r\n1. if it does not exist, error 11205 is returned if it does;\r\n2. if the Quantity is not < 0, if so error 10849 is returned;\r\n3. if the UoM is defined but not the Quantity, if not error 10008 is returned;\r\n4. if the ActualStartTime >= ActualEndTime, if not error 10979 is returned; \r\n5. if PlannedStartTime >= PlannedEndTime, if not error 11201 is returned;\r\n6. if the StateMachine exists, if not error 10300 is returned;\r\n7. if the StateMachine has at least one Status, if not error 11320 is returned;\r\n8. if the StateMachine has an initial Status, if not the error 10984 is returned.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "NId",
          "Description": "The natural key identifier of the Order.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "ActualStartTime",
          "Description": "The date and time at which the Order is started.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "ActualEndTime",
          "Description": "The date and time at which the Order is completed.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "Description",
          "Description": "Additional information on the Order.",
          "Type": "String"
        },
        {
          "Name": "EquipmentNId",
          "Description": "The natural identifier of the Equipment.",
          "Type": "String"
        },
        {
          "Name": "MaterialNId",
          "Description": "The natural identifier of the Material.",
          "Type": "String"
        },
        {
          "Name": "MaterialRevision",
          "Description": "The revision of the Material. An empty field implies the usage of the current revision.",
          "Type": "String"
        },
        {
          "Name": "Name",
          "Description": "The name assigned to the Order.",
          "Type": "String"
        },
        {
          "Name": "PlannedEndTime",
          "Description": "The date and time at which the Order is supposed to be completed.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "PlannedStartTime",
          "Description": "The date and time at which the Order is supposed to be started.",
          "Type": "DateTimeOffset"
        },
        {
          "Name": "Quantity",
          "Description": "The quantity of Material.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.QuantityParameterType",
          "MemberArtifactType": "ParameterType"
        },
        {
          "Name": "StateMachineNId",
          "Description": "The natural identifier of the Order State Machine.",
          "Type": "String"
        },
        {
          "Name": "Type",
          "Description": "Type of activity.",
          "Type": "String"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "OrderId",
          "Description": "The natural key identifier of the Order that has been created.",
          "Type": "Guid"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.CreateOrder"
    },
