    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.CreateCatalogueParameter",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.CreateCatalogueParameter",
      "Description": "Creates a new instance of a catalog parameter.\r\nYou should specify the Unit of Measure of the Parameter you are defining only if you set ParameterType to Quantity. Choosing another ParameterType and setting the ParameterUoMNId value could lead to inconsistencies when the parameter is imported as Process Definition Parameter from catalog.\r\nChecks if the given ParameterNId exists, otherwise throws the error 10801. If it exists, it verifies that there is only one respective catalog parameter, otherwise it throws the error 10802.\r\nIf the value of ParameterType is \"Quantity\", it verifies that there is a Unit of Measure; otherwise it throws the error 10007.\r\nChecks if the given ParameterUoMNId exists, otherwise it throws the error 10803.\r\nChecks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835. \r\nIf the given ProcessDefinitionNId isn't null or empty, checks if it exists, otherwise it throws the error 11210.\r\nIf the given ProcessDefinitionRevision isn't null or empty, the command controls that this value exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "ParameterNId",
          "Description": "The natural identifier of the catalog parameter.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "ParameterName",
          "Description": "The name assigned to the catalog parameter.",
          "Type": "String"
        },
        {
          "Name": "ParameterDescription",
          "Description": "Additional information on the catalog parameter.",
          "Type": "String"
        },
        {
          "Name": "ParameterTargetValue",
          "Description": "The default target value of the parameter.",
          "Type": "String"
        },
        {
          "Name": "ParameterType",
          "Description": "The data type of the parameter. If empty the data type is set to _String_",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.SupportedTypes",
          "MemberArtifactType": "Enum"
        },
        {
          "Name": "ParameterUoMNId",
          "Description": "The Unit of Measure used to express the target value of the parameter.",
          "Type": "String"
        },
        {
          "Name": "ParameterLimitLow",
          "Description": "Lowest limit of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterToleranceLow",
          "Description": "Lowest tolerance of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterToleranceHigh",
          "Description": "Highest tolerance of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterLimitHigh",
          "Description": "Highest limit of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "IsScaled",
          "Description": "Specifies if the target value must be scaled (according to the Order or Work Master/Work Order quantity) before to start the process.",
          "Type": "Boolean"
        },
        {
          "Name": "IsLimitsInPercentage",
          "Description": "Defines if the limits and tolerances are expressed in % instead of the value of ParameterUoMNId.",
          "Type": "Boolean"
        },
        {
          "Name": "ProcessDefinitionNId",
          "Description": "The Process Definition corresponding to the Process Definition of deviation to launch if any limit is reached during the process.",
          "Type": "String"
        },
        {
          "Name": "ProcessDefinitionRevision",
          "Description": "Revision of the Process Definition. An empty field implies the use of the current revision of the Process Definition.",
          "Type": "String"
        },
        {
          "Name": "SetToUseCurrentRevisionOfProcessDefinition",
          "Description": "Indicates that the current revision of the given Process Definition will be retrieved during runtime.  If set to true, any previous value of the property ProcessDefinitionRevision will be deleted.",
          "Type": "Boolean"
        },
        {
          "Name": "TraceChangeDetails",
          "Description": "Specifies if the updates to the Parameters of Work Order or Work Order Operation, must be traced to generate Production History Record.",
          "Type": "Boolean"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "ParameterId",
          "Description": "The identifier of the catalog parameter that has been created.",
          "Type": "Guid"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.CreateCatalogueParameter"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.UpdateCatalogueParameter",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.UpdateCatalogueParameter",
      "Description": "Updates an existing instance of a catalog parameter.\r\nIf the value of an input parameter is empty or null, the respective property of the catalog parameter is not changed.\r\nChecks if the given ParameterId exists, otherwise it throws the error 10800.\r\nChecks if the given ParameterTargetValue, ParameterToleranceLow, ParameterToleranceHigh, ParameterLimitLow, ParameterLimitHigh values are of the same type than the given ParameterType value, otherwise it throws the error code 10835. \r\nIf the given Process Definition is different from an already defined Process Definition of the catalog parameter, the command checks:\r\n- if the given ProcessDefinitionNId exists, otherwise it throws the error 11210;\r\n- if the given argument SetToUseCurrentRevisionOfProcessDefinition is set to true, the catalog parameter property ProcessDefinitionRevision will be deleted; if not, the command controls that the given argument ProcessDefinitionRevision exists for the given ProcessDefinitionNId; otherwise it throws the error 10895.\r\nChecks if the given ParameterUoMNId exists, otherwise it throws the error 10803.\r\nIf the value of ParameterType is \"Quantity\", it verifies that there is a Unit of Measure; otherwise it throws the error 10007.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "ParameterId",
          "Description": "The identifier of the catalog parameter.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ParameterName",
          "Description": "The name assigned to the parameter.",
          "Type": "String"
        },
        {
          "Name": "ParameterDescription",
          "Description": "Additional information on the parameter.",
          "Type": "String"
        },
        {
          "Name": "ParameterTargetValue",
          "Description": "The default target value of the parameter.",
          "Type": "String"
        },
        {
          "Name": "ParameterType",
          "Description": "The data type of the parameter value.",
          "Type": "Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.SupportedTypes",
          "MemberArtifactType": "Enum"
        },
        {
          "Name": "ParameterUoMNId",
          "Description": "The Unit of Measure used to express the catalog parameter target value.",
          "Type": "String"
        },
        {
          "Name": "ParameterLimitLow",
          "Description": "Lowest limit of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterToleranceLow",
          "Description": "Lowest tolerance of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterToleranceHigh",
          "Description": "Highest tolerance of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "ParameterLimitHigh",
          "Description": "Highest limit of the parameter value.",
          "Type": "String"
        },
        {
          "Name": "IsScaled",
          "Description": "Specifies if the target value must be scaled (according to the Order or Work Master/Work Order quantity) before to start the process.",
          "Type": "Boolean"
        },
        {
          "Name": "IsLimitsInPercentage",
          "Description": "Defines if the limits and tolerances are expressed in % instead of the value of ParameterUoMNId.",
          "Type": "Boolean"
        },
        {
          "Name": "ProcessDefinitionNId",
          "Description": "The Process Definition corresponding to the Process Definition of deviation to launch if any limit is reached during the process.",
          "Type": "String"
        },
        {
          "Name": "ProcessDefinitionRevision",
          "Description": "Revision of the Process Definition. An empty field implies the use of the current revision of the Process Definition.",
          "Type": "String"
        },
        {
          "Name": "SetToUseCurrentRevisionOfProcessDefinition",
          "Description": "Indicates that the current revision of the given Process Definition will be retrieved during runtime.  If set to true, any previous value of the property ProcessDefinitionRevision will be deleted.",
          "Type": "Boolean"
        },
        {
          "Name": "TraceChangeDetails",
          "Description": "Specifies if the updates to the Parameters of Work Order or Work Order Operation, must be traced to generate Production History Record.",
          "Type": "Boolean"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "Id",
          "Description": "The identifier of the catalog parameter.",
          "Type": "Guid"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.UpdateCatalogueParameter"
    },
