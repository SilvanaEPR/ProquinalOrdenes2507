    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddProcessParametersToWorkMasterHeader",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Commands.AddProcessParametersToWorkMasterHeader",
      "Description": "Adds a set of process Parameters, taken from the Catalog, to a Work Master Header. \r\nFor each given Parameter, it is possible to override the Target Value.\r\nThe Command checks:\r\n1. if the given WorkMaster exists, if not error 10812 is returned;\r\n2. if the given WorkMaster is not Locked, if so error 10813 is returned;\r\n3. if the given process Parameters exist as catalog Parameters, if not error 10814 is returned;\r\n4. if the catalog Parameters are not already linked to the given WorkMaster, if so error 10836 is returned;\r\n5. if the given process Parameter values are compatible with the data type, if not the error 10836 is returned.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "WorkMasterId",
          "Description": "The primary key identifier of the Work Master.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ProcessParameters",
          "Description": "The list of process parameters to be added to the Work Master in order to build the Work Master Header information.",
          "Type": "Siemens.SimaticIT.UAPI.MasterData.PICore_MS.MSModel.Types.WorkMasterCatalogueParameter",
          "MemberArtifactType": "ParameterType",
          "IsCollection": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "ProcessParameterIds",
          "Description": "The list of identifiers of the parameters that have been added to the Work Master Header.",
          "Type": "Guid",
          "IsCollection": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddProcessParametersToWorkMasterHeader"
    },
