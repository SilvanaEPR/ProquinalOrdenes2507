    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddWorkOrderOperationByWorkMasterOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationByWorkMasterOperation",
      "Description": "Adds a Work Order Operation, together with its Requirements, to a Work Order, given the data of a Work Master Operation, which has been made available for Work Order enrichment.\r\nChecks if the Work Order exists, otherwise it throws the error 10300.\r\nChecks if the Work Order is frozen, otherwise it throws the error 10992.\r\nChecks if the Work Master exists, otherwise it throws the error 10300.\r\nChecks if the State Machine (of the given Work Master Operation) exists, and that this State Machine has an initial status, otherwise it throws the error 10984.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "WorkMasterNId",
          "Description": "The Work Master whose operation has to be used as template for the Work Order Operation",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "WorkMasterOperationNId",
          "Description": "The Operation associated to the given Work Master, to be used as template for the Work Order Operation",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "NId",
          "Description": "The Work Order Operation to be added.",
          "Type": "String",
          "IsMandatory": "True"
        },
        {
          "Name": "Name",
          "Description": "The name of the Work Order Operation to be added.",
          "Type": "String"
        },
        {
          "Name": "Description",
          "Description": "The description of the Work Order Operation to be added.",
          "Type": "String"
        },
        {
          "Name": "Sequence",
          "Description": "The sequence of the Work Order Operation to be added.",
          "Type": "Int32",
          "IsMandatory": "True"
        },
        {
          "Name": "Id",
          "Description": "The primary key identifier of the Work Order to be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "WorkMasterRevision",
          "Description": "The Work Master Revision whose operation has to be used as template for the Work Order Operation",
          "Type": "String",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "WorkOrderOperationId",
          "Description": "The primary key identifier of the Work Order Operation that has been added to the Work Order.",
          "Type": "Guid"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddWorkOrderOperationByWorkMasterOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddWorkOrderOperationActualEquipmentToWorkOrderOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationActualEquipmentToWorkOrderOperation",
      "Description": "Creates a new Actual Equipment of a Work Order Operation. The to-be-created WoOp Actual Equipment have properties that are initiated with the values of the Equipment Requirement that it is related to.\r\nThe commands verifies that:\r\n- the given WorkOrderOperationEquipmentRequirementId exists, otherwise it throws the error 11225;\r\n- the given Actual Equipment NId exists, otherwise it throws the error code 10859;\r\n- the related Work Order Operation isn't frozen, otherwise it throws the error code 10992.\r\nThe command creates a new WoOp Actual Equipment with the given equipment and the data of the given Equipment Requirement.\r\nIf an Actual Equipment already exists with the same data, no Actual Equipment is added and the command throws the error 11224.   \r\nAn Actual Equipment already exists when its property ActualEquipmentNId equals the given argument and its properties match the fields of the given Equipment Requirement.\r\nThe command returns an identifier of the Work Order Operation Actual Equipment that was created.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "WorkOrderOperationEquipmentRequirementId",
          "Description": "The primary key identifier of the Work Order Operation Equipment Requirement related to the to-be-created Actual Equipment.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "ActualEquipmentNId",
          "Description": "The natural key identifier of the piece of equipment which was actually used.",
          "Type": "String",
          "IsMandatory": "True"
        }
      ],
      "ResponseMembers": [
        {
          "Name": "WorkOrderOperationActualEquipmentId",
          "Description": "The primary key identifier of the Actual Equipment that was created.",
          "Type": "Guid"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddWorkOrderOperationActualEquipmentToWorkOrderOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddWorkOrderOperationActualEquipmentToWorkOrderOperationFromTask",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddWorkOrderOperationActualEquipmentToWorkOrderOperationFromTask",
      "Description": "Retrieves the EquipmentNId as saved in the EquipmentNId property of the given Task.\r\nChecks that the Task exists, otherwise throws the Error 11309.\r\nIf the Task has its property Assign\\_From_Equipment\\_Requirement set to true, the command searches for eventual related Equipment Requirements of the Work Order Operation related to the Task.\r\nOnly if the property Assign\\_From\\_Equipment\\_Requirement is set to true, it calls the command AddWorkOrderOperationActualEquipmentToWorkOrderOperation that will create the Actual Equipment.\r\nIf the result of the AddWorkOrderOperationActualEquipmentToWorkOrderOperation command returns an error code (that isn't equal to error code 11224), it throws the error 11226.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "TaskId",
          "Description": "The primary key identifier of the given Task.",
          "Type": "Guid",
          "IsMandatory": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddWorkOrderOperationActualEquipmentToWorkOrderOperationFromTask"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.AddRequirementsByWorkMasterOperationToWorkOrderOperation",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.AddRequirementsByWorkMasterOperationToWorkOrderOperation",
      "Description": "Adds a set of Requirements to a Work Order Operation from the Specifications of the given Work Master Operation.\r\nFor each command arguments IncludeOperationEquipmentSpecifications, IncludeOperationMaterialSpecifications, and IncludeOperationParameterSpecifications, if equal to true, the command respectively retrieves the Equipment Specifications, the Material Specifications, and/or the Parameter Specifications of the given Work Master Operation.\r\nThe commands checks the given Work Order Operation, testing:\r\n1. if it exists, if not error 10300 is raised;\r\n2. if it is Frozen, if not error 10992 is raised.\r\nThen it checks if the Work Master Operation exists: if not error 10300 is raised.\r\nIf IncludeOperationParameterSpecifications is true, the command calls the command CalculateScalingRatio.\r\nIf no error thrown, it calls the subcommand AddRequirementsToWorkOrderOperation to create all Work Order Operation Requirements.",
      "ArtifactType": "Command",
      "Members": [
        {
          "Name": "Id",
          "Description": "The primary key identifier of the Work Order Operation to be updated.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "WorkMasterOperationId",
          "Description": "The primary key of the Work Master Operation providing the specifications set to be used to create requirements.",
          "Type": "Guid",
          "IsMandatory": "True"
        },
        {
          "Name": "IncludeOperationParameterSpecifications",
          "Description": "Specifies whether the Operation Parameter Specification provided by he given Work Master Operation are to be used to create the correspondig requirements.",
          "Type": "Boolean",
          "IsMandatory": "True"
        },
        {
          "Name": "IncludeOperationMaterialSpecifications",
          "Description": "Specifies whether the Operation Material Specification provided by he given Work Master Operation are to be used to create the correspondig requirements.",
          "Type": "Boolean",
          "IsMandatory": "True"
        },
        {
          "Name": "IncludeOperationEquipmentSpecifications",
          "Description": "Specifies whether the Operation Equipment Specification provided by he given Work Master Operation are to be used to create the correspondig requirements.",
          "Type": "Boolean",
          "IsMandatory": "True"
        }
      ],
      "PublishedFullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.Published.AddRequirementsByWorkMasterOperationToWorkOrderOperation"
    },
    {
      "FullInfo": "Siemens.SimaticIT.UAPI.PICore.PICore.PIPOMModel.Commands.DeleteWorkOrderOperationActualEquipment",
      "ReferencedFullInfo": "Siemens.SimaticIT.UAPI.OperationalData.PICore_OP.OPModel.Commands.DeleteWorkOrderOperationActualEquipment",
      "Description": " Deletes an Actual Equipment (of a Work Order Operation). This command checks if the given Actual Equipment exists. Otherwise it throws the error 11313.",
