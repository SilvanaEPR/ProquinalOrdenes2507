uced material (Visual Characteristics). Example: you are inspecting a car and checking whether scuff marks are detected in the car paint.\r\n\r\nHow Quality Characteristics must be acquired at runtime is defined by the Inspection Definitions that are associated with Quality Characteristics."},"SystemAnnotations":[],"CustomAnnotations":[{"$id":"1706","$type":"DslTerminalNode","Text":"@Guid(86439faf-face-4130-93fc-deaabd3d8df2)","FullInfo":"@Guid(86439faf-face-4130-93fc-deaabd3d8df2)","InfoMap":{"$id":"1707","FullIdObj":{"$id":"1708","$type":"IdentificableText","Name":"@Guid(86439faf-face-4130-93fc-deaabd3d8df2)","FullInfo":"@Guid(86439faf-face-4130-93fc-deaabd3d8df2)","TypeResolved":""}},"FullIdObj":{"$ref":"1708"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"7"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(86439faf-face-4130-93fc-deaabd3d8df2)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(86439faf-face-4130-93fc-deaabd3d8df2)"},{"$id":"1709","$type":"DslTerminalNode","Text":"@GuidRef(d85b6a83-0a46-4c2e-a180-8ab017c780e1, aba53a74-36af-4d42-8529-18eccd45cd34)","FullInfo":"@GuidRef(d85b6a83-0a46-4c2e-a180-8ab017c780e1, aba53a74-36af-4d42-8529-18eccd45cd34)","InfoMap":{"$id":"1710","FullIdObj":{"$id":"1711","$type":"IdentificableText","Name":"@GuidRef(d85b6a83-0a46-4c2e-a180-8ab017c780e1, aba53a74-36af-4d42-8529-18eccd45cd34)","FullInfo":"@GuidRef(d85b6a83-0a46-4c2e-a180-8ab017c780e1, aba53a74-36af-4d42-8529-18eccd45cd34)","TypeResolved":""}},"FullIdObj":{"$ref":"1711"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"7"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@GuidRef(d85b6a83-0a46-4c2e-a180-8ab017c780e1, aba53a74-36af-4d42-8529-18eccd45cd34)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@GuidRef(d85b6a83-0a46-4c2e-a180-8ab017c780e1, aba53a74-36af-4d42-8529-18eccd45cd34)"}],"TagAnnotations":[],"_text":"CharacteristicSpecification","Siemens.SimaticIT.DSL.Plug