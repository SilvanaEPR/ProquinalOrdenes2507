                </command><command>
                        <name>Siemens.SimaticIT.UAPI.MasterData.PIEquipment_MS.MSModel.Commands.UpdateProcessAdditionalPropertiesConfiguration</name>
                        <shortname>UpdateProcessAdditionalPropertiesConfiguration</shortname>
                        <description>Updates extended process properties for the given Equipment Configuration. If none exists, it creates empty ones. The command performs the following checks: 1. if the given Equipment Configuration Id exists, if not error 10300 is returned; 2. if the given Equipment Configuration is not Frozen, if it is error 10992 is returned; 3. if the given UoMNId exists, if not error 10001 is returned; 4. if the given AllowedMaterialNId exists, if not error 10806 is returned; 5. if the given AllowedMaterialGroupNId exists, if not error 10842 is returned; 6. if the given AllocationStateMachineNId exists, if not error 11210 is returned; 7. if the given AllowedMaterialNId and AllowedMaterialGroupNId input are not both defined, if so error 11322 is returned; 8. if the given MainStateMachineNId exists, if not error 11210 is returned.</description>
                        <assembly>Siemens.SimaticIT.UAPI.MasterData.PIEquipment_MS.MSModel.Commands, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</assembly>
                        <dotnetcommandtype></dotnetcommandtype>
                        <commandtype>Undefined</commandtype>
                        <domain>MasterData</domain>
                        <visibility>Protected</visibility>
                        <composite>false</composite>
                        <taglist>
                        </taglist>
                        <securable>true</securable>
                        <handlers>
                                <handler>
                                        <name>Siemens.SimaticIT.UAPI.MasterData.PIEquipment_MS.MSModel.Commands.UpdateProcessAdditionalPropertiesConfigurationHandlerShell</name>
                                        <assembly>Siemens.SimaticIT.UAPI.PIEquipment_MS.CommandHandler, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</assembly>
                                        <target_cpu>AnyCPU</target_cpu>
