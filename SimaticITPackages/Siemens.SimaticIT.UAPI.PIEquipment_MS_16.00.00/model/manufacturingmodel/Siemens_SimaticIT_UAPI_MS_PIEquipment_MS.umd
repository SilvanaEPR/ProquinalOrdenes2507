},{"$id":"878","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"879","$type":"DslTerminalNode","Text":"string","FullInfo":"String","InfoMap":{"$id":"880","FullIdObj":{"$id":"881","$type":"IdentificableTypeSystem","Name":"string","FullInfo":"String","TypeResolved":""}},"FullIdObj":{"$ref":"881"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":124,"CharPositionInLine":27,"_text":"string","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"string"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Input declaration commands","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"882","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"883","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"884","$type":"DslTerminalNode","Text":"CreateProcessAdditionalPropertiesConfiguration","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PIEquipment_MS.MSModel.Commands.CreateProcessAdditionalPropertiesConfiguration","InfoMap":{"$id":"885","FullIdObj":{"$id":"886","$type":"IdentificableObject","Guid":"bd906083-bcfa-49b1-a68d-c8430d1ff10a","Name":"CreateProcessAdditionalPropertiesConfiguration","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PIEquipment_MS.MSModel.Commands.CreateProcessAdditionalPropertiesConfiguration","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"412"}}},"FullIdObj":{"$ref":"886"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"409"},"Documentation":{"$id":"887","$type":"DslTerminalNode","Text":"Creates extended process properties for the given Equipment Configuration if none exists. Each property will affect the behavior of the piece of Equipment respective to this Equipment Configuration.\r\nList of properties: \r\n   - MinQuantity: The smallest quantity the piece of Equipment can handle.\r\n   - MinLevel: The smallest quantity which is recommended for the piece of Equipment.\r\n   - Quantity: The quantity that is stored in the piece of Equipment.\r\n   - MaxLevel: The biggest quantity recommended for the piece of Equipment.\r\n   - MaxQuantity: The biggest quantity the piece of Equipment can handle.\r\n   - IsSingleLot: A flag that indicates if the piece of Equipment should only handle a Material issued from a single lot.\r\n   - IsSingleMaterial: A flag that indicates if the piece of Equipment should only handle one kind of Material.\r\n   - AllocationStateMachineNId: The identifier of the State Machine on which the system will rely on, in order to manage the allocation state of the piece of Equipment. \r\n   - AllowedMaterialGroupNId: The Material Group allowed to be used with the piece of Equipment.\r\n   - AllowedMaterialNId: The Material allowed to be used with the piece of Equipment. \r\nThe command performs a check on the Equipment Configuration Id to see if it exists.\r\nIf not, error 11214 is returned.","FullInfo":"Creates extended process properties for the given Equipment Configuration if none exists. Each property will affect the behavior of the piece of Equipment respective to this Equipment Configuration.\r\nList of properties: \r\n   - MinQuantity: The smallest quantity the piece of Equipment can handle.\r\n   - MinLevel: The smallest quantity which is recommended for the piece of Equipment.\r\n   - Quantity: The quantity that is stored in the piece of Equipment.\r\n   - MaxLevel: The biggest quantity recommended for the piece of Equipment.\r\n   - MaxQuantity: The biggest quantity the piece of Equipment can handle.\r\n   - IsSingleLot: A flag that indicates if the piece of Equipment should only handle a Material issued from a single lot.\r\n   - IsSingleMaterial: A flag that indicates if the piece of Equipment should only handle one kind of Material.\r\n   - AllocationStateMachineNId: The identifier of the State Machine on which the system will rely on, in order to manage the allocation state of the piece of Equipment. \r\n   - AllowedMaterialGroupNId: The Material Group allowed to be used with the piece of Equipment.\r\n   - AllowedMaterialNId: The Material allowed to be used with the piece of Equipment. \r\nThe command performs a check on the Equipment Configuration Id to see if it exists.\r\nIf not, error 11214 is returned.","InfoMap":{"$id":"888","FullIdObj":{"$id":"889","$type":"IdentificableText","Name":"Creates extended process properties for the given Equipment Configuration if none exists. Each property will affect the behavior of the piece of Equipment respective to this Equipment Configuration.\r\nList of properties: \r\n   - MinQuantity: The smallest quantity the piece of Equipment can handle.\r\n   - MinLevel: The smallest quantity which is recommended for the piece of Equipment.\r\n   - Quantity: The quantity that is stored in the piece of Equipment.\r\n   - MaxLevel: The biggest quantity recommended for the piece of Equipment.\r\n   - MaxQuantity: The biggest quantity the piece of Equipment can handle.\r\n   - IsSingleLot: A flag that indicates if the piece of Equipment should only handle a Material issued from a single lot.\r\n   - IsSingleMaterial: A flag that indicates if the piece of Equipment should only handle one kind of Material.\r\n   - AllocationStateMachineNId: The identifier of the State Machine on which the system will rely on, in order to manage the allocation state of the piece of Equipment. \r\n   - AllowedMaterialGroupNId: The Material Group allowed to be used with the piece of Equipment.\r\n   - AllowedMaterialNId: The Material allowed to be used with the piece of Equipment. \r\nThe command performs a check on the Equipment Configuration Id to see if it exists.\r\nIf not, error 11214 is returned.","FullInfo":"Creates extended process properties for the given Equipment Configuration if none exists. Each property will affect the behavior of the piece of Equipment respective to this Equipment Configuration.\r\nList of properties: \r\n   - MinQuantity: The smallest quantity the piece of Equipment can handle.\r\n   - MinLevel: The smallest quantity which is recommended for the piece of Equipment.\r\n   - Quantity: The quantity that is stored in the piece of Equipment.\r\n   - MaxLevel: The biggest quantity recommended for the piece of Equipment.\r\n   - MaxQuantity: The biggest quantity the piece of Equipment can handle.\r\n   - IsSingleLot: A flag that indicates if the piece of Equipment should only handle a Material issued from a single lot.\r\n   - IsSingleMaterial: A flag that indicates if the piece of Equipment should only handle one kind of Material.\r\n   - AllocationStateMachineNId: The identifier of the State Machine on which the system will rely on, in order to manage the allocation state of the piece of Equipment. \r\n   - AllowedMaterialGroupNId: The Material Group allowed to be used with the piece of Equipment.\r\n   - AllowedMaterialNId: The Material allowed to be used with the piece of Equipment. \r\nThe command performs a check on the Equipment Configuration Id to see if it exists.\r\nIf not, error 11214 is returned.","TypeResolved":""}},"FullIdObj":{"$ref":"889"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Creates extended process properties for the given Equipment Configuration if none exists. Each property will affect the behavior of the piece of Equipment respective to this Equipment Configuration.\r\nList of properties: \r\n   - MinQuantity: The smallest quantity the piece of Equipment can handle.\r\n   - MinLevel: The smallest quantity which is recommended for the piece of Equipment.\r\n   - Quantity: The quantity that is stored in the piece of Equipment.\r\n   - MaxLevel: The biggest quantity recommended for the piece of Equipment.\r\n   - MaxQuantity: The biggest quantity the piece of Equipment can handle.\r\n   - IsSingleLot: A flag that indicates if the piece of Equipment should only handle a Material issued from a single lot.\r\n   - IsSingleMaterial: A flag that indicates if the piece of Equipment should only handle one kind of Material.\r\n   - AllocationStateMachineNId: The identifier of the State Machine on which the system will rely on, in order to manage the allocation state of the piece of Equipment. \r\n   - AllowedMaterialGroupNId: The Material Group allowed to be used with the piece of Equipment.\r\n   - AllowedMaterialNId: The Material allowed to be used with the piece of Equipment. \r\nThe command performs a check on the Equipment Configuration Id to see if it exists.\r\nIf not, error 11214 is returned.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Creates extended process properties for the given Equipment Configuration if none exists. Each property will affect the behavior of the piece of Equipment respective to this Equipment Configuration.\r\nList of properties: \r\n   - MinQuantity: The smallest quantity the piece of Equipment can handle.\r\n   - MinLevel: The smallest quantity which is recommended for the piece of Equipment.\r\n   - Quantity: The quantity that is stored in the piece of Equipment.\r\n   - MaxLevel: The biggest quantity recommended for the piece of Equipment.\r\n   - MaxQuantity: The biggest quantity the piece of Equipment can handle.\r\n   - IsSingleLot: A flag that indicates if the piece of Equipment should only handle a Material issued from a single lot.\r\n   - IsSingleMaterial: A flag that indicates if the piece of Equipment should only handle one kind of Material.\r\n   - AllocationStateMachineNId: The identifier of the State Machine on which the system will rely on, in order to manage the allocation state of the piece of Equipment. \r\n   - AllowedMaterialGroupNId: The Material Group allowed to be used with the piece of Equipment.\r\n   - AllowedMaterialNId: The Material allowed to be used with the piece of Equipment. \r\nThe command performs a check on the Equipment Configuration Id to see if it exists.\r\nIf not, error 11214 is returned."},"SystemAnnotations":[{"$id":"890","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"891","$type":"DslTerminalNode","Text":"@AddedOnMinorVersion=03.01.00","FullInfo":"@AddedOnMinorVersion=03.01.00","InfoMap":{"$id":"892","FullIdObj":{"$id":"893","$type":"IdentificableText","Name":"@AddedOnMinorVersion=03.01.00","FullInfo":"@AddedOnMinorVersion=03.01.00","TypeResolved":""}},"FullIdObj":{"$ref":"893"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@AddedOnMinorVersion=03.01.00","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@AddedOnMinorVersion=03.01.00"},{"$id":"894","$type":"DslTerminalNode","Text":"@Guid(bd906083-bcfa-49b1-a68d-c8430d1ff10a)","FullInfo":"@Guid(bd906083-bcfa-49b1-a68d-c8430d1ff10a)","InfoMap":{"$id":"895","FullIdObj":{"$id":"896","$type":"IdentificableText","Name":"@Guid(bd906083-bcfa-49b1-a68d-c8430d1ff10a)","FullInfo":"@Guid(bd906083-bcfa-49b1-a68d-c8430d1ff10a)","TypeResolved":""}},"FullIdObj":{"$ref":"896"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(bd906083-bcfa-49b1-a68d-c8430d1ff10a)","Sieme