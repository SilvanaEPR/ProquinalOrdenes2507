.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"674","$type":"DslTerminalNode","Text":"UpdateProcessAdditionalPropertiesConfiguration","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PIEquipment_MS.MSModel.Commands.UpdateProcessAdditionalPropertiesConfiguration","InfoMap":{"$id":"675","FullIdObj":{"$id":"676","$type":"IdentificableObject","Guid":"ae405f9c-c5fa-45f2-acdf-a86f1bde3662","Name":"UpdateProcessAdditionalPropertiesConfiguration","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PIEquipment_MS.MSModel.Commands.UpdateProcessAdditionalPropertiesConfiguration","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"412"}}},"FullIdObj":{"$ref":"676"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"409"},"Documentation":{"$id":"677","$type":"DslTerminalNode","Text":"Updates extended process properties for the given Equipment Configuration. If none exists, it creates empty ones.\r\nThe command performs the following checks:\r\n1. if the given Equipment Configuration Id exists, if not error 10300 is returned;\r\n2. if the given Equipment Configuration is not Frozen, if it is error 10992 is returned;\r\n3. if the given UoMNId exists, if not error 10001 is returned;\r\n4. if the given AllowedMaterialNId exists, if not error 10806 is returned;\r\n5. if the given AllowedMaterialGroupNId exists, if not error 10842 is returned;\r\n6. if the given AllocationStateMachineNId exists, if not error 11210 is returned;\r\n7. if the given AllowedMaterialNId and AllowedMaterialGroupNId input are not both defined, if so error 11322 is returned;\r\n8. if the given MainStateMachineNId exists, if not error 11210 is returned.","FullInfo":"Updates extended process properties for the given Equipment Configuration. If none exists, it creates empty ones.\r\nThe command performs the following checks:\r\n1. if the given Equipment Configuration Id exists, if not error 10300 is returned;\r\n2. if the given Equipment Configuration is not Frozen, if it is error 10992 is returned;\r\n3. if the given UoMNId exists, if not error 10001 is returned;\r\n4. if the given AllowedMaterialNId exists, if not error 10806 is returned;\r\n5. if the given AllowedMaterialGroupNId exists, if not error 10842 is returned;\r\n6. if the given AllocationStateMachineNId exists, if not error 11210 is returned;\r\n7. if the given AllowedMaterialNId and AllowedMaterialGroupNId input are not both defined, if so error 11322 is returned;\r\n8. if the given MainStateMachineNId exists, if not error 11210 is returned.","InfoMap":{"$id":"678","FullIdObj":{"$id":"679","$type":"IdentificableText","Name":"Updates extended process properties for the given Equipment Configuration. If none exists, it creates empty ones.\r\nThe command performs the following checks:\r\n1. if the given Equipment Configuration Id exists, if not error 10300 is returned;\r\n2. if the given Equipment Configuration is not Frozen, if it is error 10992 is returned;\r\n3. if the given UoMNId exists, if not error 10001 is returned;\r\n4. if the given AllowedMaterialNId exists, if not error 10806 is returned;\r\n5. if the given AllowedMaterialGroupNId exists, if not error 10842 is returned;\r\n6. if the given AllocationStateMachineNId exists, if not error 11210 is returned;\r\n7. if the given AllowedMaterialNId and AllowedMaterialGroupNId input are not both defined, if so error 11322 is returned;\r\n8. if the given MainStateMachineNId exists, if not error 11210 is returned.","FullInfo":"Updates extended process properties for the given Equipment Configuration. If none exists, it creates empty ones.\r\nThe command performs the following checks:\r\n1. if the given Equipment Configuration Id exists, if not error 10300 is returned;\r\n2. if the given Equipment Configuration is not Frozen, if it is error 10992 is returned;\r\n3. if the given UoMNId exists, if not error 10001 is returned;\r\n4. if the given AllowedMaterialNId exists, if not error 10806 is returned;\r\n5. if the given AllowedMaterialGroupNId exists, if not error 10842 is returned;\r\n6. if the given AllocationStateMachineNId exists, if not error 11210 is returned;\r\n7. if the given AllowedMaterialNId and AllowedMaterialGroupNId input are not both defined, if so error 11322 is returned;\r\n8. if the given MainStateMachineNId exists, if not error 11210 is returned.","TypeResolved":""}},"FullIdObj":{"$ref":"679"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Updates extended process properties for the given Equipment Configuration. If none exists, it creates empty ones.\r\nThe command performs the following checks:\r\n1. if the given Equipment Configuration Id exists, if not error 10300 is returned;\r\n2. if the given Equipment Configuration is not Frozen, if it is error 10992 is returned;\r\n3. if the given UoMNId exists, if not error 10001 is returned;\r\n4. if the given AllowedMaterialNId exists, if not error 10806 is returned;\r\n5. if the given AllowedMaterialGroupNId exists, if not error 10842 is returned;\r\n6. if the given AllocationStateMachineNId exists, if not error 11210 is returned;\r\n7. if the given AllowedMaterialNId and AllowedMaterialGroupNId input are not both defined, if so error 11322 is returned;\r\n8. if the given MainStateMachineNId exists, if not error 11210 is returned.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Updates extended process properties for the given Equipment Configuration. If none exists, it creates empty ones.\r\nThe command performs the following checks:\r\n1. if the given Equipment Configuration Id exists, if not error 10300 is returned;\r\n2. if the given Equipment Configuration is not Frozen, if it is error 10992 is returned;\r\n3. if the given UoMNId exists, if not error 10001 is returned;\r\n4. if the given AllowedMaterialNId exists, if not error 10806 is returned;\r\n5. if the given AllowedMaterialGroupNId exists, if not error 10842 is returned;\r\n6. if the given AllocationStateMachineNId exists, if not error 11210 is returned;\r\n7. if the given AllowedMaterialNId and AllowedMaterialGroupNId input are not both defined, if so error 11322 is returned;\r\n8. if the given MainStateMachineNId exists, if not error 11210 is returned."},"SystemAnnotations":[{"$id":"680","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"681","$type":"DslTerminalNode","Text":"@AddedOnMinorVersion=03.01.00","FullInfo":"@AddedOnMinorVersion=03.01.00","InfoMap":{"$id":"682","FullIdObj":{"$id":"683","$type":"IdentificableText","Name":"@AddedOnMinorVersion=03.01.00","FullInfo":"@AddedOnMinorVersion=03.01.00","TypeResolved":""}},"FullIdObj":{"$ref":"683"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@AddedOnMinorVersion=03.01.00","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@AddedOnMinorVersion=03.01.00"},{"$id":"684","$type":"DslTerminalNode","Text":"@Guid(ae405f9c-c5fa-45f2-acdf-a86f1bde3662)","FullInfo":"@Guid(ae405f9c-c5fa-45f2-acdf-a86f1bde3662)","InfoMap":{"$id":"685","FullIdObj":{"$id":"686","$type":"IdentificableText","Name":"@Guid(ae405f9c-c5fa-45f2-acdf-a86f1bde3662)","FullInfo":"@Guid(ae405f9c-c5fa-45f2-acdf-a86f1bde3662)","TypeResolved":""}},"FullIdObj":{"$ref":"686"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"409"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(ae405f9c-c5fa-45f2-acdf-a86f1bde3662)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(ae405f9c-c5fa-45f2-acdf-a86f1bde3662)"}],"TagAnnotations":[],"_text":"UpdateProcessAdditionalPropertiesConfiguration","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"UpdateProcessAdditionalPropertiesConfiguration"},{"$id":"687","$type":"DslCommandInpu