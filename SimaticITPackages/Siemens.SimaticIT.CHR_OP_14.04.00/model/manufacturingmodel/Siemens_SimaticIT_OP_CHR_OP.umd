s created the flag is set to True and the counter is reduced. For workflows where Sample is not getting created, the flag is set to False and the counter is reduced when the Work Process completes.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"A flag to indicate whether a Sample is created. The system uses this flag to reduce the inspection execution engine counter. Such as, when a Sample is created the flag is set to True and the counter is reduced. For workflows where Sample is not getting created, the flag is set to False and the counter is reduced when the Work Process completes."},"SystemAnnotations":[],"CustomAnnotations":[{"$id":"3063","$type":"DslTerminalNode","Text":"@Guid(667908c5-d39d-451f-a2fe-22fcf4ed56c9)","FullInfo":"@Guid(667908c5-d39d-451f-a2fe-22fcf4ed56c9)","InfoMap":{"$id":"3064","FullIdObj":{"$id":"3065","$type":"IdentificableText","Name":"@Guid(667908c5-d39d-451f-a2fe-22fcf4ed56c9)","FullInfo":"@Guid(667908c5-d39d-451f-a2fe-22fcf4ed56c9)","TypeResolved":""}},"FullIdObj":{"$ref":"3065"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"7"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(667908c5-d39d-451f-a2fe-22fcf4ed56c9)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(667908c5-d39d-451f-a2fe-22fcf4ed56c9)"}],"TagAnnotations":[],"Line":697,"CharPositionInLine":4,"_text":"InspectionOrderOperationWorkProcess.IsSampleCreated","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"InspectionOrderOperationWorkProcess.IsSampleCreated"},{"$id":"3066","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"7"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"3067","$type":"DslEntityPropertyTypeTree","Children":[{"$id":"3068","$type":"DslTerminalNode","Text":"bool","FullInfo":"Boolean","InfoMap":{"$id":"3069","FullIdObj":{"$id":"3070","$type":"IdentificableTypeSystem","Name":"bool","Ful