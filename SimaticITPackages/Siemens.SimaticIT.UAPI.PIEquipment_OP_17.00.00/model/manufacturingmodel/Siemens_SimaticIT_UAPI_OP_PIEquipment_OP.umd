ntificableObject","Guid":"e70496f6-b8e3-443f-8f16-0e43cd509a88","Name":"SynchronizeProcessAdditionalProperties","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIEquipment_OP.OPModel.Commands.SynchronizeProcessAdditionalProperties","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"319"}}},"FullIdObj":{"$ref":"508"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"316"},"Documentation":{"$id":"509","$type":"DslTerminalNode","Text":"Synchronizes process properties with the process properties of the given Equipment Configuration.\r\nThe command returns the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the ProcessAdditionalPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the ProcessAdditionalProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllowedMaterialGroupNId,\r\n - AllowedMaterialNId,\r\n - IsSingleLot,\r\n - IsSingleMaterial,\r\n - MaxLevel,\r\n - MinLevel,\r\n - MaxQuantity,\r\n - MinQuantity,\r\n - Quantity.UoMNId,\r\n- MainStateMachineNId.","FullInfo":"Synchronizes process properties with the process properties of the given Equipment Configuration.\r\nThe command returns the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the ProcessAdditionalPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the ProcessAdditionalProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllowedMaterialGroupNId,\r\n - AllowedMaterialNId,\r\n - IsSingleLot,\r\n - IsSingleMaterial,\r\n - MaxLevel,\r\n - MinLevel,\r\n - MaxQuantity,\r\n - MinQuantity,\r\n - Quantity.UoMNId,\r\n- MainStateMachineNId.","InfoMap":{"$id":"510","FullIdObj":{"$id":"511","$type":"IdentificableText","Name":"Synchronizes process properties with the process properties of the given Equipment Configuration.\r\nThe command returns the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the ProcessAdditionalPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the ProcessAdditionalProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllowedMaterialGroupNId,\r\n - AllowedMaterialNId,\r\n - IsSingleLot,\r\n - IsSingleMaterial,\r\n - MaxLevel,\r\n - MinLevel,\r\n - MaxQuantity,\r\n - MinQuantity,\r\n - Quantity.UoMNId,\r\n- MainStateMachineNId.","FullInfo":"Synchronizes process properties with the process properties of the given Equipment Configuration.\r\nThe command returns the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the ProcessAdditionalPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the ProcessAdditionalProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllowedMaterialGroupNId,\r\n - AllowedMaterialNId,\r\n - IsSingleLot,\r\n - IsSingleMaterial,\r\n - MaxLevel,\r\n - MinLevel,\r\n - MaxQuantity,\r\n - MinQuantity,\r\n - Quantity.UoMNId,\r\n- MainStateMachineNId.","TypeResolved":""}},"FullIdObj":{"$ref":"511"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Synchronizes process properties with the process properties of the given Equipment Configuration.\r\nThe command returns the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the ProcessAdditionalPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the ProcessAdditionalProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllowedMaterialGroupNId,\r\n - AllowedMaterialNId,\r\n - IsSingleLot,\r\n - IsSingleMaterial,\r\n - MaxLevel,\r\n - MinLevel,\r\n - MaxQuantity,\r\n - MinQuantity,\r\n - Quantity.UoMNId,\r\n- MainStateMachineNId.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Synchronizes process properties with the process properties of the given Equipment Configuration.\r\nThe command returns the following checks the given Equipment Configuration:\r\n 1. if the given Id exists, if not error 10300 is returned;\r\n 2. if the ProcessAdditionalPropertiesConfiguration (related to it) exists, if not error 10996 is returned;\r\n 3. if the respective Equipment entity exists, if not the error 10996 is returned;\r\n 4. if the ProcessAdditionalProperties (related to the Equipment entity) exists, if not error 10996 is returned;\r\n 5. if the respective Equipment entity is not Frozen, if so error 10992 is returned;\r\nThe command updates the following attributes:\r\n - AllowedMaterialGroupNId,\r\n - AllowedMaterialNId,\r\n - IsSingleLot,\r\n - IsSingleMaterial,\r\n - MaxLevel,\r\n - MinLevel,\r\n - MaxQuantity,\r\n - MinQuantity,\r\n - Quantity.UoMNId,\r\n- MainStateMachineNId."},"SystemAnnotations":[{"$id":"512","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"316"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"513","$type":"DslTerminalNode","Text":"@AddedOnMinorVersion=03.01.00","FullInfo":"@AddedOnMinorVersion=03.01.00","InfoMap":{"$id":"514","FullIdObj":{"$id":"515","$type":"IdentificableText","Name":"@AddedOnMinorVersion=03.01.00","FullInfo":"@AddedOnMinorVersion=03.01.00","TypeResolved":""}},"FullIdObj":{"$ref":"515"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"316"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@AddedOnMinorVersion=03.01.00","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@AddedOnMinorVersion=03.01.00"},{"$id":"516","$type":"DslTerminalNode","Text":"@Guid(e70496f6-b8e3-443f-8f16-0e43cd509a88)","FullInfo":"@Guid(e70496f6-b8e3-443f-8f16-0e43cd509a88)","InfoMap":{"$id":"517","FullIdObj":{"$id":"518","$type":"IdentificableText","Name":"@Guid(e70496f6-b8e3-443f-8f16-0e43cd509a88)","FullInfo":"@Guid(e70496f6-b8e3-443f-8f16-0e43cd509a88)","TypeResolved":""}},"FullIdObj":{"$ref":"518"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"316"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(e70496f6-b8e3-443f-8f16-0e43cd509a88)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(e70496f6-b8e3-443f-8f16-0e43cd509a88)"}],"TagAnnotations":[],"_text":"SynchronizeProcessAdditionalProperties","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"SynchronizeProcessAdditionalProperties"},{"$id":"519","$type":"DslCommandInputDeclarationTree","Children