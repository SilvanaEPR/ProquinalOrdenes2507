fo":"Siemens.SimaticIT.OperationalData.UDM_OP.OPModel.Commands.CreateWorkOrderContext","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"1606"}}},"FullIdObj":{"$ref":"3936"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"1603"},"Documentation":{"$id":"3937","$type":"DslTerminalNode","Text":"Associates an existing Task to the specified Work Order and Work Order Operation by creating a WorkOrderContext Entity. \r\n\r\nFormerly you could optionally indicate the Work Procedure (Deprecated) in which the Task has been instantiated. Due to deprecation of Work Procedure, we recommend you to not use this option.  \r\nPlease avoid using the Command arguments WorkProcedureNId and WorkProcedureRevision.\r\n\r\nThe command performs the following checks:\r\n1. if the given Task exists, if not error -3 is returned;\r\n2. if the given Work Order exists, if not error -3 is returned;\r\n3. if the given Work Order Operation exists, if not error -3 is returned;\r\n4. when a Work Procedure is specified, checks if it exists, if not error -3 is returned.","FullInfo":"Associates an existing Task to the specified Work Order and Work Order Operation by creating a WorkOrderContext Entity. \r\n\r\nFormerly you could optionally indicate the Work Procedure (Deprecated) in which the Task has been instantiated. Due to deprecation of Work Procedure, we recommend you to not use this option.  \r\nPlease avoid using the Command arguments WorkProcedureNId and WorkProcedureRevision.\r\n\r\nThe command performs the following checks:\r\n1. if the given Task exists, if not error -3 is returned;\r\n2. if the given Work Order exists, if not error -3 is returned;\r\n3. if the given Work Order Operation exists, if not error -3 is returned;\r\n4. when a Work Procedure is specified, checks if it exists, if not error -3 is returned.","InfoMap":{"$id":"3938","FullIdObj":{"$id":"3939","$type":"IdentificableText","Name":"Associates an existing Task to the specified Work Order and Work Order Operation by creating a WorkOrderContext Entity. \r\n\r\nFormerly you could optionally indicate the Work Procedure (Deprecated) in which the Task has been instantiated. Due to deprecation of Work Procedure, we recommend you to not use this option.  \r\nPlease avoid using the Command arguments WorkProcedureNId and WorkProcedureRevision.\r\n\r\nThe command performs the following checks:\r\n1. if the given Task exists, if not error -3 is returned;\r\n2. if the given Work Order exists, if not error -3 is returned;\r\n3. if the given Work Order Operation exists, if not error -3 is returned;\r\n4. when a Work Procedure is specified, checks if it exists, if not error -3 is returned.","FullInfo":"Associates an existing Task to the specified Work Order and Work Order Operation by creating a WorkOrderContext Entity. \r\n\r\nFormerly you could optionally indicate the Work Procedure (Deprecated) in which the Task has been instantiated. Due to deprecation of Work Procedure, we recommend you to not use this option.  \r\nPlease avoid using the Command arguments WorkProcedureNId and WorkProcedureRevision.\r\n\r\nThe command performs the following checks:\r\n1. if the given Task exists, if not error -3 is returned;\r\n2. if the given Work Order exists, if not error -3 is returned;\r\n3. if the given Work Order Operation exists, if not error -3 is returned;\r\n4. when a Work Procedure is specified, checks if it exists, if not error -3 is returned.","TypeResolved":""}},"FullIdObj":{"$ref":"3939"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Associates an existing Task to the specified Work Order and Work Order Operation by creating a WorkOrderContext Entity. \r\n\r\nFormerly you could optionally indicate the Work Procedure (Deprecated) in which the Task has been instantiated. Due to deprecation of Work Procedure, we recommend you to not use this option.  \r\nPlease avoid using the Command arguments WorkProcedureNId and WorkProcedureRevision.\r\n\r\nThe command performs the following checks:\r\n1. if the given Task exists, if not error -3 is returned;\r\n2. if the given Work Order exists, if not error -3 is returned;\r\n3. if the given Work Order Operation exists, if not error -3 is returned;\r\n4. when a Work Procedure is specified, checks if it exists, if not error -3 is returned.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Associates an existing Task to the specified Work Order and Work Order Operation by creating a WorkOrderContext Entity. \r\n\r\nFormerly you could optionally indicate the Work Procedure (Deprecated) in which the Task has been instantiated. Due to deprecation of Work Procedure, we recommend you to not use this option.  \r\nPlease avoid using the Command arguments WorkProcedureNId and WorkProcedureRevision.\r\n\r\nThe command performs the following checks:\r\n1. if the given Task exists, if not error -3 is returned;\r\n2. if the given Work Order exists, if not error -3 is returned;\r\n3. if the given Work Order Operation exists, if not error -3 is returned;\r\n4. when a Work Procedure is specified, checks if it exists, if not error -3 is returned."},"SystemAnnotations":[{"$id":"3940","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"1603"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"3941","$type":"DslTerminalNode","Text":"@AddedOnMinorVersion=08.01.00","FullInfo":"@AddedOnMinorVersion=08.01.00","InfoMap":{"$id":"3942","FullIdObj":{"$id":"3943","$type":"IdentificableText","Name":"@AddedOnMinorVersion=08.01.00","FullInfo":"@AddedOnMinorVersion=08.01.00","TypeResolved":""}},"FullIdObj":{"$ref":"3943"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"1603"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@AddedOnMinorVersion=08.01.00","Siemens.Simati