1117","FullIdObj":{"$id":"1118","$type":"IdentificableObject","Guid":"5ba87392-c15a-4737-bb83-80348223613b","Name":"CreateMaterialPropertyAttributes","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PIMaterial_MS.MSModel.Commands.CreateMaterialPropertyAttributes","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"592"}}},"FullIdObj":{"$ref":"1118"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"589"},"Documentation":{"$id":"1119","$type":"DslTerminalNode","Text":"Creates Material Property Attributes to a given Material Property.\r\n \r\nThe command will:\r\n1. retrieve the Material Property;\r\n2. check if the Material Property exists and the Material is not locked;\r\n3. for each Attribute in the input, check if the attribute value is valid for its data type\r\n3. add the Material Property Attributes to the Material Property.\r\n \r\nThe command performs the following checks on the given Material Property:\r\n1. if it exists, if not error -12006 is returned;\r\n2. if its Material is not locked, if it is error -12007 is returned;\r\n \r\nThe command performs the following checks on the input Attributes:\r\n1. for each attribute if the attribute value is valid for the data type, if not error -12009 is returned;","FullInfo":"Creates Material Property Attributes to a given Material Property.\r\n \r\nThe command will:\r\n1. retrieve the Material Property;\r\n2. check if the Material Property exists and the Material is not locked;\r\n3. for each Attribute in the input, check if the attribute value is valid for its data type\r\n3. add the Material Property Attributes to the Material Property.\r\n \r\nThe command performs the following checks on the given Material Property:\r\n1. if it exists, if not error -12006 is returned;\r\n2. if its Material is not locked, if it is error -12007 is returned;\r\n \r\nThe command performs the following checks on the input Attributes:\r\n1. for each attribute if the attribute value is valid for the data type, if not error -12009 is returned;","InfoMap":{"$id":"1120","FullIdObj":{"$id":"1121","$type":"IdentificableText","Name":"Creates Material Property Attributes to a given Material Property.\r\n \r\nThe command will:\r\n1. retrieve the Material Property;\r\n2. check if the Material Property exists and the Material is not locked;\r\n3. for each Attribute in the input, check if the attribute value is valid for its data type\r\n3. add the Material Property Attributes to the Material Property.\r\n \r\nThe command performs the following checks on the given Material Property:\r\n1. if it exists, if not error -12006 is returned;\r\n2. if its Material is not locked, if it is error -12007 is returned;\r\n \r\nThe command performs the following checks on the input Attributes:\r\n1. for each attribute if the attribute value is valid for the data type, if not error -12009 is returned;","FullInfo":"Creates Material Property Attributes to a given Material Property.\r\n \r\nThe command will:\r\n1. retrieve the Material Property;\r\n2. check if the Material Property exists and the Material is not locked;\r\n3. for each Attribute in the input, check if the attribute value is valid for its data type\r\n3. add the Material Property Attributes to the Material Property.\r\n \r\nThe command performs the following checks on the given Material Property:\r\n1. if it exists, if not error -12006 is returned;\r\n2. if its Material is not locked, if it is error -12007 is returned;\r\n \r\nThe command performs the following checks on the input Attributes:\r\n1. for each attribute if the attribute value is valid for the data type, if not error -12009 is returned;","TypeResolved":""}},"FullIdObj":{"$ref":"1121"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Creates Material Property Attributes to a given Material Property.\r\n \r\nThe command will:\r\n1. retrieve the Material Property;\r\n2. check if the Material Property exists and the Material is not locked;\r\n3. for each Attribute in the input, check if the attribute value is valid for its data type\r\n3. add the Material Property Attributes to the Material Property.\r\n \r\nThe command performs the following checks on the given Material Property:\r\n1. if it exists, if not error -12006 is returned;\r\n2. if its Material is not locked, if it is error -12007 is returned;\r\n \r\nThe command performs the following checks on the input Attributes:\r\n1. for each attribute if the attribute value is valid for the data type, if not error -12009 is returned;","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Creates Material Property Attributes to a given Material Property.\r\n \r\nThe command will:\r\n1. retrieve the Material Property;\r\n2. check if the Material Property exists and the Material is not locked;\r\n3. for each Attribute in the input, check if the attribute value is valid for its data type\r\n3. add the Material Property Attributes to the Material Property.\r\n \r\nThe command performs the following checks on the given Material Property:\r\n1. if it exists, if not error -12006 is returned;\r\n2. if its Material is not locked, if it is error -12007 is returned;\r\n \r\nThe command performs the following checks on the input Attributes:\r\n1. for each attribute if the attribute value is valid for the data type, if not error -12009 is returned;"},"SystemAnnotations":[{"$id":"1122","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"589"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"1123","$type":"DslTerminalNode","Text":"@Guid(5ba87392-c15a-4737-bb83-80348223613b)","FullInfo":"@Guid(5ba87392-c15a-4737-bb83-80348223613b)","InfoMap":{"$id":"1124","FullIdObj":{"$id":"1125","$type":"IdentificableText","Name":"@Guid(5ba87392-c15a-4737-bb83-80348223613b)","FullInfo":"@Guid(5ba87392-c15a-