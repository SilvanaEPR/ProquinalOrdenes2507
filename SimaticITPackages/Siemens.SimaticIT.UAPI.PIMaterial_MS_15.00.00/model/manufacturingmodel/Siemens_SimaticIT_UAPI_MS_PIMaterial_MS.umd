tions":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"1261","$type":"DslTerminalNode","Text":"UpdateMaterialPropertyExt","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PIMaterial_MS.MSModel.Commands.UpdateMaterialPropertyExt","InfoMap":{"$id":"1262","FullIdObj":{"$id":"1263","$type":"IdentificableObject","Guid":"c5b3fe84-d4bc-4441-851c-3d3e9b05b836","Name":"UpdateMaterialPropertyExt","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PIMaterial_MS.MSModel.Commands.UpdateMaterialPropertyExt","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"592"}}},"FullIdObj":{"$ref":"1263"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"589"},"Documentation":{"$id":"1264","$type":"DslTerminalNode","Text":"Updates the Facet UpdateMaterialPropertyExt fields, extension of Material Property Entity.\r\n\r\nThe Command will:\r\n1. Retrieve the Material Property by Id.\r\n2. Check if the Material Property exists.\r\n3. Check if the Material is locked.\r\n4. Check if the facet exists, if not it is created.\r\n5. Update the facet fields with the input values.\r\n\r\nThe command performs the following checks:\r\n1. If the given Material Property exists, if not error -12006 is returned.\r\n2. If the given Material is not Locked, if it is error -12007 is returned.\r\n3. If the given Material Property is not Frozen, if it is error -12001 is returned.","FullInfo":"Updates the Facet UpdateMaterialPropertyExt fields, extension of Material Property Entity.\r\n\r\nThe Command will:\r\n1. Retrieve the Material Property by Id.\r\n2. Check if the Material Property exists.\r\n3. Check if the Material is locked.\r\n4. Check if the facet exists, if not it is created.\r\n5. Update the facet fields with the input values.\r\n\r\nThe command performs the following checks:\r\n1. If the given Material Property exists, if not error -12006 is returned.\r\n2. If the given Material is not Locked, if it is error -12007 is returned.\r\n3. If the given Material Property is not Frozen, if it is error -12001 is returned.","InfoMap":{"$id":"1265","FullIdObj":{"$id":"1266","$type":"IdentificableText","Name":"Updates the Facet UpdateMaterialPropertyExt fields, extension of Material Property Entity.\r\n\r\nThe Command will:\r\n1. Retrieve the Material Property by Id.\r\n2. Check if the Material Property exists.\r\n3. Check if the Material is locked.\r\n4. Check if the facet exists, if not it is created.\r\n5. Update the facet fields with the input values.\r\n\r\nThe command performs the following checks:\r\n1. If the given Material Property exists, if not error -12006 is returned.\r\n2. If the given Material is not Locked, if it is error -12007 is returned.\r\n3. If the given Material Property is not Frozen, if it is error -12001 is returned.","FullInfo":"Updates the Facet UpdateMaterialPropertyExt fields, extension of Material Property Entity.\r\n\r\nThe Command will:\r\n1. Retrieve the Material Property by Id.\r\n2. Check if the Material Property exists.\r\n3. Check if the Material is locked.\r\n4. Check if the facet exists, if not it is created.\r\n5. Update the facet fields with the input values.\r\n\r\nThe command performs the following checks:\r\n1. If the given Material Property exists, if not error -12006 is returned.\r\n2. If the given Material is not Locked, if it is error -12007 is returned.\r\n3. If the given Material Property is not Frozen, if it is error -12001 is returned.","TypeResolved":""}},"FullIdObj":{"$ref":"1266"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Updates the Facet UpdateMaterialPropertyExt fields, extension of Material Property Entity.\r\n\r\nThe Command will:\r\n1. Retrieve the Material Property by Id.\r\n2. Check if the Material Property exists.\r\n3. Check if the Material is locked.\r\n4. Check if the facet exists, if not it is created.\r\n5. Update the facet fields with the input values.\r\n\r\nThe command performs the following checks:\r\n1. If the given Material Property exists, if not error -12006 is returned.\r\n2. If the given Material is not Locked, if it is error -12007 is returned.\r\n3. If the given Material Property is not Frozen, if it is error -12001 is returned.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Updates the Facet UpdateMaterialPropertyExt fields, extension of Material Property Entity.\r\n\r\nThe Command will:\r\n1. Retrieve the Material Property by Id.\r\n2. Check if the Material Property exists.\r\n3. Check if the Material is locked.\r\n4. Check if the facet exists, if not it is created.\r\n5. Update the facet fields with the input values.\r\n\r\nThe command performs the following checks:\r\n1. If the given Material Property exists, if not error -12006 is returned.\r\n2. If the given Material is not Locked, if it is error -12007 is returned.\r\n3. If the given Material Property is not Frozen, if it is error -12001 is returned."},"SystemAnnotations":[{"$id":"1267","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"589"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"1268","$type":"DslTerminalNode","Text":"@Guid(c5b3fe84-d4bc-4441-851c-3d3e9b05b836)","FullInfo":"@Guid(c5b3fe84-d4bc-4441-851c-3d3e9b05b836)","InfoMap":{"$id":"1269","FullIdObj":{"$id":"1270","$type":"IdentificableText","Name":"@Guid(c5b3fe84-d4bc-4441-851c-3d3e9b05b836)","FullInfo":"@Guid(c5b3fe84-d4bc-4441-851c-3d3e9b05b836)","TypeResolved":""}},"FullIdObj":{"$ref":"1270"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"589"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(c5b3fe84-d4bc-4441-851c-3d3e9b05b836)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(c5b3fe84-d4bc-4441-851c-3d3e9b05b836)"}],"TagAnnotations":[],"_text":"UpdateMaterialPropertyExt","Siemens.SimaticIT.DSL.