ntificableObject","Guid":"a25bf7a3-be47-45b9-a1e8-540a35d6925f","Name":"UpdateMaterialProcessAdditionalProperties","FullInfo":"Siemens.SimaticIT.UAPI.MasterData.PIMaterial_MS.MSModel.Commands.UpdateMaterialProcessAdditionalProperties","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"592"}}},"FullIdObj":{"$ref":"967"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"589"},"Documentation":{"$id":"968","$type":"DslTerminalNode","Text":"Updates extended process Properties of the given Material. \r\nIf the relative ProcessAdditionalProperties Facet does not exists, the command adds the Facet and assign the values passed to the command.\r\nThe command checks:\r\n1. If the Material Id exists, if not error 12002 is returned.\r\n2. If the Material is Frozen, if so error 12001 is returned.\r\n3. If the UoM exists, if not error 12003 is returned.\r\n4. If the UoM belongs to a time dimension, if not error 12004 is returned.\r\n5. If the UoM is defined when a quantity is defined, if not error 12005 is returned.","FullInfo":"Updates extended process Properties of the given Material. \r\nIf the relative ProcessAdditionalProperties Facet does not exists, the command adds the Facet and assign the values passed to the command.\r\nThe command checks:\r\n1. If the Material Id exists, if not error 12002 is returned.\r\n2. If the Material is Frozen, if so error 12001 is returned.\r\n3. If the UoM exists, if not error 12003 is returned.\r\n4. If the UoM belongs to a time dimension, if not error 12004 is returned.\r\n5. If the UoM is defined when a quantity is defined, if not error 12005 is returned.","InfoMap":{"$id":"969","FullIdObj":{"$id":"970","$type":"IdentificableText","Name":"Updates extended process Properties of the given Material. \r\nIf the relative ProcessAdditionalProperties Facet does not exists, the command adds the Facet and assign the values passed to the command.\r\nThe command checks:\r\n1. If the Material Id exists, if not error 12002 is returned.\r\n2. If the Material is Frozen, if so error 12001 is returned.\r\n3. If the UoM exists, if not error 12003 is returned.\r\n4. If the UoM belongs to a time dimension, if not error 12004 is returned.\r\n5. If the UoM is defined when a quantity is defined, if not error 12005 is returned.","FullInfo":"Updates extended process Properties of the given Material. \r\nIf the relative ProcessAdditionalProperties Facet does not exists, the command adds the Facet and assign the values passed to the command.\r\nThe command checks:\r\n1. If the Material Id exists, if not error 12002 is returned.\r\n2. If the Material is Frozen, if so error 12001 is returned.\r\n3. If the UoM exists, if not error 12003 is returned.\r\n4. If the UoM belongs to a time dimension, if not error 12004 is returned.\r\n5. If the UoM is defined when a quantity is defined, if not error 12005 is returned.","TypeResolved":""}},"FullIdObj":{"$ref":"970"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Updates extended process Properties of the given Material. \r\nIf the relative ProcessAdditionalProperties Facet does not exists, the command adds the Facet and assign the values passed to the command.\r\nThe command checks:\r\n1. If the Material Id exists, if not error 12002 is returned.\r\n2. If the Material is Frozen, if so error 12001 is returned.\r\n3. If the UoM exists, if not error 12003 is returned.\r\n4. If the UoM belongs to a time dimension, if not error 12004 is returned.\r\n5. If the UoM is defined when a quantity is defined, if not error 12005 is returned.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Updates extended process Properties of the given Material. \r\nIf the relative ProcessAdditionalProperties Facet does not exists, the command adds the Facet and assign the values passed to the command.\r\nThe command checks:\r\n1. If the Material Id exists, if not error 12002 is returned.\r\n2. If the Material is Frozen, if so error 12001 is returned.\r\n3. If the UoM exists, if not error 12003 is returned.\r\n4. If the UoM belongs to a time dimension, if not error 12004 is returned.\r\n5. If the UoM is defined when a quantity is defined, if not error 12005 is returned."},"SystemAnnotations":[{"$id":"971","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"589"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"972","$type":"DslTerminalNode","Text":"@Guid(a25bf7a3-be47-45b9-a1e8-540a35d6925f)","FullInfo":"@Guid(a25bf7a3-be47-45b9-a1e8-540a35d6925f)","InfoMap":{"$id":"973","FullIdObj":{"$id":"974","$type":"IdentificableText","Name":"@Guid(a25bf7a3-be47-45b9-a1e8-540a35d6925f)","FullInfo":"@Guid(a25bf7a3-be47-45b9-a1e8-540a35d6925f)","TypeResolved":""}},"FullIdObj":{"$ref":"974"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"589"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(a25bf7a3-be47-45b9-a1e8-540a35d6925f)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(a25bf7a3-be47-45b9-a1e8-540a35d6925f)"}],"TagAnnotations":[],"_text":"UpdateMaterialProcessAdditionalProperties","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"UpdateMaterialProcessAdditionalProperties"},{"$id":"975","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"976","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"589"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"977","$type":"DslCommandPropertyCollectionTree","Name":"InputProperties","ScriptInfo":{"$ref":"589"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"ChildrenList":[{"$id":"978","$type":"DslCommandPropertyTree","Children":[{"$id":"979","$type":"DslTerminalNode","Text":"Id","FullInfo":"Siem