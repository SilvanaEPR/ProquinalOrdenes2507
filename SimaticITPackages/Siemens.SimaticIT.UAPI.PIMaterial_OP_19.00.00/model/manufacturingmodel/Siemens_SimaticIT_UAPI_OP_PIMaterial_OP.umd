s":[]}],"CustomAnnotations":[],"TagAnnotations":[],"_text":"ReasonCode","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"ReasonCode"},{"$id":"1390","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"1391","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"1392","$type":"DslTerminalNode","Text":"string","FullInfo":"String","InfoMap":{"$id":"1393","FullIdObj":{"$id":"1394","$type":"IdentificableTypeSystem","Name":"string","FullInfo":"String","TypeResolved":""}},"FullIdObj":{"$ref":"1394"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":243,"CharPositionInLine":18,"_text":"string","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"string"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Input declaration commands","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"1395","$type":"DslCommandDeclarationTree","HasInput":true,"HasOutput":true,"Children":[{"$id":"1396","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"1397","$type":"DslTerminalNode","Text":"Move","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.Move","InfoMap":{"$id":"1398","FullIdObj":{"$id":"1399","$type":"IdentificableObject","Guid":"e768dbfd-4183-4a93-8134-8a9e9cb9f725","Name":"Move","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.Move","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"366"}}},"FullIdObj":{"$ref":"1399"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"363"},"Documentation":{"$id":"1400","$type":"DslTerminalNode","Text":"This command registers a single Movement which has happened in the system, involving one single Source MTU specified by MTUId input field. If no source exists in the system, MTUId can be left empty: for tracing purposes it is still possible to specify the SourceEquipmentNId value, but in this case no algorithm will be executed to retrieve a possible MTU from the specified source (use the MoveMTUFromSource command for this particular behavior instead).\r\nUse the DestinationEquipmentNId input field to set the natural identifier of the piece of Equipment that is the end point of the move operation.\r\nHow the Equipment has been configured will ultimately affect how the MTU will move forward during the process execution: \r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. \r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU.\r\nThe Quantity of the MTU is determined by the incoming contributions: the first contribution would set the reference Unit of Measure for the MTU, and all the other contributions will add up to its Quantity, their value being converted into the reference Unit of Measure, as long as each contribution of Material Quantity is expressed with a mutually compatible Unit of Measure. The first contribution whose Quantity would be eventually expressed with a Unit of Measure which is not compatible with the one already associated with the MTU, will cause the entire Quantity of the MTU to be reset (the Quantity will be set equal to NULL).\r\nIf a the contribution of the source MTU is associated with a Material or a Material Lot which is different from the one already (optionally) associated with the MTU inside a Mixing piece of Equipment, the MTU will lose its Identity.","FullInfo":"This command registers a single Movement which has happened in the system, involving one single Source MTU specified by MTUId input field. If no source exists in the system, MTUId can be left empty: for tracing purposes it is still possible to specify the SourceEquipmentNId value, but in this case no algorithm will be executed to retrieve a possible MTU from the specified source (use the MoveMTUFromSource command for this particular behavior instead).\r\nUse the DestinationEquipmentNId input field to set the natural identifier of the piece of Equipment that is the end point of the move operation.\r\nHow the Equipment has been configured will ultimately affect how the MTU will move forward during the process execution: \r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. \r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU.\r\nThe Quantity of the MTU is determined by the incoming contributions: the first contribution would set the reference Unit of Measure for the MTU, and all the other contributions will add up to its Quantity, their value being converted into the reference Unit of Measure, as long as each contribution of Material Quantity is expressed with a mutually compatible Unit of Measure. The first contribution whose Quantity would be eventually expressed with a Unit of Measure which is not compatible with the one already associated with the MTU, will cause the entire Quantity of the MTU to be reset (the Quantity will be set equal to NULL).\r\nIf a the contribution of the source MTU is associated with a Material or a Material Lot which is different from the one already (optionally) associated with the MTU inside a Mixing piece of Equipment, the MTU will lose its Identity.","InfoMap":{"$id":"1401","FullIdObj":{"$id":"1402","$type":"IdentificableText","Name":"This command registers a single Movement which has happened in the system, involving one single Source MTU specified by MTUId input field. If no source exists in the system, MTUId can be left empty: for tracing purposes it is still possible to specify the SourceEquipmentNId value, but in this case no algorithm will be executed to retrieve a possible MTU from the specified source (use the MoveMTUFromSource command for this particular behavior instead).\r\nUse the DestinationEquipmentNId input field to set the natural identifier of the piece of Equipment that is the end point of the move operation.\r\nHow the Equipment has been configured will ultimately affect how the MTU will move forward during the process execution: \r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. \r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU.\r\nThe Quantity of the MTU is determined by the incoming contributions: the first contribution would set the reference Unit of Measure for the MTU, and all the other contributions will add up to its Quantity, their value being converted into the reference Unit of Measure, as long as each contribution of Material Quantity is expressed with a mutually compatible Unit of Measure. The first contribution whose Quantity would be eventually expressed with a Unit of Measure which is not compatible with the one already associated with the MTU, will cause the entire Quantity of the MTU to be reset (the Quantity will be set equal to NULL).\r\nIf a the contribution of the source MTU is associated with a Material or a Material Lot which is different from the one already (optionally) associated with the MTU inside a Mixing piece of Equipment, the MTU will lose its Identity.","FullInfo":"This command registers a single Movement which has happened in the system, involving one single Source MTU specified by MTUId input field. If no source exists in the system, MTUId can be left empty: for tracing purposes it is still possible to specify the SourceEquipmentNId value, but in this case no algorithm will be executed to retrieve a possible MTU from the specified source (use the MoveMTUFromSource command for this particular behavior instead).\r\nUse the DestinationEquipmentNId input field to set the natural identifier of the piece of Equipment that is the end point of the move operation.\r\nHow the Equipment has been configured will ultimately affect how the MTU will move forward during the process execution: \r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. \r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU.\r\nThe Quantity of the MTU is determined by the incoming contributions: the first contribution would set the reference Unit of Measure for the MTU, and all the other contributions will add up to its Quantity, their value being converted into the reference Unit of Measure, as long as each contribution of Material Quantity is expressed with a mutually compatible Unit of Measure. The first contribution whose Quantity would be eventually expressed with a Unit of Measure which is not compatible with the one already associated with the MTU, will cause the entire Quantity of the MTU to be reset (the Quantity will be set equal to NULL).\r\nIf a the contribution of the source MTU is associated with a Material or a Material Lot which is different from the one already (optionally) associated with the MTU inside a Mixing piece of Equipment, the MTU will lose its Identity.","TypeResolved":""}},"FullIdObj":{"$ref":"1402"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"This command registers a single Movement which has happened in the system, involving one single Source MTU specified by MTUId input field. If no source exists in the system, MTUId can be left empty: for tracing purposes it is still possible to specify the SourceEquipmentNId value, but in this case no algorithm will be executed to retrieve a possible MTU from the specified source (use the MoveMTUFromSource command for this particular behavior instead).\r\nUse the DestinationEquipmentNId input field to set the natural identifier of the piece of Equipment that is the end point of the move operation.\r\nHow the Equipment has been configured will ultimately affect how the MTU will move forward during the process execution: \r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. \r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU.\r\nThe Quantity of the MTU is determined by the incoming contributions: the first contribution would set the reference Unit of Measure for the MTU, and all the other contributions will add up to its Quantity, their value being converted into the reference Unit of Measure, as long as each contribution of Material Quantity is expressed with a mutually compatible Unit of Measure. The first contribution whose Quantity would be eventually expressed with a Unit of Measure which is not compatible with the one already associated with the MTU, will cause the entire Quantity of the MTU to be reset (the Quantity will be set equal to NULL).\r\nIf a the contribution of the source MTU is associated with a Material or a Material Lot which is different from the one already (optionally) associated with the MTU inside a Mixing piece of Equipment, the MTU will lose its Identity.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"This command registers a single Movement which has happened in the system, involving one single Source MTU specified by MTUId input field. If no source exists in the system, MTUId can be left empty: for tracing purposes it is still possible to specify the SourceEquipmentNId value, but in this case no algorithm will be executed to retrieve a possible MTU from the specified source (use the MoveMTUFromSource command for this particular behavior instead).\r\nUse the DestinationEquipmentNId input field to set the natural identifier of the piece of Equipment that is the end point of the move operation.\r\nHow the Equipment has been configured will ultimately affect how the MTU will move forward during the process execution: \r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. \r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU.\r\nThe Quantity of the MTU is determined by the incoming contributions: the first contribution would set the reference Unit of Measure for the MTU, and all the other contributions will add up to its Quantity, their value being converted into the reference Unit of Measure, as long as each contribution of Material Quantity is expressed with a mutually compatible Unit of Measure. The first contribution whose Quantity would be eventually expressed with a Unit of Measure which is not compatible with the one already associated with the MTU, will cause the entire Quantity of the MTU to be reset (the Quantity will be set equal to NULL).\r\nIf a the contribution of the source MTU is associated with a Material or a Material Lot which is different from the one already (optionally) associated with the MTU inside a Mixing piece of Equipment, the MTU will lose its Identity."},"SystemAnnotations":[{"$id":"1403","$type":"DslKeywordNode","Text":"NotSecurable","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_