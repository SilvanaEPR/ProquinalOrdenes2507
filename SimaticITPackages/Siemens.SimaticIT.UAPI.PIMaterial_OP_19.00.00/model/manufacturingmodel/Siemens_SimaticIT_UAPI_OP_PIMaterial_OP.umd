peResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"366"}}},"FullIdObj":{"$ref":"1105"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"363"},"Documentation":{"$id":"1106","$type":"DslTerminalNode","Text":"Moves the entire or a partial quantity of an MTU from a specific source (Equipment or MTU) to a specific destination Equipment, according to the Material Behavior of the source and destination:\r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. Whenever an MTU must be picked from the piece of Equipment, by default, the system will pick the MTU that was received in input and stored first. If a SourceQuantity is set as input of the command and the first MTU does not have enough quantity, subsequent MTUs are chosen untill the requested quantity is reached.\r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU, so it can contain one only MTU.","FullInfo":"Moves the entire or a partial quantity of an MTU from a specific source (Equipment or MTU) to a specific destination Equipment, according to the Material Behavior of the source and destination:\r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. Whenever an MTU must be picked from the piece of Equipment, by default, the system will pick the MTU that was received in input and stored first. If a SourceQuantity is set as input of the command and the first MTU does not have enough quantity, subsequent MTUs are chosen untill the requested quantity is reached.\r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU, so it can contain one only MTU.","InfoMap":{"$id":"1107","FullIdObj":{"$id":"1108","$type":"IdentificableText","Name":"Moves the entire or a partial quantity of an MTU from a specific source (Equipment or MTU) to a specific destination Equipment, according to the Material Behavior of the source and destination:\r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. Whenever an MTU must be picked from the piece of Equipment, by default, the system will pick the MTU that was received in input and stored first. If a SourceQuantity is set as input of the command and the first MTU does not have enough quantity, subsequent MTUs are chosen untill the requested quantity is reached.\r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU, so it can contain one only MTU.","FullInfo":"Moves the entire or a partial quantity of an MTU from a specific source (Equipment or MTU) to a specific destination Equipment, according to the Material Behavior of the source and destination:\r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. Whenever an MTU must be picked from the piece of Equipment, by default, the system will pick the MTU that was received in input and stored first. If a SourceQuantity is set as input of the command and the first MTU does not have enough quantity, subsequent MTUs are chosen untill the requested quantity is reached.\r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU, so it can contain one only MTU.","TypeResolved":""}},"FullIdObj":{"$ref":"1108"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Moves the entire or a partial quantity of an MTU from a specific source (Equipment or MTU) to a specific destination Equipment, according to the Material Behavior of the source and destination:\r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. Whenever an MTU must be picked from the piece of Equipment, by default, the system will pick the MTU that was received in input and stored first. If a SourceQuantity is set as input of the command and the first MTU does not have enough quantity, subsequent MTUs are chosen untill the requested quantity is reached.\r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU, so it can contain one only MTU.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Moves the entire or a partial quantity of an MTU from a specific source (Equipment or MTU) to a specific destination Equipment, according to the Material Behavior of the source and destination:\r\n* FIFO (First In, First Out): the specified piece of Equipment receives the MTUs in input and stores them as individual entities. Whenever an MTU must be picked from the piece of Equipment, by default, the system will pick the MTU that was received in input and stored first. If a SourceQuantity is set as input of the command and the first MTU does not have enough quantity, subsequent MTUs are chosen untill the requested quantity is reached.\r\n* Mixing: the specified piece of Equipment receives the MTUs in input and combines them to form a single MTU, so it can contain one only MTU."},"SystemAnnotations":[{"$id":"1109","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"1110","$type":"DslTerminalNode","Text":"@Guid(9ebd4f9e-60a7-4163-80d9-e9e09d2d2da3)","FullInfo":"@Guid(9ebd4f9e-60a7-4163-80d9-e9e09d2d2da3)","InfoMap":{"$id":"1111","FullIdObj":{"$id":"1112","$type":"IdentificableText","Name":"@Guid(9ebd4f9e-60a7-4163-80d9-e9e09d2d2da3)","FullInfo":"@Guid(9ebd4f9e-60a7-4163-80d9-e9e09d2d2da3)","TypeResolved":""}},"FullIdObj":{"$ref":"1112"},"Children":[],"Name":"CustomAnnotation","