dren":[],"Name":"SimpleCustomTypeNode","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":673,"CharPositionInLine":28,"_text":"Siemens.SimaticIT.ReferenceData.UDM_RF.RFModel.Types.PropertyParameterTypeCreate","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"PropertyParameterTypeCreate"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Input declaration commands","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"3042","$type":"DslCommandDeclarationTree","HasInput":true,"Children":[{"$id":"3043","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"3044","$type":"DslTerminalNode","Text":"SupplyMTU","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.SupplyMTU","InfoMap":{"$id":"3045","FullIdObj":{"$id":"3046","$type":"IdentificableObject","Guid":"0b58b9bb-0de2-469a-a8f0-f4447bb9b56f","Name":"SupplyMTU","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.SupplyMTU","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"366"}}},"FullIdObj":{"$ref":"3046"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"363"},"Documentation":{"$id":"3047","$type":"DslTerminalNode","Text":"Adds a quantity of material to a Material Tracking Unit.\r\nThe quantity that is going to be added must be expressed with the same Unit of Measure as the Material Tracking Unit quantity. You can use a different Unit of Measure only if it belongs to the same dimension.\r\nThe command:\r\n* Increases the Material Tracking Unit quantity by the given input quantity.\r\n* Converts the UoM of the input quantity if different from MTU UoM, but belonging to the same dimension.\r\n* Upon completion, raises the event MTUOperationCompleted which contains the info on the destination MTU and its new quantity.\r\nThe command may return the following **error codes, if some checks on input parameters fail**:\r\n* Error -12100: the MTU, identified by NId, does not exist.\r\n* Error -12107: the action on the Material Tracking Unit (NId %MTUNId%) failed: the Supply quantity in input is null, or lower or equal to zero.\r\n* Error -12102: the Unit of Measure used to express the SupplyQuantity.QuantityValue is not compatible with that of source quantity.\r\nThe command may return the following **error codes, during its execution**:\r\n* Error -12106: a failure occurred when increasing the Material Tracking Unit quantity.","FullInfo":"Adds a quantity of material to a Material Tracking Unit.\r\nThe quantity that is going to be added must be expressed with the same Unit of Measure as the Material Tracking Unit quantity. You can use a different Unit of Measure only if it belongs to the same dimension.\r\nThe command:\r\n* Increases the Material Tracking Unit quantity by the given input quantity.\r\n* Converts the UoM of the input quantity if different from MTU UoM, but belonging to the same dimension.\r\n* Upon completion, raises the event MTUOperationCompleted which contains the info on the destination MTU and its new quantity.\r\nThe command may return the following **error codes, if some checks on input parameters fail**:\r\n* Error -12100: the MTU, identified by NId, does not exist.\r\n* Error -12107: the action on the Material Tracking Unit (NId %MTUNId%) failed: the Supply quantity in input is null, or lower or equal to zero.\r\n* Error -12102: the Unit of Measure used to express the SupplyQuantity.QuantityValue is not compatible with that of source quantity.\r\nThe command may return the following **error codes, during its execution**:\r\n* Error -12106: a failure occurred when increasing the Material Tracking Unit quantity.","InfoMap":{"$id":"3048","FullIdObj":{"$id":"3049","$type":"IdentificableText","Name":"Adds a quantity of material to a Material Tracking Unit.\r\nThe quantity that is going to be added must be expressed with the same Unit of Measure as the Material Tracking Unit quantity. You can use a different Unit of Measure only if it belongs to the same dimension.\r\nThe command:\r\n* Increases the Material Tracking Unit quantity by the given input quantity.\r\n* Converts the UoM of the input quantity if different from MTU UoM, but belonging to the same dimension.\r\n* Upon completion, raises the event MTUOperationCompleted which contains the info on the destination MTU and its new quantity.\r\nThe command may return the following **error codes, if some checks on input parameters fail**:\r\n* Error -12100: the MTU, identified by NId, does not exist.\r\n* Error -12107: the action on the Material Tracking Unit (NId %MTUNId%) failed: the Supply quantity in input is null, or lower or equal to zero.\r\n* Error -12102: the Unit of Measure used to express the SupplyQuantity.QuantityValue is not compatible with that of source quantity.\r\nThe command may return the following **error codes, during its execution**:\r\n* Error -12106: a failure occurred when increasing the Material Tracking Unit quantity.","FullInfo":"Adds a quantity of material to a Material Tracking Unit.\r\nThe quantity that is going to be added must be expressed with the same Unit of Measure as the Material Tracking Unit quantity. You can use a different Unit of Measure only if it belongs to the same dimension.\r\nThe command:\r\n* Increases the Material Tracking Unit quantity by the given input quantity.\r\n* Converts the UoM of the input quantity if different from MTU UoM, but belonging to the same dimension.\r\n* Upon completion, raises the event MTUOperationCompleted which contains the info on the destination MTU and its new quantity.\r\nThe command may return the following **error codes, if some checks on input parameters fail**:\r\n* Error -12100: the MTU, identified by NId, does not exist.\r\n* Error -12107: the action on the Material Tracking Unit (NId %MTUNId%) failed: the Supply quantity in input is null, or lower or equal to zero.\r\n* Error -12102: the Unit of Measure used to express the SupplyQuantity.QuantityValue is not compatible with that of source quantity.\r\nThe command may return the following **error codes, during its execution**:\r\n* Error -12106: a failure occurred when increasing the Material Tracking Unit quantity.","TypeResolved":""}},"FullIdObj":{"$ref":"3049"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Adds a quantity of material to a Material Tracking Unit.\r\nThe quantity that is going to be added must be expressed with the same Unit of Measure as the Material Tracking Unit quantity. You can use a different Unit of Measure only if it belongs to the same dimension.\r\nThe command:\r\n* Increases the Material Tracking Unit quantity by the given input quantity.\r\n* Converts the UoM of the input quantity if different from MTU UoM, but belonging to the same dimension.\r\n* Upon completion, raises the event MTUOperationCompleted which contains the info on the destination MTU and its new quantity.\r\nThe command may return the following **error codes, if some checks on input parameters fail**:\r\n* Error -12100: the MTU, identified by NId, does not exist.\r\n* Error -12107: the action on the Material Tracking Unit (NId %MTUNId%) failed: the Supply quantity in input is null, or lower or equal to zero.\r\n* Error -12102: the Unit of Measure used to express the SupplyQuantity.QuantityValue is not compatible with that of source quantity.\r\nThe command may return the following **error codes, during its execution**:\r\n* Error -12106: a failure occurred when increasing the Material Tracking Unit quantity.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Adds a quantity of material to a Material Tracking Unit.\r\nThe quantity that is going to be added must be expressed with the same Unit of Measure as the Material Tracking Unit quantity. You can use a different Unit of Measure only if it belongs to the same dimension.\r\nThe command:\r\n* Increases the Material Tracking Unit quantity by the given input quantity.\r\n* Converts the UoM of the input quantity if different from MTU UoM, but belonging to the same dimension.\r\n* Upon completion, raises the event MTUOperationCompleted which contains the info on the destination MTU and its new quantity.\r\nThe command may return the following **error codes, if some checks on input parameters fail**:\r\n* Error -12100: the MTU, identified by NId, does not exist.\r\n* Error -12107: the action on the Material Tracking Unit (NId %MTUNId%) failed: the Supply quantity in input is null, or lower or equal to zero.\r\n* Error -12102: the Unit of Measure used to express the SupplyQuantity.QuantityValue is not compatible with that of source quantity.\r\nThe command may return the following **error codes, during its execution**:\r\n* Error -12106: a failure occurred when increasing the Material Tracking Unit quantity."},"SystemAnnotations":[{"$id":"3050","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"3051","$type":"DslTerminalNode","Text":"@Guid(0b58b9bb-0de2-469a-a8f0-f4447bb9b56f)","FullInfo":"@Guid(0b58b9bb-0de2-469a-a8f0-f4447bb9b56f)","InfoMap":{"$id":"3052","FullIdObj":{"$id":"3053","$type":"IdentificableText","Name":"@Guid(0b58b9bb-0de2-469a-a8f0-f4447bb9b56