nnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"ChildrenList":[{"$id":"789","$type":"DslCommandPropertyTree","Children":[{"$id":"790","$type":"DslTerminalNode","Text":"MaterialTrackingUnitId","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.RemoveIdentity.MaterialTrackingUnitId","InfoMap":{"$id":"791","FullIdObj":{"$id":"792","$type":"IdentificableFakeProperty","Name":"MaterialTrackingUnitId","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.RemoveIdentity.MaterialTrackingUnitId","ContainerFullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.RemoveIdentity","TypeResolved":""}},"FullIdObj":{"$ref":"792"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"363"},"Documentation":{"$id":"793","$type":"DslTerminalNode","Text":"The primary key identifier of the Material Tracking Unit in case a new one is created.","FullInfo":"The primary key identifier of the Material Tracking Unit in case a new one is created.","InfoMap":{"$id":"794","FullIdObj":{"$id":"795","$type":"IdentificableText","Name":"The primary key identifier of the Material Tracking Unit in case a new one is created.","FullInfo":"The primary key identifier of the Material Tracking Unit in case a new one is created.","TypeResolved":""}},"FullIdObj":{"$ref":"795"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"The primary key identifier of the Material Tracking Unit in case a new one is created.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"The primary key identifier of the Material Tracking Unit in case a new one is created."},"SystemAnnotations":[{"$id":"796","$type":"DslKeywordNode","Text":"Optional","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Optional","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Optional"}],"CustomAnnotations":[{"$id":"797","$type":"DslTerminalNode","Text":"@AddedOnMinorVersion=18.01.00","FullInfo":"@AddedOnMinorVersion=18.01.00","InfoMap":{"$id":"798","FullIdObj":{"$id":"799","$type":"IdentificableText","Name":"@AddedOnMinorVersion=18.01.00","FullInfo":"@AddedOnMinorVersion=18.01.00","TypeResolved":""}},"FullIdObj":{"$ref":"799"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@AddedOnMinorVersion=18.01.00","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@AddedOnMinorVersion=18.01.00"}],"TagAnnotations":[],"_text":"MaterialTrackingUnitId","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"MaterialTrackingUnitId"},{"$id":"800","$type":"DslKeywordNode","Text":"AS","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"AS","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"AS"},{"$id":"801","$type":"DslCommandPropertyTypeTree","Children":[{"$id":"802","$type":"DslTerminalNode","Text":"Guid","FullInfo":"Guid","InfoMap":{"$id":"803","FullIdObj":{"$id":"804","$type":"IdentificableTypeSystem","Name":"Guid","FullInfo":"Guid","TypeResolved":""}},"FullIdObj":{"$ref":"804"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":100,"CharPositionInLine":30,"_text":"Guid","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Guid"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Output declaration commands","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"805","$type":"DslCommandDeclarationTree","HasInput":true,"Children":[{"$id":"806","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"807","$type":"DslTerminalNode","Text":"MoveMTU","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.MoveMTU","InfoMap":{"$id":"808","FullIdObj":{"$id":"809","$type":"IdentificableObject","Guid":"027337d1-9ddc-44c8-a064-95c2c429b801","Name":"MoveMTU","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.MoveMTU","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"366"}}},"FullIdObj":{"$ref":"809"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"363"},"Documentation":{"$id":"810","$type":"DslTerminalNode","Text":"This command registers the Movement which has involved the MTU specified as input of the command.\r\nA total move is performed when the entire quantity of the MTU is moved from a piece of Equipment to another. If you specify a Source Quantity which is greater than the actual Source MTU Quantity, the system will move the Source MTU entirely and the missing Quantity will be provided at the destination.\r\nIf the Destination Equipment has either a FIFO or MIXING Material Behavior (without any content yet in terms of MTU) the move operation results in changing the location of the MTU from one piece of Equipment to another.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the source quantity in accordance with the mixing action. The source MTU is deleted.\r\nA partial move is performed when a partial quantity of the MTU, is moved from one piece of Equipment to another. The Source MTU Quantity is updated by subtracting the partial Quantity, which must be less than the total Quantity of the Source MTU.\r\nIf the Destination Equipment, with either FIFO or MIXING Behavior (in this case without any content yet in terms of MTU) the move operation results in creating a new MTU inside the Destination location, with the same characteristicts as the Source MTU.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the quantity in accordance with the mixing action.","FullInfo":"This command registers the Movement which has involved the MTU specified as input of the command.\r\nA total move is performed when the entire quantity of the MTU is moved from a piece of Equipment to another. If you specify a Source Quantity which is greater than the actual Source MTU Quantity, the system will move the Source MTU entirely and the missing Quantity will be provided at the destination.\r\nIf the Destination Equipment has either a FIFO or MIXING Material Behavior (without any content yet in terms of MTU) the move operation results in changing the location of the MTU from one piece of Equipment to another.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the source quantity in accordance with the mixing action. The source MTU is deleted.\r\nA partial move is performed when a partial quantity of the MTU, is moved from one piece of Equipment to another. The Source MTU Quantity is updated by subtracting the partial Quantity, which must be less than the total Quantity of the Source MTU.\r\nIf the Destination Equipment, with either FIFO or MIXING Behavior (in this case without any content yet in terms of MTU) the move operation results in creating a new MTU inside the Destination location, with the same characteristicts as the Source MTU.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the quantity in accordance with the mixing action.","InfoMap":{"$id":"811","FullIdObj":{"$id":"812","$type":"IdentificableText","Name":"This command registers the Movement which has involved the MTU specified as input of the command.\r\nA total move is performed when the entire quantity of the MTU is moved from a piece of Equipment to another. If you specify a Source Quantity which is greater than the actual Source MTU Quantity, the system will move the Source MTU entirely and the missing Quantity will be provided at the destination.\r\nIf the Destination Equipment has either a FIFO or MIXING Material Behavior (without any content yet in terms of MTU) the move operation results in changing the location of the MTU from one piece of Equipment to another.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the source quantity in accordance with the mixing action. The source MTU is deleted.\r\nA partial move is performed when a partial quantity of the MTU, is moved from one piece of Equipment to another. The Source MTU Quantity is updated by subtracting the partial Quantity, which must be less than the total Quantity of the Source MTU.\r\nIf the Destination Equipment, with either FIFO or MIXING Behavior (in this case without any content yet in terms of MTU) the move operation results in creating a new MTU inside the Destination location, with the same characteristicts as the Source MTU.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the quantity in accordance with the mixing action.","FullInfo":"This command registers the Movement which has involved the MTU specified as input of the command.\r\nA total move is performed when the entire quantity of the MTU is moved from a piece of Equipment to another. If you specify a Source Quantity which is greater than the actual Source MTU Quantity, the system will move the Source MTU entirely and the missing Quantity will be provided at the destination.\r\nIf the Destination Equipment has either a FIFO or MIXING Material Behavior (without any content yet in terms of MTU) the move operation results in changing the location of the MTU from one piece of Equipment to another.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the source quantity in accordance with the mixing action. The source MTU is deleted.\r\nA partial move is performed when a partial quantity of the MTU, is moved from one piece of Equipment to another. The Source MTU Quantity is updated by subtracting the partial Quantity, which must be less than the total Quantity of the Source MTU.\r\nIf the Destination Equipment, with either FIFO or MIXING Behavior (in this case without any content yet in terms of MTU) the move operation results in creating a new MTU inside the Destination location, with the same characteristicts as the Source MTU.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the quantity in accordance with the mixing action.","TypeResolved":""}},"FullIdObj":{"$ref":"812"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"This command registers the Movement which has involved the MTU specified as input of the command.\r\nA total move is performed when the entire quantity of the MTU is moved from a piece of Equipment to another. If you specify a Source Quantity which is greater than the actual Source MTU Quantity, the system will move the Source MTU entirely and the missing Quantity will be provided at the destination.\r\nIf the Destination Equipment has either a FIFO or MIXING Material Behavior (without any content yet in terms of MTU) the move operation results in changing the location of the MTU from one piece of Equipment to another.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the source quantity in accordance with the mixing action. The source MTU is deleted.\r\nA partial move is performed when a partial quantity of the MTU, is moved from one piece of Equipment to another. The Source MTU Quantity is updated by subtracting the partial Quantity, which must be less than the total Quantity of the Source MTU.\r\nIf the Destination Equipment, with either FIFO or MIXING Behavior (in this case without any content yet in terms of MTU) the move operation results in creating a new MTU inside the Destination location, with the same characteristicts as the Source MTU.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the quantity in accordance with the mixing action.","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"This command registers the Movement which has involved the MTU specified as input of the command.\r\nA total move is performed when the entire quantity of the MTU is moved from a piece of Equipment to another. If you specify a Source Quantity which is greater than the actual Source MTU Quantity, the system will move the Source MTU entirely and the missing Quantity will be provided at the destination.\r\nIf the Destination Equipment has either a FIFO or MIXING Material Behavior (without any content yet in terms of MTU) the move operation results in changing the location of the MTU from one piece of Equipment to another.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the source quantity in accordance with the mixing action. The source MTU is deleted.\r\nA partial move is performed when a partial quantity of the MTU, is moved from one piece of Equipment to another. The Source MTU Quantity is updated by subtracting the partial Quantity, which must be less than the total Quantity of the Source MTU.\r\nIf the Destination Equipment, with either FIFO or MIXING Behavior (in this case without any content yet in terms of MTU) the move operation results in creating a new MTU inside the Destination location, with the same characteristicts as the Source MTU.\r\nIf the Destination Equipment has a MIXING Material Behavior and already contains an MTU, the quantity of the existing MTU is changed, adding the quantity in accordance with the mixing action."},"SystemAnnotations":[{"$id":"813","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"814","$type":"DslTerminalNode","Text":"@Guid(027337d1-9ddc-44c8-a064-95c2c429b801)","FullInfo":"@Guid(027337d1-9ddc-44c8-a064-95c2c429b801)","InfoMap":{"$id":"815","FullIdObj":{"$id":"816","$type":"IdentificableText","Name":"@Guid(027337d1-9ddc-44c8-a064-95c2c429b801)","FullInfo":"@Guid(027337d1-9ddc-44c8-a064-95c2c429b801)","TypeResolved":""}},"FullIdObj":{"$ref":"816"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"@Guid(027337d1-9ddc-44c8-a064-95c2c429b801)","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"@Guid(027337d1-9ddc-44c8-a064-95c2c429b801)"}],"TagAnnotations":[],"_text":"MoveMTU","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"MoveMTU"},{"$id":"817","$type":"DslCommandInputDeclarationTree","Children":[{"$id":"818","$type":"DslKeywordNode","Text":"WITH","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"WITH","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"WITH"},{"$id":"819","$type":"DslCommandPropertyCollectionT