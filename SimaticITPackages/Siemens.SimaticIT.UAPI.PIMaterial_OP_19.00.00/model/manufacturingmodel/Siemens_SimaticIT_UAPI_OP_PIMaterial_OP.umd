1","$type":"IdentificableTypeSystem","Name":"int","FullInfo":"Int32","TypeResolved":""}},"FullIdObj":{"$ref":"3141"},"Children":[],"Name":"SimpleSystemTypeNode","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"Line":707,"CharPositionInLine":16,"_text":"int","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"int"}],"Name":"CommandPropertyType","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"PropertyTree","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}]}],"Name":"Output declaration commands","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]}],"Name":"CommandDeclaration","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[]},{"$id":"3142","$type":"DslCommandDeclarationTree","HasInput":true,"Children":[{"$id":"3143","$type":"DslKeywordNode","Text":"COMMAND","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"COMMAND","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"COMMAND"},{"$id":"3144","$type":"DslTerminalNode","Text":"MoveMTUsToMTUAggregate","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.MoveMTUsToMTUAggregate","InfoMap":{"$id":"3145","FullIdObj":{"$id":"3146","$type":"IdentificableObject","Guid":"829a1f3c-72ca-4f9c-9a76-e2b4d3510c5f","Name":"MoveMTUsToMTUAggregate","FullInfo":"Siemens.SimaticIT.UAPI.OperationalData.PIMaterial_OP.OPModel.Commands.MoveMTUsToMTUAggregate","TypeResolved":"","_project":{"$ref":"12"},"_domain":{"$ref":"366"}}},"FullIdObj":{"$ref":"3146"},"Children":[],"Name":"CommandName","ScriptInfo":{"$ref":"363"},"Documentation":{"$id":"3147","$type":"DslTerminalNode","Text":"Moves one or more Material Tracking Units to a Material Tracking Unit Aggregate. \r\n \r\nThe Command executes the following steps: \r\n1. Retrieves the Material Tracking Units identified by their natural identifiers found in MaterialTrackingUnitNIds input parameter. \r\n2. Retrieves the MTU Aggregate by the given natural identifier MaterialTrackingUnitAggregateNId. \r\n3. Calls the MoveMaterialTrackingUnitToMaterialTrackingUnitAggregate Command for each MTU. \r\n4. Fires an MTUOperationCompleted Event after each MTU moved to the Material Tracking Aggregate. \r\n \r\nThe command checks: \r\n1. if the MTU Aggregate exists, if not it returns the error -12113. \r\n2. if each of the Material Tracking Units exists, if not it returns the error -12114. \r\n3. if each MTU moving is successful: if one fails, it returns error -12241. ","FullInfo":"Moves one or more Material Tracking Units to a Material Tracking Unit Aggregate. \r\n \r\nThe Command executes the following steps: \r\n1. Retrieves the Material Tracking Units identified by their natural identifiers found in MaterialTrackingUnitNIds input parameter. \r\n2. Retrieves the MTU Aggregate by the given natural identifier MaterialTrackingUnitAggregateNId. \r\n3. Calls the MoveMaterialTrackingUnitToMaterialTrackingUnitAggregate Command for each MTU. \r\n4. Fires an MTUOperationCompleted Event after each MTU moved to the Material Tracking Aggregate. \r\n \r\nThe command checks: \r\n1. if the MTU Aggregate exists, if not it returns the error -12113. \r\n2. if each of the Material Tracking Units exists, if not it returns the error -12114. \r\n3. if each MTU moving is successful: if one fails, it returns error -12241. ","InfoMap":{"$id":"3148","FullIdObj":{"$id":"3149","$type":"IdentificableText","Name":"Moves one or more Material Tracking Units to a Material Tracking Unit Aggregate. \r\n \r\nThe Command executes the following steps: \r\n1. Retrieves the Material Tracking Units identified by their natural identifiers found in MaterialTrackingUnitNIds input parameter. \r\n2. Retrieves the MTU Aggregate by the given natural identifier MaterialTrackingUnitAggregateNId. \r\n3. Calls the MoveMaterialTrackingUnitToMaterialTrackingUnitAggregate Command for each MTU. \r\n4. Fires an MTUOperationCompleted Event after each MTU moved to the Material Tracking Aggregate. \r\n \r\nThe command checks: \r\n1. if the MTU Aggregate exists, if not it returns the error -12113. \r\n2. if each of the Material Tracking Units exists, if not it returns the error -12114. \r\n3. if each MTU moving is successful: if one fails, it returns error -12241. ","FullInfo":"Moves one or more Material Tracking Units to a Material Tracking Unit Aggregate. \r\n \r\nThe Command executes the following steps: \r\n1. Retrieves the Material Tracking Units identified by their natural identifiers found in MaterialTrackingUnitNIds input parameter. \r\n2. Retrieves the MTU Aggregate by the given natural identifier MaterialTrackingUnitAggregateNId. \r\n3. Calls the MoveMaterialTrackingUnitToMaterialTrackingUnitAggregate Command for each MTU. \r\n4. Fires an MTUOperationCompleted Event after each MTU moved to the Material Tracking Aggregate. \r\n \r\nThe command checks: \r\n1. if the MTU Aggregate exists, if not it returns the error -12113. \r\n2. if each of the Material Tracking Units exists, if not it returns the error -12114. \r\n3. if each MTU moving is successful: if one fails, it returns error -12241. ","TypeResolved":""}},"FullIdObj":{"$ref":"3149"},"Children":[],"Name":"Documentation","SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Moves one or more Material Tracking Units to a Material Tracking Unit Aggregate. \r\n \r\nThe Command executes the following steps: \r\n1. Retrieves the Material Tracking Units identified by their natural identifiers found in MaterialTrackingUnitNIds input parameter. \r\n2. Retrieves the MTU Aggregate by the given natural identifier MaterialTrackingUnitAggregateNId. \r\n3. Calls the MoveMaterialTrackingUnitToMaterialTrackingUnitAggregate Command for each MTU. \r\n4. Fires an MTUOperationCompleted Event after each MTU moved to the Material Tracking Aggregate. \r\n \r\nThe command checks: \r\n1. if the MTU Aggregate exists, if not it returns the error -12113. \r\n2. if each of the Material Tracking Units exists, if not it returns the error -12114. \r\n3. if each MTU moving is successful: if one fails, it returns error -12241. ","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Moves one or more Material Tracking Units to a Material Tracking Unit Aggregate. \r\n \r\nThe Command executes the following steps: \r\n1. Retrieves the Material Tracking Units identified by their natural identifiers found in MaterialTrackingUnitNIds input parameter. \r\n2. Retrieves the MTU Aggregate by the given natural identifier MaterialTrackingUnitAggregateNId. \r\n3. Calls the MoveMaterialTrackingUnitToMaterialTrackingUnitAggregate Command for each MTU. \r\n4. Fires an MTUOperationCompleted Event after each MTU moved to the Material Tracking Aggregate. \r\n \r\nThe command checks: \r\n1. if the MTU Aggregate exists, if not it returns the error -12113. \r\n2. if each of the Material Tracking Units exists, if not it returns the error -12114. \r\n3. if each MTU moving is successful: if one fails, it returns error -12241. "},"SystemAnnotations":[{"$id":"3150","$type":"DslKeywordNode","Text":"Protected","Children":[],"Name":"Keyword","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnotations":[],"TagAnnotations":[],"_text":"Protected","Siemens.SimaticIT.DSL.Plugin.ILeafNode.Text":"Protected"}],"CustomAnnotations":[{"$id":"3151","$type":"DslTerminalNode","Text":"@Guid(829a1f3c-72ca-4f9c-9a76-e2b4d3510c5f)","FullInfo":"@Guid(829a1f3c-72ca-4f9c-9a76-e2b4d3510c5f)","InfoMap":{"$id":"3152","FullIdObj":{"$id":"3153","$type":"IdentificableText","Name":"@Guid(829a1f3c-72ca-4f9c-9a76-e2b4d3510c5f)","FullInfo":"@Guid(829a1f3c-72ca-4f9c-9a76-e2b4d3510c5f)","TypeResolved":""}},"FullIdObj":{"$ref":"3153"},"Children":[],"Name":"CustomAnnotation","ScriptInfo":{"$ref":"363"},"SystemAnnotations":[],"CustomAnnot